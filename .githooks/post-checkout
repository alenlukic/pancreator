#!/usr/bin/env bash
# Refresh the ignored .cursor projection when HEAD moves across a change to
# its sources. Cursor loads .cursor/rules at session start, so a stale
# projection hides every policy change from new agent sessions until someone
# runs `pan models --sync` by hand. Best effort: a git operation never fails here.
#
#   post-checkout <old-head> <new-head> <branch-flag>
#   post-merge delegates here with ORIG_HEAD and HEAD.

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
old="${1:-}"
new="${2:-HEAD}"

[ "${3:-1}" = 1 ] || exit 0
[ -d "$root/.cursor" ] || exit 0
[ -x "$root/bin/pan" ] || exit 0
[ -n "$old" ] && [ "$old" != "$new" ] || exit 0
case "$old" in *[!0]*) ;; *) exit 0 ;; esac

git -C "$root" diff --quiet "$old" "$new" -- \
  library/cursor \
  governance/policies \
  governance/registries/projection_manifest.json \
  config.json 2>/dev/null
[ "$?" = 1 ] || exit 0

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

echo "pancreator: Cursor projection sources changed; running pan models --sync" >&2
if ! (cd "$root" && ./bin/pan models --sync >/dev/null 2>&1); then
  echo "pancreator: pan models --sync failed; run ./bin/pan models --sync to refresh .cursor/" >&2
fi
exit 0

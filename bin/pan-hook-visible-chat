#!/usr/bin/env bash
# Cursor hook: hold agents to the COMMS-001 visible-chat rules.
# Usage: pan-hook-visible-chat <postToolUse | postToolUseFailure | stop>
#
# After a tool result it returns additional_context when the agent's latest
# tool-calling step had no chat text. On the first stop of a turn with no chat
# text it returns a followup_message. Always exits 0 with one JSON document.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HARNESS_ROOT="$(dirname "$SCRIPT_DIR")"
DIST="$HARNESS_ROOT/dist/src/visible-chat-hook.js"

# The agent index that maps a subagent to its transcript lives at the root
# bin/pan-hook-agent-index resolves; a linked worktree uses the main checkout.
resolve_root() {
  if [[ -n "${PANCREATOR_ROOT:-}" ]]; then
    printf '%s' "$PANCREATOR_ROOT"
    return
  fi
  local candidate common main
  candidate="$HARNESS_ROOT"
  if [[ -f "$candidate/.git" ]]; then
    common="$(git -C "$candidate" rev-parse --git-common-dir 2>/dev/null || true)"
    if [[ -n "$common" ]]; then
      [[ "$common" == /* ]] || common="$candidate/$common"
      main="$(dirname "$common")"
      if [[ -f "$main/bin/pan-run" && -f "$main/config.json" ]]; then
        printf '%s' "$main"
        return
      fi
    fi
  fi
  printf '%s' "$candidate"
}

PAYLOAD="$(cat 2>/dev/null || true)"

if [[ -f "$DIST" ]] && command -v node >/dev/null 2>&1 &&
  response="$(printf '%s' "$PAYLOAD" | PANCREATOR_ROOT="$(resolve_root)" node "$DIST" "${1:-}" 2>/dev/null)" &&
  [[ -n "$response" ]]; then
  printf '%s\n' "$response"
else
  printf '%s\n' '{}'
fi

exit 0

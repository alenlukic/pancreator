#!/usr/bin/env bash
# Thin shim: delegates to bin/pan-run.
#
# PAN_VERBOSE=1 streams output by exec-ing pan-run without --quiet.
# Otherwise exec-ing pan-run --quiet --label <basename of argv0>.
# Quiet mode keeps today's contract: nothing on success, and on failure the
# captured stdout then stderr, each truncated to its last 16 MiB with a notice.
# The log, heartbeat file, and exit record are written in every mode.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

is_verbose() {
  case "${PAN_VERBOSE:-}" in
    1 | true | yes | TRUE | YES) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ $# -eq 0 ]] || [[ "${1:-}" != '--' ]]; then
  printf 'Usage: bin/run-quiet -- <command> [args...]\n' >&2
  exit 1
fi

shift  # remove '--'
if [[ $# -eq 0 ]]; then
  printf 'Usage: bin/run-quiet -- <command> [args...]\n' >&2
  exit 1
fi

# Derive label from the first argument's basename
LABEL="${1##*/}"

if is_verbose; then
  exec "$SCRIPT_DIR/pan-run" --label "$LABEL" -- "$@"
else
  exec "$SCRIPT_DIR/pan-run" --quiet --label "$LABEL" -- "$@"
fi

#!/usr/bin/env bash
set -euo pipefail

MAX_CAPTURE_BYTES=$((16 * 1024 * 1024))

usage() {
  echo "Usage: bin/run-quiet -- <command> [args...]" >&2
}

is_verbose() {
  case "${PAN_VERBOSE:-}" in
    1 | true | yes | TRUE | YES) return 0 ;;
    *) return 1 ;;
  esac
}

# Progress ticks default to interactive terminals only, so captured or
# redirected output stays byte-identical to the quiet contract. A wrapper
# nested inside another quiet wrapper sees a captured stderr, so it takes the
# outer wrapper's decision instead: PAN_PROGRESS_FD names the sink the outer
# wrapper opened on the real terminal, and the inner wrapper ticks there.
progress_enabled() {
  if [[ -n "${PAN_PROGRESS_FD:-}" ]]; then
    return 0
  fi

  case "${PAN_PROGRESS:-}" in
    1 | true | yes | TRUE | YES) return 0 ;;
    0 | false | no | FALSE | NO) return 1 ;;
    *) [[ -t 2 ]] ;;
  esac
}

if [[ $# -eq 0 ]] || [[ "${1:-}" != '--' ]]; then
  usage
  exit 1
fi

shift
if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

command=("$@")

if is_verbose; then
  exec "${command[@]}"
fi

stdout_file="$(mktemp)"
stderr_file="$(mktemp)"
tick_marker="$(mktemp)"
rm -f "$tick_marker"
ticker_pid=''

# The cleanup MUST kill the ticker: an orphaned ticker keeps writing to the
# terminal from outside the foreground process group, where Ctrl-C cannot
# reach it. INT and TERM are trapped because bash skips EXIT traps on fatal
# signals it has not trapped.
cleanup() {
  if [[ -n "$ticker_pid" ]]; then
    stop_ticker
  fi
  rm -f "$stdout_file" "$stderr_file" "$tick_marker"
}

# The ticker's in-flight sleep is its child. Killing the subshell alone would
# orphan that sleep, so its children go first, then the subshell.
stop_ticker() {
  pkill -P "$ticker_pid" 2>/dev/null || true
  kill "$ticker_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if progress_enabled; then
  tick_interval="${PAN_PROGRESS_INTERVAL_SECONDS:-5}"
  script_pid=$$
  # The outermost ticking wrapper owns the sink: a private copy of its stderr
  # on fd 9, exported by number so every nested wrapper inherits it and ticks
  # to the terminal even though its own stderr is captured. A nested quiet
  # wrapper swallows its child's output on success, so without the shared
  # sink the outer wrapper would observe zero bytes and never tick.
  if [[ -z "${PAN_PROGRESS_FD:-}" ]]; then
    exec 9>&2
    export PAN_PROGRESS_FD=9
  fi
  # A dot marks an interval in which the command produced new output, so a
  # stopped dot stream shows the command has gone silent (a likely hang).
  # The ticker also exits on its own when the wrapper is no longer alive.
  # A sleep that inherited stderr would keep a captured stderr pipe open
  # after the subshell died, so a fast command cost whoever captured it one
  # full tick. The sleep therefore holds no inherited stdio, and stop_ticker
  # kills it before the subshell.
  (
    # Dots go to the shared sink. The subshell's own stderr goes to /dev/null
    # so bash's "Terminated" notice for the killed sleep never reaches the
    # wrapper's caller, and the sleep inherits neither.
    exec 2>/dev/null
    last_bytes=0
    while sleep "$tick_interval" >/dev/null 2>&1 </dev/null 9>&-; do
      kill -0 "$script_pid" 2>/dev/null || exit 0
      stdout_bytes="$(wc -c <"$stdout_file" 2>/dev/null || echo 0)"
      stderr_bytes="$(wc -c <"$stderr_file" 2>/dev/null || echo 0)"
      current_bytes=$((stdout_bytes + stderr_bytes))
      if [[ "$current_bytes" -gt "$last_bytes" ]]; then
        printf '.' >&9
        : >"$tick_marker"
        last_bytes="$current_bytes"
      fi
    done
  ) &
  ticker_pid=$!
fi

set +e
"${command[@]}" >"$stdout_file" 2>"$stderr_file"
status=$?
set -e

if [[ -n "$ticker_pid" ]]; then
  stop_ticker
  wait "$ticker_pid" 2>/dev/null || true
  ticker_pid=''
  if [[ -e "$tick_marker" ]]; then
    printf '\n' >&9
  fi
fi

if [[ "$status" -eq 0 ]]; then
  exit 0
fi

stdout_bytes="$(wc -c <"$stdout_file" | tr -d ' ')"
stderr_bytes="$(wc -c <"$stderr_file" | tr -d ' ')"
truncated=0

if [[ "$stdout_bytes" -gt "$MAX_CAPTURE_BYTES" ]]; then
  tail -c "$MAX_CAPTURE_BYTES" "$stdout_file" >"${stdout_file}.tail"
  mv "${stdout_file}.tail" "$stdout_file"
  truncated=1
fi

if [[ "$stderr_bytes" -gt "$MAX_CAPTURE_BYTES" ]]; then
  tail -c "$MAX_CAPTURE_BYTES" "$stderr_file" >"${stderr_file}.tail"
  mv "${stderr_file}.tail" "$stderr_file"
  truncated=1
fi

if [[ "$truncated" -eq 1 ]]; then
  echo "[quiet runner] output truncated to the last ${MAX_CAPTURE_BYTES} bytes" >&2
fi

cat "$stdout_file"
cat "$stderr_file" >&2
exit "$status"

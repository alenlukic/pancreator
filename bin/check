#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

QUIET="$ROOT/bin/run-quiet"

# Build runs before lint because bin/lint skips its own tsc --noEmit when the
# build stamp is fresh.
for script_name in build lint validate; do
  if "$QUIET" -- npm run "$script_name"; then
    continue
  fi

  exit 1
done

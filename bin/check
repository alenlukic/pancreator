#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

QUIET="$ROOT/bin/run-quiet"

# Test execution is owned by the fast/full profile commands (npm test,
# npm run test:coverage). Running the suite inside check made every full
# gate execute all tests twice and made check's duration depend on whether
# an earlier step failed fast.
#
# Build runs before lint: the emitting tsc type-checks the same program, and
# bin/lint skips its own tsc --noEmit when the build stamp is fresh.
for script_name in build lint validate; do
  if "$QUIET" -- npm run "$script_name"; then
    continue
  fi

  exit 1
done

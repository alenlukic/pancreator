#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WRAPPER_STARTED_MS="$(node -e 'process.stdout.write(String(Date.now()))')"
FAST_WALL_SERIES_ROOT="${PAN_FAST_WALL_SERIES_ROOT:-$ROOT}"
FAST_WALL_RUN_ID="${PAN_FAST_WALL_RUN_ID:-standalone}"
FAST_WALL_PHASE="${PAN_FAST_WALL_PHASE:-standalone}"
FAST_WALL_CALLER_CLASS="${PAN_FAST_WALL_CALLER_CLASS:-standalone}"
FAST_WALL_INVOKER="${npm_lifecycle_event:-manual}"

# The wrapper owns these values. Test children must not inherit them and append
# a nested fixture run to the outer repository's series.
unset PAN_FAST_WALL_SERIES_ROOT
unset PAN_FAST_WALL_RUN_ID
unset PAN_FAST_WALL_PHASE
unset PAN_FAST_WALL_CALLER_CLASS
unset npm_lifecycle_event

# bin/pan pins PANCREATOR_ROOT on the installation when PANCREATOR_EXEC_ROOT
# selects another checkout's build. A test that spawns dist/src/cli.js inside a
# fixture would then resolve the installation instead of the fixture and read
# the real worktree index, so the pin must not reach the suite.
unset PANCREATOR_ROOT

usage() {
  echo "Usage: bin/run-tests -- <command> [args...]" >&2
}

# Every suite run gets one scratch directory under this checkout's scratch
# root, and the run discards it when it ends. Fixtures never touch the shared
# OS temp directory: that directory is written by every program on the host,
# nothing bounds it, and once it accumulated 166,000 leaked fixtures every
# create and unlink in it stalled for seconds. The scratch root is per-root,
# so cohort worktrees never share one, and it cannot outlive the run that
# made it. config.json test_scratch.root moves it out of the checkout;
# dist/src/lib/test-scratch.js owns that resolution for this script and the
# test helpers alike.
#
# Discarding is a rename followed by a detached removal. Deleting the tree in
# the foreground charged the command 115 seconds of its 287-second wall time,
# after its last assertion had already passed. A rename inside one directory
# is a metadata operation, so the command now ends when its tests end.
#
# A run that dies by signal skips its own cleanup, and so can a detached
# removal. The next run sweeps any run directory whose owner is gone and any
# discarded tree whose remover is gone. A failed removal stays discarded for
# another retry and never decides the suite status. runtime/ is gitignored.
SCRATCH_HELPER="$ROOT/dist/src/lib/test-scratch.js"
TESTS_TMP_ROOT="$ROOT/runtime/tmp/tests.noindex"

if [[ -f "$SCRATCH_HELPER" ]]; then
  if ! TESTS_TMP_ROOT="$(node "$SCRATCH_HELPER" "$ROOT")"; then
    echo '[run-tests] cannot resolve the test scratch directory from config.json' >&2
    exit 1
  fi
fi

FILE_DURATION_RECORD="$TESTS_TMP_ROOT/file-durations.json"
FILE_ORDER_HELPER="$ROOT/dist/src/lib/test-file-order.js"
SPOTLIGHT_MARKER="$TESTS_TMP_ROOT/.metadata_never_index"

# A pid alone cannot identify a run: a directory orphaned by SIGKILL names a
# pid the kernel later reassigns. Pairing the pid with the process start time
# tells the original owner apart from a namesake, and ps reads start times
# across users, so it also distinguishes "no such process" from "not mine".
# This is the same identity bin/run-built uses for the build lock.
owner_token() {
  local started

  started="$(ps -o lstart= -p "$1" 2>/dev/null)" || return 1
  started="$(printf '%s' "$started" | tr -d ' ')"

  [[ -n "$started" ]] || return 1

  printf '%s' "$started"
}

# Trees renamed out of the way and still waiting for a remover to be started
# for them. Queueing lets one sweep pay one Node startup instead of one per
# directory, which is the only part of the handoff the wrapper waits on.
PENDING_REMOVAL_TARGETS=()
PENDING_REMOVAL_IDS=()

flush_pending_removals() {
  local remover rm_command id
  local -a targets=()
  local -a ids=()

  if [[ "${#PENDING_REMOVAL_TARGETS[@]}" -gt 0 ]]; then
    targets=("${PENDING_REMOVAL_TARGETS[@]}")
    ids=("${PENDING_REMOVAL_IDS[@]}")
  fi

  PENDING_REMOVAL_TARGETS=()
  PENDING_REMOVAL_IDS=()

  [[ "${#targets[@]}" -gt 0 ]] || return 0

  rm_command="$(command -v rm 2>/dev/null || true)"
  [[ -n "$rm_command" ]] || return 0

  # Node's detached option starts the remover in its own process group and
  # session on Unix. It therefore survives the shell session that launched
  # this runner. Starting or completing a removal can never decide test status.
  remover="$(
    node --input-type=module --eval '
      import { spawn } from "node:child_process"
      const [command, ...targets] = process.argv.slice(1)
      const child = spawn(command, ["-rf", ...targets], {
        detached: true,
        stdio: "ignore",
      })
      child.once("error", () => {
        process.exitCode = 1
      })
      child.once("spawn", () => {
        process.stdout.write(String(child.pid))
        child.unref()
      })
    ' "$rm_command" "${targets[@]}" 2>/dev/null
  )" || return 0

  [[ "$remover" =~ ^[0-9]+$ ]] || return 0

  # One remover owns every tree of this batch, so each tree's marker names it.
  for id in "${ids[@]}"; do
    printf '%s\n%s\n' \
      "$remover" \
      "$(owner_token "$remover" || printf 'unidentified-%s' "$remover")" \
      >"$TESTS_TMP_ROOT/.removing-$id" 2>/dev/null || true
  done
}

# The rename is the part that has to happen before the caller continues. The
# removal it queues is started once for the whole sweep.
discard_directory() {
  local source="$1"
  local id="$2"
  local discarded="$TESTS_TMP_ROOT/discarded-$id"

  [[ -d "$source" ]] || return 0
  [[ ! -e "$discarded" ]] || return 0

  if ! mv "$source" "$discarded" 2>/dev/null; then
    return 0
  fi

  PENDING_REMOVAL_TARGETS+=("$discarded")
  PENDING_REMOVAL_IDS+=("$id")
}

sweep_dead_runs() {
  local run owner token live

  for run in "$TESTS_TMP_ROOT"/run-*; do
    [[ -d "$run" ]] || continue

    owner=''
    token=''
    { IFS= read -r owner; IFS= read -r token; } <"$run/.owner" 2>/dev/null || true

    live=''

    if [[ "$owner" =~ ^[0-9]+$ ]]; then
      live="$(owner_token "$owner" || true)"
    fi

    if [[ -n "$live" && "$live" == "$token" ]]; then
      # A run that is still executing. Leave its fixtures alone.
      continue
    fi

    discard_directory "$run" "${run##*/run-}"
  done

  flush_pending_removals
}

# A discarded tree belongs to the detached removal that was started for it,
# named in a marker beside the tree. A removal still working is left alone, so
# two processes never delete one tree; a removal that died leaves its tree to
# this sweep, which retries the removal without waiting for it.
sweep_discarded_runs() {
  local discarded id marker owner token live

  for discarded in "$TESTS_TMP_ROOT"/discarded-*; do
    [[ -d "$discarded" ]] || continue

    id="${discarded##*/discarded-}"
    marker="$TESTS_TMP_ROOT/.removing-$id"
    owner=''
    token=''
    { IFS= read -r owner; IFS= read -r token; } <"$marker" 2>/dev/null || true

    live=''

    if [[ "$owner" =~ ^[0-9]+$ ]]; then
      live="$(owner_token "$owner" || true)"
    fi

    if [[ -n "$live" && "$live" == "$token" ]]; then
      continue
    fi

    rm -f "$marker" 2>/dev/null || true
    PENDING_REMOVAL_TARGETS+=("$discarded")
    PENDING_REMOVAL_IDS+=("$id")
  done

  flush_pending_removals

  # A removal that finished leaves its marker behind, because the tree it was
  # told to delete is the only thing it touches.
  for marker in "$TESTS_TMP_ROOT"/.removing-*; do
    [[ -f "$marker" ]] || continue

    id="${marker##*/.removing-}"

    [[ -d "$TESTS_TMP_ROOT/discarded-$id" ]] || rm -f "$marker"
  done
}

# A wrapper killed between writing the ordered list and removing it leaves
# the one file in this root that belongs to no run directory.
sweep_ordering_scratch() {
  local ordered

  for ordered in "$TESTS_TMP_ROOT"/.ordered-*; do
    [[ -f "$ordered" ]] || continue

    if ! owner_token "${ordered##*/.ordered-}" >/dev/null 2>&1; then
      rm -f "$ordered" 2>/dev/null || true
    fi
  done
}

# Ordering is a scheduling optimization, so it decides how the suite is
# dispatched and never whether it runs. dist/ and runtime/ have independent
# lifetimes: a checkout whose helper has been cleaned while a record remains
# would otherwise abort before a single test, which is the same rule the
# cleanup path already follows above.
order_test_file_arguments() {
  ORDERED_ARGUMENTS=("$@")

  [[ -s "$FILE_DURATION_RECORD" ]] || return 0

  local output="$TESTS_TMP_ROOT/.ordered-$$"
  local argument
  local -a parsed=()

  if ! node "$FILE_ORDER_HELPER" "$FILE_DURATION_RECORD" "$@" >"$output" 2>/dev/null; then
    rm -f "$output"
    echo "[run-tests] could not order test files from $FILE_DURATION_RECORD;" \
      'running them in the order received' >&2
    return 0
  fi

  while IFS= read -r -d '' argument; do
    parsed+=("$argument")
  done <"$output"

  rm -f "$output"

  if [[ "${#parsed[@]}" -ne "$#" ]]; then
    echo '[run-tests] ordered test-file arguments were incomplete;' \
      'running them in the order received' >&2
    return 0
  fi

  ORDERED_ARGUMENTS=("${parsed[@]}")
}

# The runner starts one process per test file, and each file can start git and
# CLI children of its own, so the worker count multiplies into far more
# processes than cores. At the Node default of one worker per core, a suite
# run saturated the host badly enough to stall the operator's editor. Half the
# logical cores keeps the suite near its best wall while leaving the other half
# to interactive work. PAN_TEST_WORKERS overrides the default for one run, and
# an explicit --test-concurrency argument always wins.
default_worker_count() {
  local requested="${PAN_TEST_WORKERS:-}"
  local cpus

  if [[ "$requested" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s' "$requested"
    return
  fi

  cpus="$(
    node -e 'process.stdout.write(String(require("node:os").availableParallelism()))'
  )"

  [[ "$cpus" =~ ^[1-9][0-9]*$ ]] || cpus=2

  printf '%s' $(((cpus + 1) / 2 > 2 ? (cpus + 1) / 2 : 2))
}

with_default_concurrency() {
  local argument
  local runs_node_test=0

  CONCURRENT_ARGUMENTS=("$@")

  [[ "${1##*/}" == 'node' ]] || return 0

  for argument in "$@"; do
    case "$argument" in
      --test)
        runs_node_test=1
        ;;
      --test-concurrency | --test-concurrency=*)
        return 0
        ;;
    esac
  done

  [[ "$runs_node_test" -eq 1 ]] || return 0

  CONCURRENT_ARGUMENTS=("$1" "--test-concurrency=$(default_worker_count)" "${@:2}")
}

# The suite is batch work that competes with the operator's editor, browser,
# and window server for the same cores, and most of its cost is kernel time
# spent creating processes and files. Clamping it to the utility QoS class
# lets interactive threads preempt it and throttles its I/O under contention,
# so a suite run slows down instead of the desktop. The nice increment does
# the same on every platform. Children inherit both.
# PAN_TEST_PRIORITY=normal runs at the caller's own priority.
low_priority_prefix() {
  LOW_PRIORITY_PREFIX=()

  [[ "${PAN_TEST_PRIORITY:-low}" == 'normal' ]] && return 0

  if [[ -x /usr/sbin/taskpolicy ]]; then
    LOW_PRIORITY_PREFIX=(/usr/sbin/taskpolicy -c utility)
  fi

  if command -v nice >/dev/null 2>&1; then
    LOW_PRIORITY_PREFIX+=(nice -n 10)
  fi
}

test_worker_count() {
  local argument next=0
  local configured=''

  for argument in "$@"; do
    if [[ "$next" -eq 1 ]]; then
      configured="$argument"
      next=0
      continue
    fi

    case "$argument" in
      --test-concurrency)
        next=1
        ;;
      --test-concurrency=*)
        configured="${argument#--test-concurrency=}"
        ;;
    esac
  done

  if [[ "$configured" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s' "$configured"
    return
  fi

  node -e \
    'const os=require("node:os");process.stdout.write(String(os.availableParallelism()))'
}

is_complete_fast_lane() {
  local argument candidate expected index index_actual actual_count=0 expected_count
  # Bash 3.2 treats an empty array as unset under `set -u`. Keep a sentinel so
  # a fixture with no compiled lane files remains a normal non-match.
  local -a actual=('')
  local -a expected_files=('')

  [[ "$FAST_WALL_INVOKER" == 'test' ]] || return 1

  # The fast lane is unit and regression. Integration runs before release, in
  # the full profile, so a run that carries any integration file is not the
  # governed lane.
  for argument in "$@"; do
    candidate="${argument#"$ROOT"/}"

    case "$candidate" in
      dist/tests/unit/*.test.js | \
        dist/tests/regression/*.test.js)
        actual+=("$candidate")
        actual_count=$((actual_count + 1))
        ;;
      dist/tests/integration/*.test.js)
        return 1
        ;;
    esac
  done

  shopt -s nullglob
  expected_files=(
    ''
    "$ROOT"/dist/tests/unit/*.test.js
    "$ROOT"/dist/tests/regression/*.test.js
  )
  shopt -u nullglob

  expected_count=$((${#expected_files[@]} - 1))
  # An empty compiled lane matches nothing: a tree with no lane files has no
  # complete lane to record.
  [[ "$expected_count" -gt 0 ]] || return 1
  [[ "$actual_count" -eq "$expected_count" ]] || return 1

  for ((index = 1; index < ${#expected_files[@]}; index++)); do
    expected="${expected_files[$index]}"
    candidate="${expected#"$ROOT"/}"
    local found=0

    for ((index_actual = 1; index_actual < ${#actual[@]}; index_actual++)); do
      argument="${actual[$index_actual]}"
      if [[ "$argument" == "$candidate" ]]; then
        found=1
        break
      fi
    done

    [[ "$found" -eq 1 ]] || return 1
  done

  return 0
}

if [[ "${1:-}" != '--' ]]; then
  usage
  exit 1
fi

shift

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

if ! mkdir -p "$TESTS_TMP_ROOT" 2>/dev/null; then
  echo "[run-tests] cannot create the test scratch directory $TESTS_TMP_ROOT" >&2
  exit 1
fi

# The suffix is the visible contract; the marker also covers hosts that keep
# stale metadata for a renamed or still-removing child.
if [[ ! -f "$SPOTLIGHT_MARKER" ]]; then
  : >"$SPOTLIGHT_MARKER"
fi

# Node resolves a .js file's module type from the nearest package.json above
# it. Without this file that would be this checkout's, whose "type": "module"
# would turn a fixture's CommonJS script into a syntax error. An empty
# package.json ends the walk here and, having no "type", leaves the default
# in force, which is what a fixture in the shared temp directory got.
if [[ ! -f "$TESTS_TMP_ROOT/package.json" ]]; then
  printf '{}\n' >"$TESTS_TMP_ROOT/package.json"
fi

sweep_dead_runs
sweep_discarded_runs
sweep_ordering_scratch

order_test_file_arguments "$@"

set -- "${ORDERED_ARGUMENTS[@]}"

with_default_concurrency "$@"

set -- "${CONCURRENT_ARGUMENTS[@]}"

low_priority_prefix

RUN_DIRECTORY="$(mktemp -d "$TESTS_TMP_ROOT/run-XXXXXXXX")"
SELF_TOKEN="$(owner_token "$$" || printf 'unidentified-%s' "$$")"

printf '%s\n%s\n' "$$" "$SELF_TOKEN" >"$RUN_DIRECTORY/.owner"

discard_run_directory() {
  discard_directory "$RUN_DIRECTORY" "${RUN_DIRECTORY##*/run-}"
  flush_pending_removals
}

trap discard_run_directory EXIT HUP INT TERM

export PANCREATOR_TEST_TMP="$RUN_DIRECTORY"
export PAN_TEST_FILE_DURATIONS="$FILE_DURATION_RECORD"

# Several suites assert exactly how many times a verification profile
# executed. The release-profile prefetch deliberately runs one of them in a
# detached child, which would make those counts depend on process scheduling.
# It is therefore off by default for the suite; the tests that cover the
# prefetch turn it on for their own fixture, and an operator can too.
export PAN_PREFETCH_FULL="${PAN_PREFETCH_FULL:-0}"

# The run directory can sit inside this checkout, which is itself a Git
# repository. Without a ceiling, git discovery from a fixture that has no
# .git of its own would walk up and find this checkout, and a test that
# expects "not a repository" would instead read this checkout's dirty files.
# The shared temp directory had no repository above it; the ceiling restores
# that property. Fixtures that init their own repository are unaffected, since
# discovery finds their .git before reaching the ceiling.
export GIT_CEILING_DIRECTORIES="$RUN_DIRECTORY${GIT_CEILING_DIRECTORIES:+:$GIT_CEILING_DIRECTORIES}"

# Run the suite as a foreground child rather than exec it, so the trap above
# fires when it ends and the exit status passes through unchanged. A terminal
# interrupt reaches the suite directly, since it shares this process group.
# A signal sent to this wrapper alone is acted on once the suite exits, so
# the discard happens then rather than being skipped. A wrapper killed
# outright leaves one directory, which the next run's sweep removes.
status=0
FAST_WALL_LOAD_AVERAGE="$(
  node -e 'process.stdout.write(String(require("node:os").loadavg()[0]))'
)"
FAST_WALL_CPU_COUNT="$(
  node -e 'process.stdout.write(String(require("node:os").availableParallelism()))'
)"
FAST_WALL_WORKER_COUNT="$(test_worker_count "$@")"
FAST_WALL_QUALIFIES=0

if is_complete_fast_lane "$@"; then
  FAST_WALL_QUALIFIES=1
fi

${LOW_PRIORITY_PREFIX[@]+"${LOW_PRIORITY_PREFIX[@]}"} "$@" || status=$?

WRAPPER_FINISHED_MS="$(node -e 'process.stdout.write(String(Date.now()))')"
WRAPPER_WALL_MS=$((WRAPPER_FINISHED_MS - WRAPPER_STARTED_MS))

if [[ "$FAST_WALL_QUALIFIES" -eq 1 ]] && ! node "$ROOT/dist/src/cli.js" tests record-fast-wall \
  --series-root "$FAST_WALL_SERIES_ROOT" \
  --workspace-root "$ROOT" \
  --duration-record "$FILE_DURATION_RECORD" \
  --worker-count "$FAST_WALL_WORKER_COUNT" \
  --load-average "$FAST_WALL_LOAD_AVERAGE" \
  --cpu-count "$FAST_WALL_CPU_COUNT" \
  --caller-class "$FAST_WALL_CALLER_CLASS" \
  --wrapper-wall-ms "$WRAPPER_WALL_MS" \
  --invoker "$FAST_WALL_INVOKER" \
  --run-id "$FAST_WALL_RUN_ID" \
  --phase "$FAST_WALL_PHASE" \
  --exit-code "$status"; then
  echo '[run-tests] could not record the fast-lane wall measurement' >&2
  [[ "$status" -ne 0 ]] || status=1
fi

exit "$status"

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Preserve the caller's working directory. The validator resolves its default
# repository root and a relative input path from it.
exec "$ROOT/bin/run-built" -- node "$ROOT/dist/src/lib/validators/markdown-validator.js" "$@"

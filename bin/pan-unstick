#!/usr/bin/env bash
# Release a stalled Cursor shell launcher by terminating its blocking cat child.
set -euo pipefail

usage() {
  echo "Usage: bin/pan-unstick [--min-age-seconds <n>] [--launcher-pid <pid>] [--dry-run]" >&2
}

MIN_AGE=5
LAUNCHER_PID=""
DRY_RUN=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --min-age-seconds)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      MIN_AGE="$2"
      shift 2
      ;;
    --launcher-pid)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      LAUNCHER_PID="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

if ! [[ "$MIN_AGE" =~ ^[0-9]+$ ]]; then
  echo "[pan-unstick] --min-age-seconds must be a non-negative integer" >&2
  exit 2
fi
MIN_AGE=$((10#$MIN_AGE))
if [[ -n "$LAUNCHER_PID" ]] && ! [[ "$LAUNCHER_PID" =~ ^[0-9]+$ ]]; then
  echo "[pan-unstick] --launcher-pid must be a process id" >&2
  exit 2
fi

SIGNATURE='snap=$(command cat <&3)'

# One awk pass over one snapshot pairs each launcher with its cat children and
# prints "<launcher pid> <cat pid> <launcher age> <cat age>". A byte locale and
# a literal index() keep the scan linear on long multibyte command lines, and
# --launcher-pid drops every unrelated line before any command text is read.
PAIRS="$(
  ps -U "$(id -u)" -ww -o pid= -o ppid= -o etime= -o command= 2>/dev/null |
    LC_ALL=C awk -v signature="$SIGNATURE" -v want="$LAUNCHER_PID" '
      function seconds(etime,   days, parts, count) {
        days = 0
        if (index(etime, "-") > 0) {
          split(etime, parts, "-")
          days = parts[1]
          etime = parts[2]
        }
        count = split(etime, parts, ":")
        if (count == 3) return days * 86400 + parts[1] * 3600 + parts[2] * 60 + parts[3]
        if (count == 2) return days * 86400 + parts[1] * 60 + parts[2]
        return days * 86400 + parts[1]
      }
      $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {
        if (want != "" && $1 != want && $2 != want) next
        if ((want == "" || $1 == want) && index($0, signature) > 0) {
          launcher_age[$1] = seconds($3)
          next
        }
        count = split($4, words, "/")
        if (words[count] == "cat") {
          cats[++cat_count] = $1 " " $2 " " seconds($3)
        }
      }
      END {
        for (i = 1; i <= cat_count; i++) {
          split(cats[i], cat, " ")
          if (cat[2] in launcher_age) print cat[2], cat[1], launcher_age[cat[2]], cat[3]
        }
      }
    '
)" || true

RELEASED=0

while read -r pid cpid launcher_age cage; do
  [[ -n "$pid" ]] || continue
  (( launcher_age >= MIN_AGE && cage >= MIN_AGE )) || continue
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '[pan-unstick] would release launcher pid=%s cat pid=%s age=%ss\n' \
      "$pid" "$cpid" "$cage"
  else
    kill -TERM "$cpid" 2>/dev/null || true
    printf '[pan-unstick] released launcher pid=%s cat pid=%s age=%ss\n' \
      "$pid" "$cpid" "$cage"
  fi
  RELEASED=1
done <<<"$PAIRS"

if [[ "$RELEASED" -eq 0 ]]; then
  printf '[pan-unstick] no stalled launcher found\n' >&2
  exit 3
fi

exit 0

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PATH="$ROOT/node_modules/.bin:$PATH"

# Skip the rebuild when no TypeScript input changed. The stamp hashes path,
# mtime, and size, so any edit, addition, deletion, or rename invalidates it.
STAMP="dist/.build-stamp"

stat_line() {
  stat -f '%N %m %z' "$@" 2>/dev/null || stat -c '%n %Y %s' "$@" 2>/dev/null || true
}

fingerprint() {
  local dirs=()

  [[ -d src ]] && dirs+=(src)
  [[ -d tests ]] && dirs+=(tests)

  {
    stat_line tsconfig.json package.json package-lock.json
    if [[ ${#dirs[@]} -gt 0 ]]; then
      { find "${dirs[@]}" -name '*.ts' -type f -print0 2>/dev/null || true; } \
        | { xargs -0 bash -c 'stat -f "%N %m %z" "$@" 2>/dev/null || stat -c "%n %Y %s" "$@" 2>/dev/null || true' _ 2>/dev/null || true; } \
        | sort
    fi
  } | cksum
}

current="$(fingerprint)"

stamp_fresh() {
  [[ -f "$STAMP" && -d dist && "$(cat "$STAMP")" == "$current" ]]
}

# `bin/build --stamp-fresh` reports whether dist already matches the inputs.
if [[ "${1:-}" == '--stamp-fresh' ]]; then
  stamp_fresh
  exit $?
fi

if stamp_fresh; then
  exit 0
fi

# Compile into a private staging directory and swap it into place with two
# renames. `dist/` is therefore never absent or half-written: a process that
# already loaded the previous build keeps running from memory, a process that
# starts during the compile still finds the previous complete build, and a
# process that starts after the swap finds the new one. No live-reader
# bookkeeping is needed, so a long-lived `pan watch` cannot delay a build.
staging="dist.build-$$"
retired="dist.retired-$$"

cleanup_staging() {
  rm -rf "$staging" "$retired"
}

trap cleanup_staging EXIT HUP INT TERM

rm -rf "$staging"
tsc --outDir "$staging"

# Retired staging directories from a build that died mid-swap are harmless
# but untidy; remove any that no live process owns.
for stale in dist.build-* dist.retired-*; do
  [[ -e "$stale" ]] || continue
  pid="${stale##*-}"
  if [[ "$pid" =~ ^[0-9]+$ && "$pid" -ne $$ ]] && ! kill -0 "$pid" 2>/dev/null; then
    rm -rf "$stale"
  fi
done

if [[ -d dist ]]; then
  mv dist "$retired"
fi
mv "$staging" dist

printf '%s\n' "$current" >"$STAMP"

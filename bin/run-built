#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  echo "Usage: bin/run-built --build-only | -- <command> [args...]" >&2
}

# run-quiet captures stderr, so send a wait notice straight to the terminal.
notify() {
  if ! { echo "$1" >/dev/tty; } 2>/dev/null; then
    echo "$1" >&2
  fi
}

release_lock() {
  local owner

  if ! IFS= read -r owner 2>/dev/null <"$BUILD_LOCK"; then
    return
  fi

  if [[ "$owner" == "$$" ]]; then
    rm -f "$BUILD_LOCK"
  fi
}

# The lock serializes compiles of one root. It is held only while bin/build
# runs, and bin/build never waits on another process, so the longest a caller
# can wait here is one compile. A wait past the notice threshold names the
# holder so a stalled caller is diagnosable rather than silent.
LOCK_NOTICE_SECONDS="${PANCREATOR_BUILD_LOCK_NOTICE_SECONDS:-5}"

acquire_lock() {
  local owner waited=0 announced=0

  while ! (set -o noclobber; printf '%s\n' "$$" >"$BUILD_LOCK") 2>/dev/null; do
    if ! IFS= read -r owner 2>/dev/null <"$BUILD_LOCK"; then
      sleep 0.1
      continue
    fi

    if [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
      if [[ "$announced" -eq 0 && "$waited" -ge $((LOCK_NOTICE_SECONDS * 10)) ]]; then
        notify "[run-built] waiting for the build lock held by pid $owner ($BUILD_LOCK); it is released when that build finishes"
        announced=1
      fi

      sleep 0.1
      waited=$((waited + 1))
      continue
    fi

    rm -f "$BUILD_LOCK"
  done

  trap release_lock EXIT HUP INT TERM
}

run_build() {
  # The common path is already fresh. Check it directly so every pan command
  # does not allocate run-quiet capture files before dispatch.
  if PATH="$ROOT/node_modules/.bin:$PATH" \
    "$ROOT/bin/build" --stamp-fresh; then
    return
  fi

  PATH="$ROOT/node_modules/.bin:$PATH" \
    "$ROOT/bin/run-quiet" -- "$ROOT/bin/build"
}

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

if [[ "${1:-}" == '--build-only' ]]; then
  if [[ $# -ne 1 ]]; then
    usage
    exit 1
  fi

  mode='build'
elif [[ "${1:-}" == '--' ]]; then
  shift

  if [[ $# -eq 0 ]]; then
    usage
    exit 1
  fi

  mode='run'
else
  usage
  exit 1
fi

# An ancestor run-built already built this root and holds its lock for this
# process tree, so re-acquiring the same lock would wait on that live ancestor
# forever. A ready value matching this root reuses the prepared build instead.
# The legacy value '1' stays a run-mode escape hatch for operator use; it never
# skips an explicit build because other roots may still need their own build.
ready="${PANCREATOR_BUILD_READY:-}"

if [[ "$mode" == 'run' && ("$ready" == "$ROOT" || "$ready" == '1') ]]; then
  exec "$@"
fi

if [[ "$mode" == 'build' && "$ready" == "$ROOT" ]]; then
  exit 0
fi

read -r root_key _ <<<"$(printf '%s' "$ROOT" | cksum)"
BUILD_LOCK="${TMPDIR:-/tmp}/pancreator-build-${root_key}.lock"

# The lock serializes builds only. Release it before the wrapped command runs.
# A stale reader directory from an older wrapper is removed so it cannot be
# mistaken for live state; this wrapper registers no readers.
rm -rf "${TMPDIR:-/tmp}/pancreator-build-${root_key}.readers" 2>/dev/null || true
acquire_lock
run_build
release_lock
trap - EXIT HUP INT TERM

if [[ "$mode" == 'run' ]]; then
  # bin/build swaps a complete new dist into place rather than deleting the
  # old one, so the wrapped command needs no reader registration to survive a
  # concurrent rebuild.
  export PANCREATOR_BUILD_READY="$ROOT"
  exec "$@"
fi

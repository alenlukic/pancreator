#!/usr/bin/env bash
# Refuse a landing on pan-dev or main that carries no release.
#
# Nothing lands on the integration branch without a proper version: every
# change to an installable harness input reaches pan-dev inside a release,
# which means the branch being merged already carries the release commit and
# the release/index.json commit for a VERSION above the one pan-dev holds. A
# direct commit on pan-dev that touches an installable input is the same
# defect from the other side, and it is refused too.
#
# Exception: daily quality commits carrying the Pancreator-Daily-Quality:
# trailer and touching only surface paths are exempt. `daily-range` checks
# this property; `branch` accepts a source whose installable changes since the
# merge base all pass `daily-range`.
#
# The installer enforces the same invariant at install time: a clean checkout
# installs only when its installable inputs match the indexed release, or its
# only drift is marked daily quality commits. This guard moves that refusal to
# the moment the landing is attempted, where the fix is still cheap.
#
# Modes:
#   check-landing pre-commit        refuse a direct commit on a protected branch
#   check-landing pre-merge-commit  refuse a merge whose source has no release
#   check-landing branch <ref> [<base-ref>]
#                                   report whether <ref> is landable onto <base-ref>
#                                   (defaults to HEAD when <base-ref> is omitted)
#   check-landing daily-range <base> <head>
#                                   exit 0 only when every commit in base..head
#                                   that touches installable inputs is a non-merge
#                                   commit carrying Pancreator-Daily-Quality: and
#                                   changing only surface paths, and the range holds
#                                   at least one such commit
#
# Exit 0 permits, exit 1 refuses with the reason on stderr.
set -euo pipefail

mode="${1:-}"
protected_re='^(pan-dev|main)$'
DAILY_QUALITY_TRAILER='Pancreator-Daily-Quality:'

# Installable inputs mirror SOURCE_PAYLOAD_ENTRIES in bin/install plus the two
# files the installer also compares. release/index.json is the one file the
# release flow itself changes after the release commit, so it is excluded.
installable=(
  .gitignore config.json .npmrc .prettierignore README.md CHANGELOG.md VERSION
  bin docs governance library package-lock.json package.json prettier.config.js
  release src target-extensions tsconfig.json
)

current_branch() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null || echo ""
}

touches_installable() {
  # Arguments form a `git diff ...` invocation; the pathspec is appended.
  local changed
  changed="$(git "$@" -- "${installable[@]}" ':(exclude)release/index.json')"
  [[ -n "$changed" ]]
}

version_at() {
  git show "$1:VERSION" 2>/dev/null | tr -d '[:space:]' || true
}

indexed_commit_for() {
  # $1 = ref, $2 = version; prints the indexed commit or nothing.
  git show "$1:release/index.json" 2>/dev/null | node -e '
    const fs = require("node:fs")
    const version = process.argv[1]
    const value = JSON.parse(fs.readFileSync(0, "utf8"))
    const entry = (value.releases ?? []).find((item) => item.version === version)
    process.stdout.write(typeof entry?.commit === "string" ? entry.commit : "")
  ' "$2"
}

refuse() {
  echo "check-landing: $1" >&2
  echo "check-landing: nothing lands on pan-dev without a proper version. Use 'pan release land --worktree <name>', which integrates, versions, verifies, and fast-forwards pan-dev. VERSION-001 and ACTION-001 state the rule." >&2
  exit 1
}

refuse_range() {
  echo "check-landing: daily-range: $1" >&2
  exit 1
}

# Check whether a path matches the daily quality surfaces.
# Reads governance/registries/daily_quality_surfaces.json and returns 0 when
# the path matches a conform_paths glob or has a style_extensions extension.
path_is_surface() {
  local file_path="$1"
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
  local surfaces_file="$repo_root/governance/registries/daily_quality_surfaces.json"

  if [[ ! -f "$surfaces_file" ]]; then
    return 1
  fi

  node -e "
const fs = require('node:fs')
const surfaces = JSON.parse(fs.readFileSync('${surfaces_file}', 'utf8'))
const filePath = process.argv[1]

const conformPaths = surfaces.conform_paths ?? []
const styleExtensions = surfaces.style_extensions ?? []

const lastDot = filePath.lastIndexOf('.')
const ext = lastDot >= 0 ? filePath.slice(lastDot) : ''
const matchesStyle = styleExtensions.includes(ext)

function globToRegex(pattern) {
  let re = ''
  let i = 0
  while (i < pattern.length) {
    if (pattern[i] === '*' && pattern[i + 1] === '*') {
      re += '.*'
      i += 2
      if (pattern[i] === '/') i++
    } else if (pattern[i] === '*') {
      re += '[^/]*'
      i++
    } else {
      re += pattern[i].replace(/[.+^${}()|[\]\\\\]/g, '\\\\$&')
      i++
    }
  }
  return new RegExp('^' + re + '$')
}

const matchesConform = conformPaths.some((pattern) => globToRegex(pattern).test(filePath))
process.exit(matchesConform || matchesStyle ? 0 : 1)
" "$file_path"
}

# Check whether a commit hash is a marked daily quality commit and touches only surfaces.
# Returns 0 for a valid daily commit, 1 for a refusal (sets DAILY_REFUSE_REASON).
DAILY_REFUSE_REASON=''

is_valid_daily_commit() {
  local commit="$1"

  # Reject merge commits.
  local parent_count
  parent_count="$(git cat-file -p "$commit" | grep -c '^parent ' || true)"
  if [[ "$parent_count" -gt 1 ]]; then
    DAILY_REFUSE_REASON="commit $commit is a merge commit"
    return 1
  fi

  # Require the daily quality trailer.
  local trailer
  trailer="$(git log -1 --format='%(trailers:key=Pancreator-Daily-Quality,valueonly)' "$commit" 2>/dev/null | tr -d '[:space:]')"
  if [[ -z "$trailer" ]]; then
    DAILY_REFUSE_REASON="commit $commit is missing the Pancreator-Daily-Quality: trailer"
    return 1
  fi

  # Every changed installable path must be a surface path.
  local changed_installable
  changed_installable="$(git diff-tree --no-commit-id -r --name-only "$commit" -- "${installable[@]}" ':(exclude)release/index.json' 2>/dev/null)"
  if [[ -z "$changed_installable" ]]; then
    # No installable inputs changed; not a relevant commit.
    DAILY_REFUSE_REASON="commit $commit carries the trailer but changes no installable inputs"
    return 1
  fi

  while IFS= read -r changed_path; do
    if ! path_is_surface "$changed_path"; then
      DAILY_REFUSE_REASON="commit $commit changes path '$changed_path' which is not in the daily quality surfaces"
      return 1
    fi
  done <<< "$changed_installable"

  return 0
}

case "$mode" in
  pre-commit)
    branch="$(current_branch)"
    [[ "$branch" =~ $protected_re ]] || exit 0

    # A merge that needed conflict resolution commits through `git commit`.
    # When MERGE_HEAD is present on a protected branch:
    #   1. Validate that MERGE_HEAD carries a new indexed release.
    #   2. Refuse when the staged installable inputs differ from MERGE_HEAD.
    if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
      merge_source="$(git rev-parse MERGE_HEAD)"

      # Run the branch check for MERGE_HEAD against the pre-merge HEAD.
      # Execute in a subshell so this script can continue after a clean pass.
      ("$0" branch "$merge_source" HEAD) || exit 1

      # Refuse if the staged resolution differs from MERGE_HEAD's installables.
      if touches_installable diff --cached --name-only MERGE_HEAD; then
        refuse "the staged resolution of installable inputs differs from MERGE_HEAD ($merge_source); the resolved tree must equal the released source's installable inputs."
      fi

      exit 0
    fi

    if touches_installable diff --cached --name-only; then
      refuse "a direct commit on '$branch' changes installable harness inputs."
    fi
    exit 0
    ;;

  pre-merge-commit)
    branch="$(current_branch)"
    [[ "$branch" =~ $protected_re ]] || exit 0

    source_ref="$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null || true)"
    [[ -n "$source_ref" ]] || exit 0
    exec "$0" branch "$source_ref"
    ;;

  daily-range)
    daily_base="${2:-}"
    daily_head="${3:-}"
    [[ -n "$daily_base" && -n "$daily_head" ]] || {
      echo "usage: check-landing daily-range <base> <head>" >&2
      exit 2
    }

    # Collect commits in range that touch installable inputs.
    daily_commits=()
    while IFS= read -r commit; do
      if touches_installable diff-tree --no-commit-id -r --name-only "$commit"; then
        daily_commits+=("$commit")
      fi
    done < <(git log --format='%H' "${daily_base}..${daily_head}" 2>/dev/null)

    if [[ "${#daily_commits[@]}" -eq 0 ]]; then
      refuse_range "the range ${daily_base}..${daily_head} holds no commit that touches installable inputs; at least one marked daily quality commit is required"
    fi

    for commit in "${daily_commits[@]}"; do
      if ! is_valid_daily_commit "$commit"; then
        refuse_range "$DAILY_REFUSE_REASON"
      fi
    done

    exit 0
    ;;

  branch)
    source_ref="${2:-}"
    [[ -n "$source_ref" ]] || {
      echo "usage: check-landing branch <ref> [<base-ref>]" >&2
      exit 2
    }

    base_ref="${3:-HEAD}"

    base="$(git merge-base "$base_ref" "$source_ref" 2>/dev/null)" || {
      echo "check-landing: cannot compute merge-base for '$base_ref' and '$source_ref'" >&2
      exit 2
    }

    if ! touches_installable diff --name-only "$base" "$source_ref"; then
      # Only runtime records or tests changed: no release is owed.
      exit 0
    fi

    head_version="$(version_at "$base_ref")"
    source_version="$(version_at "$source_ref")"

    if [[ -z "$source_version" ]]; then
      refuse "'$source_ref' has no VERSION file."
    fi

    if [[ "$source_version" == "$head_version" ]]; then
      # The versions match; check whether this is an all-daily-commits range.
      if ("$0" daily-range "$base" "$source_ref") 2>/dev/null; then
        exit 0
      fi
      refuse "'$source_ref' changes installable inputs but still carries VERSION $source_version, which '$base_ref' already holds."
    fi

    indexed_commit="$(indexed_commit_for "$source_ref" "$source_version")"

    if [[ -z "$indexed_commit" ]]; then
      refuse "'$source_ref' carries VERSION $source_version but its release/index.json does not index it; run 'pan release land --worktree <name>' to finalize and land."
    fi

    if ! git merge-base --is-ancestor "$indexed_commit" "$source_ref" 2>/dev/null; then
      refuse "the release commit indexed for $source_version ($indexed_commit) is not on '$source_ref'."
    fi

    if touches_installable diff --name-only "$indexed_commit" "$source_ref"; then
      # Check whether the post-release changes are all daily quality commits.
      if ("$0" daily-range "$indexed_commit" "$source_ref") 2>/dev/null; then
        exit 0
      fi
      refuse "'$source_ref' changes installable inputs after its indexed release commit for $source_version; run 'pan release land --worktree <name>' again."
    fi

    exit 0
    ;;

  *)
    echo "usage: check-landing pre-commit | pre-merge-commit | branch <ref> [<base-ref>] | daily-range <base> <head>" >&2
    exit 2
    ;;
esac

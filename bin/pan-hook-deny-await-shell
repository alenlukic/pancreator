#!/usr/bin/env bash
# Deny the AwaitShell (and Await) tool for every Pancreator agent.
# Also deny a Task call unless run_in_background is true.
# Reads a Cursor preToolUse JSON payload from stdin and prints a preToolUse
# permission response to stdout. Exits 0 always; Cursor blocks the action on
# invalid output from a permission hook.
set -u

input="$(cat 2>/dev/null || true)"

printf '%s' "$input" | python3 - 2>/dev/null <<'PYTHON_EOF' ||
import sys, json

try:
    d = json.loads(sys.stdin.read())
    if not isinstance(d, dict):
        raise ValueError('not a dict')
except Exception:
    # Internal fault: allow everything (C-013).
    print('{"permission":"allow"}')
    sys.exit(0)

tool_name = d.get('tool_name', '')
if not isinstance(tool_name, str):
    tool_name = ''

if tool_name in ('AwaitShell', 'Await'):
    msg = (
        'AwaitShell is banned for Pancreator agents. '
        'Block on `pan watch` as a foreground shell call instead: '
        'it checks on a 60-second cadence and returns at a terminal state '
        'or its one-hour default bound. After a platform detach, run '
        '`pan watch --attach <ledger>`.'
    )
    print(json.dumps({'permission': 'deny', 'user_message': msg, 'agent_message': msg}))
    sys.exit(0)

if tool_name == 'Task':
    try:
        raw_input = d.get('tool_input', {})
        if isinstance(raw_input, str):
            tool_input = json.loads(raw_input)
        else:
            tool_input = raw_input
        if not isinstance(tool_input, dict):
            raise ValueError('tool_input not a dict')
        run_in_background = bool(tool_input.get('run_in_background', False))
    except Exception:
        # C-013: internal fault allows Task.
        print('{"permission":"allow"}')
        sys.exit(0)

    if not run_in_background:
        msg = (
            'Task must be launched with run_in_background: true. '
            'Relaunch with run_in_background: true, then observe the subagent: '
            'for a run worker use `pan watch <run-id> --mark-background --handle <agent-id>`; '
            'for a standalone subagent use `pan watch --agent <agent-id>`.'
        )
        print(json.dumps({'permission': 'deny', 'user_message': msg, 'agent_message': msg}))
        sys.exit(0)

print('{"permission":"allow"}')
PYTHON_EOF
  printf '%s\n' '{"permission":"allow"}'

exit 0

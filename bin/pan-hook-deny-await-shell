#!/usr/bin/env bash
# Deny the AwaitShell (and Await) tool for every Pancreator agent.
# Reads a Cursor preToolUse JSON payload from stdin, prints a Cursor hook
# response to stdout, and exits 0 in every case.
set -u

DENY_MESSAGE='AwaitShell is banned for Pancreator agents. Use `pan watch` instead to monitor shell commands and subagents on a 60-second cadence.'

input="$(cat 2>/dev/null || true)"

# If input is not parsable or tool_name is absent, allow.
if ! tool_name="$(printf '%s' "$input" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('tool_name', ''))
except Exception:
    pass
" 2>/dev/null)"; then
  printf '{"continue":true}\n'
  exit 0
fi

case "$tool_name" in
  AwaitShell|Await)
    printf '{"continue":false,"agentMessage":"%s"}\n' "$DENY_MESSAGE"
    ;;
  *)
    printf '{"continue":true}\n'
    ;;
esac

exit 0

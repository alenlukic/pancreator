#!/usr/bin/env bash
# Deny the AwaitShell (and Await) tool for every Pancreator agent.
# Reads a Cursor preToolUse JSON payload from stdin and prints a preToolUse
# permission response to stdout: {"permission":"deny","agent_message":...}
# for AwaitShell or Await, {"permission":"allow"} otherwise. Exits 0 always,
# because Cursor blocks the action on invalid output from a permission hook.
set -u

input="$(cat 2>/dev/null || true)"

tool_name="$(printf '%s' "$input" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    name = d.get('tool_name', '') if isinstance(d, dict) else ''
    print(name if isinstance(name, str) else '')
except Exception:
    pass
" 2>/dev/null || true)"

case "$tool_name" in
  AwaitShell | Await)
    printf '%s\n' '{"permission":"deny","user_message":"AwaitShell is banned for Pancreator agents.","agent_message":"AwaitShell is banned for Pancreator agents. Block on `pan watch` as a foreground shell call instead: it checks on a 60-second cadence and returns at a terminal state or its one-hour default bound. After a platform detach, run `pan watch --attach <ledger>`."}'
    ;;
  *)
    printf '%s\n' '{"permission":"allow"}'
    ;;
esac

exit 0

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

npm run format:check

# The emitting build type-checks the same program, so a fresh build stamp
# replaces tsc --noEmit.
if ! "$ROOT/bin/build" --stamp-fresh; then
  npm run typecheck
fi

"$ROOT/bin/check-shell"

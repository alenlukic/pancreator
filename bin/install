#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANCREATOR_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SOURCE_COMMIT_OVERRIDE=""
SOURCE_DIRTY_OVERRIDE=""
SOURCE_INDEXED_OVERRIDE=""

TARGET_DIR=""
HARNESS_DIR=""
MODE=""
NON_INTERACTIVE=0
CHOICE=""
SMOKE_RUN=0
SKIP_DEPENDENCIES=0
SKIP_SHELL_ALIAS=0

SOURCE_PAYLOAD_ENTRIES=(
  .npmrc
  .prettierignore
  README.md
  CHANGELOG.md
  VERSION
  bin
  docs
  governance
  library
  package-lock.json
  package.json
  prettier.config.js
  release
  src
  target-extensions
  tsconfig.json
)
GENERATED_PAYLOAD_ENTRIES=(AGENTS.md .gitignore dist node_modules)

# Entries earlier releases installed and current releases do not. Payload
# reconciliation removes only files whose recorded release digest is unchanged.
# Changed and target-added files are retained and backed up.
RETIRED_PAYLOAD_ENTRIES=(tests)

# Paths for Pancreator self-development only. The copy takes them with their
# parent directory, so remove them from staging before the payload hash runs.
SELF_DEVELOPMENT_ONLY_PAYLOAD_PATHS=(
  # Cursor model availability is account-specific and operator-local.
  governance/registries/cursor_model_catalog.json
  # The Pancreator review lineup has no meaning against a target repository.
  library/skills/review-squad-pancreator.md
)

usage() {
  cat <<'USAGE'
Install Pancreator into a target repository.

Usage:
  install --target <dir> [options]
  install --smoke

Options:
  --target <dir>           Target repository (required unless --smoke)
  --harness-dir <dir>      Install the harness here instead of <target>/.pancreator.
                           Creates a detached installation; the directory MUST be
                           outside the target repository.
  --pancreator-root <dir>  Pancreator checkout or release payload
  --repair                 Repair a partial installation
  --clean                  Remove .pancreator and reinstall
  --yes                    Idempotently refresh a complete installation
  --skip-dependencies      Skip npm ci/build in the staged payload
  --skip-shell-alias       Do not append the guarded pan shell function to rc files
  --smoke                  Run scripted installer verification
  -h, --help               Show this help

A complete installation contains the harness at <target>/.pancreator and adds
pan-namespaced commands, subagents, and rules to <target>/.cursor. No file the
target repository tracks is modified; Pancreator-owned paths are excluded via
the clone-local .git/info/exclude.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      TARGET_DIR="${2:-}"
      shift 2
      ;;
    --harness-dir)
      HARNESS_DIR="${2:-}"
      shift 2
      ;;
    --pancreator-root)
      PANCREATOR_ROOT="${2:-}"
      shift 2
      ;;
    --source-commit)
      SOURCE_COMMIT_OVERRIDE="${2:-}"
      shift 2
      ;;
    --source-dirty)
      SOURCE_DIRTY_OVERRIDE="${2:-}"
      shift 2
      ;;
    --source-indexed)
      SOURCE_INDEXED_OVERRIDE="${2:-}"
      shift 2
      ;;
    --repair)
      MODE="repair"
      NON_INTERACTIVE=1
      shift
      ;;
    --clean)
      MODE="clean"
      NON_INTERACTIVE=1
      shift
      ;;
    --yes)
      MODE="yes"
      NON_INTERACTIVE=1
      shift
      ;;
    --update)
      MODE="update"
      NON_INTERACTIVE=1
      shift
      ;;
    --choice)
      CHOICE="${2:-}"
      shift 2
      ;;
    --skip-dependencies)
      SKIP_DEPENDENCIES=1
      shift
      ;;
    --skip-shell-alias)
      SKIP_SHELL_ALIAS=1
      shift
      ;;
    --smoke)
      SMOKE_RUN=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

run_smoke() {
  local smoke_root failures fresh_project existing_cursor_project partial_project no_gitignore_project git_project
  local detached_project detached_harness reconcile_project

  smoke_root="$(mktemp -d "${TMPDIR:-/tmp}/pancreator-smoke.XXXXXX")"
  failures=0

  smoke_step() {
    local step="$1"
    shift

    echo "smoke: $step"

    if ! "$@"; then
      echo "smoke: FAILED $step" >&2
      failures=$((failures + 1))
    fi
  }

  smoke_project() {
    local project

    project="$(mktemp -d "${smoke_root}/project.XXXXXX")"
    printf 'node_modules/\n' >"$project/.gitignore"
    printf '%s' "$project"
  }

  smoke_verify() {
    local project="$1"

    test -x "$project/.pancreator/bin/pan" \
      && test -f "$project/.pancreator/config.json" \
      && test -f "$project/.pancreator/install.json" \
      && test -d "$project/.pancreator/runtime/inbox" \
      && test -f "$project/.pancreator/docs/target-repo-primer.md" \
      && test -f "$project/.pancreator/library/operator-briefs/primitives.json" \
      && test -f "$project/.pancreator/library/schemas/operator-brief.schema.json" \
      && test ! -e "$project/.pancreator/docs/operator-briefs" \
      && test -f "$project/.pancreator/library/skills/review-squad.md" \
      && test ! -e "$project/.pancreator/library/skills/review-squad-pancreator.md" \
      && test ! -e "$project/.pancreator/runtime/target-repo-primer.md" \
      && test -f "$project/.pancreator/runtime/repository-checks.json" \
      && node -e 'const c=require(process.argv[1]); process.exit(c.profiles?.secondary ? 0 : 1)' \
        "$project/.pancreator/runtime/repository-checks.json" \
      && test -f "$project/.pancreator/release/index.json" \
      && test ! -e "$project/.pancreator/runtime/locks" \
      && test -L "$project/.pancreator/.cursor" \
      && test -f "$project/.cursor/commands/pan-start.md" \
      && test -f "$project/.cursor/commands/pan-build-briefs.md" \
      && test -f "$project/.cursor/commands/pan-summarize-context.md" \
      && grep -q '.pancreator/docs/operator-briefs/project.json' \
        "$project/.cursor/commands/pan-build-briefs.md" \
      && test -f "$project/.cursor/agents/pan-coder.md" \
      && grep -q 'library/personas/coder.md' \
        "$project/.cursor/agents/pan-coder.md" \
      && grep -q 'library/personas/reviewer.md' \
        "$project/.cursor/agents/pan-reviewer.md" \
      && grep -q 'pre-implementation' \
        "$project/.pancreator/governance/policies/DEV-001.json" \
      && test -f "$project/.pancreator/governance/handbooks/python/style-guide.md" \
      && grep -q 'Python conformance' \
        "$project/.pancreator/governance/policies/PY-001.json" \
      && grep -q 'Operator supremacy' \
        "$project/.pancreator/governance/policies/OPERATOR-001.json" \
      && grep -q 'operator MAY waive any workflow stage' \
        "$project/.pancreator/governance/policies/WAIVER-001.json" \
      && grep -q 'workspace_changes' \
        "$project/.pancreator/library/schemas/stage-output.schema.json" \
      && grep -q '"workspace_policy": "read_only"' \
        "$project/.pancreator/library/workflows/delivery/stages/verify.json" \
      && test ! -e "$project/.pancreator/workdesk" \
      && test ! -e "$project/.pancreator/runtime/workflows" \
      && test ! -e "$project/.pancreator/tests" \
      && test ! -e "$project/.pancreator/dist/tests" \
      && node -e 'const s=require(process.argv[1]).scripts||{}; process.exit(Object.keys(s).some((k)=>k==="test"||k.startsWith("test:"))||!s.build||!s.check||!s.lint||!s.validate?1:0)' \
        "$project/.pancreator/package.json" \
      && test -d "$project/.pancreator/worktrees"
  }

  fresh_project="$(smoke_project)"
  smoke_step "fresh install" bash "$0" --target "$fresh_project" \
    --pancreator-root "$PANCREATOR_ROOT" --skip-dependencies --skip-shell-alias
  smoke_step "verify fresh install" smoke_verify "$fresh_project"
  # Stand in for an installation from a release that still shipped the harness
  # suite; the refresh below must remove that retired payload entry.
  mkdir -p "$fresh_project/.pancreator/tests/unit"
  printf 'stale\n' >"$fresh_project/.pancreator/tests/unit/legacy.test.ts"
  node -e '
    const crypto = require("node:crypto")
    const fs = require("node:fs")
    const markerPath = process.argv[1]
    const payloadPath = process.argv[2]
    const marker = JSON.parse(fs.readFileSync(markerPath, "utf8"))
    const relative = "tests/unit/legacy.test.ts"
    marker.payload_entries.push("tests")
    marker.payload_files.push({
      path: relative,
      sha256: crypto
        .createHash("sha256")
        .update(fs.readFileSync(payloadPath))
        .digest("hex"),
    })
    fs.writeFileSync(markerPath, `${JSON.stringify(marker, null, 2)}\n`)
  ' "$fresh_project/.pancreator/install.json" \
    "$fresh_project/.pancreator/tests/unit/legacy.test.ts"
  smoke_step "idempotent refresh" bash "$0" --target "$fresh_project" \
    --pancreator-root "$PANCREATOR_ROOT" --yes --skip-dependencies --skip-shell-alias
  smoke_step "verify idempotent refresh" smoke_verify "$fresh_project"

  existing_cursor_project="$(smoke_project)"
  mkdir -p "$existing_cursor_project/.cursor/rules"
  printf 'custom\n' >"$existing_cursor_project/.cursor/rules/custom.mdc"
  smoke_step "existing cursor merge" bash "$0" \
    --target "$existing_cursor_project" --pancreator-root "$PANCREATOR_ROOT" \
    --skip-dependencies --skip-shell-alias
  smoke_step "preserve custom cursor file" test -f \
    "$existing_cursor_project/.cursor/rules/custom.mdc"

  partial_project="$(smoke_project)"
  mkdir -p "$partial_project/.pancreator"
  smoke_step "partial install repair" bash "$0" --target "$partial_project" \
    --pancreator-root "$PANCREATOR_ROOT" --choice r --skip-dependencies --skip-shell-alias
  smoke_step "verify repair" smoke_verify "$partial_project"

  # The target's tracked .gitignore MUST come through byte-identical.
  smoke_step "leave target gitignore unmodified" \
    test "$(cat "$fresh_project/.gitignore")" = "node_modules/"

  git_project="$(mktemp -d "${smoke_root}/project.XXXXXX")"
  git -C "$git_project" init -q
  smoke_step "install into a git target" bash "$0" --target "$git_project" \
    --pancreator-root "$PANCREATOR_ROOT" --skip-dependencies --skip-shell-alias
  smoke_step "ignore harness via local git exclude" grep -Eq \
    '^[[:space:]]*/?\.pancreator/?[[:space:]]*$' \
    "$git_project/.git/info/exclude"
  smoke_step "create no tracked gitignore in a git target" test ! -e \
    "$git_project/.gitignore"
  smoke_step "leave the git target with no tracked changes" \
    test -z "$(git -C "$git_project" status --porcelain)"

  # Resolve to the canonical form the installer records; TMPDIR often carries a
  # trailing slash, so the raw mktemp paths would not compare equal.
  detached_project="$(cd "$(mktemp -d "${smoke_root}/project.XXXXXX")" && pwd)"
  detached_harness="$(cd "$(mktemp -d "${smoke_root}/harness.XXXXXX")" && pwd)"
  git -C "$detached_project" init -q
  smoke_step "detached install" bash "$0" --target "$detached_project" \
    --harness-dir "$detached_harness" --pancreator-root "$PANCREATOR_ROOT" \
    --skip-dependencies --skip-shell-alias
  smoke_step "detached harness lives outside the target" test -x \
    "$detached_harness/bin/pan"
  smoke_step "detached target has no .pancreator" test ! -e \
    "$detached_project/.pancreator"
  smoke_step "detached target keeps the cursor projection" test -f \
    "$detached_project/.cursor/agents/pan-coder.md"
  smoke_step "detached projection uses the absolute harness path" grep -q \
    "$detached_harness/bin/pan" "$detached_project/.cursor/commands/pan-status.md"
  smoke_step "detached config records the absolute workspace" node -e '
    const c = require(process.argv[1])
    process.exit(
      c.installation_mode === "detached" && c.workspace_root === process.argv[2]
        ? 0
        : 1,
    )
  ' "$detached_harness/config.json" "$detached_project"
  smoke_step "detached install leaves the target clean" \
    test -z "$(git -C "$detached_project" status --porcelain)"
  smoke_step "detached operating card states target authority" grep -q \
    'live target authority' "$detached_harness/AGENTS.md"
  smoke_step "detached harness rejects a nested harness dir" bash -c \
    "! bash '$0' --target '$detached_project' \
      --harness-dir '$detached_project/nested' \
      --pancreator-root '$PANCREATOR_ROOT' --skip-dependencies --skip-shell-alias"

  # Payload reconciliation: local fixes to harness-owned files are superseded
  # with an operator flag and a backup; target-specific extensions survive.
  reconcile_project="$(smoke_project)"
  smoke_step "install for payload reconciliation" bash "$0" \
    --target "$reconcile_project" --pancreator-root "$PANCREATOR_ROOT" \
    --skip-dependencies --skip-shell-alias
  printf 'local fix\n' >>"$reconcile_project/.pancreator/docs/runtime-protocol.md"
  printf 'target extension\n' >"$reconcile_project/.pancreator/docs/target-notes.md"
  smoke_step "refresh over local payload changes" bash -c \
    "bash '$0' --target '$reconcile_project' --pancreator-root '$PANCREATOR_ROOT' \
      --yes --skip-dependencies --skip-shell-alias \
      >'$smoke_root/reconcile-refresh.log'"
  smoke_step "flag the superseded local fix" grep -q \
    'superseded  docs/runtime-protocol.md' "$smoke_root/reconcile-refresh.log"
  smoke_step "restore the harness-owned file from source" cmp -s \
    "$PANCREATOR_ROOT/docs/runtime-protocol.md" \
    "$reconcile_project/.pancreator/docs/runtime-protocol.md"
  smoke_step "preserve the target extension" grep -q 'target extension' \
    "$reconcile_project/.pancreator/docs/target-notes.md"
  smoke_step "back up the superseded local fix" bash -c \
    "ls '$reconcile_project/.pancreator/backups/payload/'*'/docs/runtime-protocol.md' >/dev/null"

  no_gitignore_project="$(mktemp -d "${smoke_root}/project.XXXXXX")"
  smoke_step "install without target gitignore" bash "$0" \
    --target "$no_gitignore_project" --pancreator-root "$PANCREATOR_ROOT" \
    --skip-dependencies --skip-shell-alias
  smoke_step "do not create target gitignore" test ! -e \
    "$no_gitignore_project/.gitignore"

  rm -rf "$smoke_root"

  if [[ "$failures" -gt 0 ]]; then
    echo "smoke: $failures step(s) failed" >&2
    exit 1
  fi

  echo "smoke: all steps passed"
}

if [[ "$SMOKE_RUN" -eq 1 ]]; then
  run_smoke
  exit 0
fi

if [[ -z "$TARGET_DIR" ]]; then
  echo "Error: --target is required." >&2
  usage >&2
  exit 1
fi

if [[ ! -d "$TARGET_DIR" ]]; then
  echo "Error: target directory does not exist: $TARGET_DIR" >&2
  exit 1
fi

if [[ ! -d "$PANCREATOR_ROOT" ]]; then
  echo "Error: Pancreator root does not exist: $PANCREATOR_ROOT" >&2
  exit 1
fi

TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
PANCREATOR_ROOT="$(cd "$PANCREATOR_ROOT" && pwd)"

for required in VERSION config.json package.json package-lock.json bin/install-support; do
  if [[ ! -e "$PANCREATOR_ROOT/$required" ]]; then
    echo "Error: invalid Pancreator payload; missing $required" >&2
    exit 1
  fi
done

if ! command -v node >/dev/null 2>&1; then
  echo "Error: Node.js 22 or newer is required." >&2
  exit 1
fi

NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"

if [[ "$NODE_MAJOR" -lt 22 ]]; then
  echo "Error: Node.js 22 or newer is required; found $(node --version)." >&2
  exit 1
fi

# A detached installation places the harness outside the target tree. The target
# repository still receives the pan-namespaced `.cursor` projection so Cursor
# works when the operator opens the target; only the harness itself moves.
DETACHED=0

if [[ -n "$HARNESS_DIR" ]]; then
  mkdir -p "$HARNESS_DIR"
  HARNESS_DIR="$(cd "$HARNESS_DIR" && pwd)"

  if [[ "$HARNESS_DIR" == "$TARGET_DIR" || "$HARNESS_DIR" == "$TARGET_DIR"/* ]]; then
    echo "Error: --harness-dir MUST be outside the target repository: $HARNESS_DIR" >&2
    exit 1
  fi

  PANCREATOR_DIR="$HARNESS_DIR"
  DETACHED=1
else
  PANCREATOR_DIR="$TARGET_DIR/.pancreator"
fi

CONFIG_JSON="$PANCREATOR_DIR/config.json"
RUNTIME_DIR="$PANCREATOR_DIR/runtime"
INBOX_DIR="$RUNTIME_DIR/inbox"
DOCS_DIR="$PANCREATOR_DIR/docs"
PRIMER_PATH="$DOCS_DIR/target-repo-primer.md"
BRIEF_SYSTEM_DIR="$DOCS_DIR/operator-briefs"
LEGACY_PRIMER_PATH="$RUNTIME_DIR/target-repo-primer.md"
LEGACY_CONFIG_JSON="$PANCREATOR_DIR/project.json"
INSTALL_MARKER="$PANCREATOR_DIR/install.json"
CURSOR_DIR="$TARGET_DIR/.cursor"

VERSION="$(tr -d '[:space:]' <"$PANCREATOR_ROOT/VERSION")"

if [[ -z "$VERSION" ]]; then
  echo "Error: VERSION must be non-empty." >&2
  exit 1
fi

release_commit_for_version() {
  local version="$1"
  local index="$PANCREATOR_ROOT/release/index.json"

  if [[ ! -f "$index" ]]; then
    return 1
  fi

  node -e '
    const fs = require("node:fs")
    const [file, version] = process.argv.slice(1)
    const value = JSON.parse(fs.readFileSync(file, "utf8"))
    const release = value.releases?.find((entry) => entry.version === version)
    if (!release || typeof release.commit !== "string") process.exit(2)
    process.stdout.write(release.commit)
  ' "$index" "$version"
}

resolve_source_metadata() {
  local head indexed

  if [[ -n "$SOURCE_COMMIT_OVERRIDE" ]]; then
    case "$SOURCE_INDEXED_OVERRIDE" in
      true | false)
        SOURCE_COMMIT="$SOURCE_COMMIT_OVERRIDE"
        SOURCE_INDEXED="$SOURCE_INDEXED_OVERRIDE"
        return
        ;;
      *)
        echo "Error: --source-indexed must be true or false when --source-commit is supplied." >&2
        exit 1
        ;;
    esac
  fi

  if ! git -C "$PANCREATOR_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: release payload requires --source-commit when it has no Git metadata." >&2
    exit 1
  fi

  head="$(git -C "$PANCREATOR_ROOT" rev-parse HEAD)"

  if [[ "$SOURCE_DIRTY" == "true" ]]; then
    SOURCE_COMMIT="$head"
    SOURCE_INDEXED=false
    return
  fi

  if ! indexed="$(release_commit_for_version "$VERSION")"; then
    SOURCE_COMMIT="$head"
    SOURCE_INDEXED=false
    return
  fi

  if ! git -C "$PANCREATOR_ROOT" cat-file -e "${indexed}^{commit}" 2>/dev/null; then
    echo "Error: indexed release commit is unavailable: $indexed" >&2
    exit 1
  fi

  if ! git -C "$PANCREATOR_ROOT" merge-base --is-ancestor "$indexed" "$head"; then
    echo "Error: indexed release $VERSION is not an ancestor of the current checkout." >&2
    exit 1
  fi

  if ! git -C "$PANCREATOR_ROOT" diff --quiet "$indexed" "$head" -- \
    .gitignore config.json "${SOURCE_PAYLOAD_ENTRIES[@]}" \
    ':(exclude)release/index.json'; then
    echo "Error: installed harness inputs differ from indexed release $VERSION." >&2
    echo "Complete the Pancreator self-development release flow or increment VERSION before installing this clean checkout." >&2
    exit 1
  fi

  SOURCE_COMMIT="$indexed"
  SOURCE_INDEXED=true
}

source_dirty() {
  if [[ -n "$SOURCE_DIRTY_OVERRIDE" ]]; then
    case "$SOURCE_DIRTY_OVERRIDE" in
      true | false)
        printf '%s' "$SOURCE_DIRTY_OVERRIDE"
        return
        ;;
      *)
        echo "Error: --source-dirty must be true or false." >&2
        exit 1
        ;;
    esac
  fi

  if [[ -n "$(git -C "$PANCREATOR_ROOT" status --porcelain --untracked-files=all 2>/dev/null)" ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

SOURCE_DIRTY="$(source_dirty)"
SOURCE_COMMIT=""
SOURCE_INDEXED=""
resolve_source_metadata

workspace_identity() {
  local remote roots

  remote="$(git -C "$TARGET_DIR" config --get remote.origin.url 2>/dev/null || true)"

  if [[ -n "$remote" ]]; then
    printf 'git-remote:%s' "$remote"
    return
  fi

  roots="$(git -C "$TARGET_DIR" rev-list --max-parents=0 HEAD 2>/dev/null | sort | tr '\n' ',' || true)"

  if [[ -n "$roots" ]]; then
    printf 'git-roots:%s' "$roots"
    return
  fi

  printf 'path:%s' "$TARGET_DIR"
}

workspace_id() {
  local identity
  identity="$(workspace_identity)"

  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$identity" | shasum -a 256 | cut -c1-16
  else
    printf '%s' "$identity" | openssl dgst -sha256 | awk '{print substr($2, 1, 16)}'
  fi
}

payload_entries_csv() {
  local entries=("${SOURCE_PAYLOAD_ENTRIES[@]}" "${GENERATED_PAYLOAD_ENTRIES[@]}")
  local joined=""
  local entry

  for entry in "${entries[@]}"; do
    if [[ -n "$joined" ]]; then
      joined+=","
    fi
    joined+="$entry"
  done

  printf '%s' "$joined"
}

retired_payload_entries_csv() {
  local joined=""
  local entry

  for entry in "${RETIRED_PAYLOAD_ENTRIES[@]}"; do
    if [[ -n "$joined" ]]; then
      joined+=","
    fi
    joined+="$entry"
  done

  printf '%s' "$joined"
}

report_existing_harness() {
  local previous_marker="$1"
  local args=(
    detect-existing-harness
    --target-root "$TARGET_DIR"
    --source-root "$PANCREATOR_ROOT"
  )

  if [[ -f "$previous_marker" ]]; then
    args+=(--previous-marker "$previous_marker")
  fi

  if [[ "$DETACHED" -eq 1 ]]; then
    args+=(--installation-mode detached)
  else
    args+=(--installation-mode embedded)
  fi

  node "$PANCREATOR_ROOT/bin/install-support" "${args[@]}"
}

report_clean_target_extensions() {
  if [[ ! -d "$PANCREATOR_DIR/target-extensions" ]]; then
    return
  fi

  node "$PANCREATOR_ROOT/bin/install-support" report-clean-target-extensions \
    --harness-root "$PANCREATOR_DIR" \
    --target-root "$TARGET_DIR"
}

report_legacy_gitignore() {
  local gitignore="$TARGET_DIR/.gitignore"

  if [[ ! -f "$gitignore" ]]; then
    return
  fi

  if grep -Eq '^[[:space:]]*/?\.pancreator/?[[:space:]]*(#.*)?$' "$gitignore"; then
    echo ""
    echo "Legacy Pancreator ignore entry detected in tracked .gitignore."
    echo "Installation uses clone-local .git/info/exclude instead; the tracked"
    echo "file was left byte-identical. Remove the legacy line when convenient."
  fi
}

# Keep Pancreator's own files out of the target's Git status without editing any
# file the target repository tracks. `.git/info/exclude` is local to the clone
# and is never committed, so installation leaves the repository's content
# byte-identical.
#
# Only Pancreator-owned paths are listed. Excluding `.cursor/` wholesale would
# hide the target's own agent configuration from its operators, and ignore rules
# never affect files Git already tracks, so a target that versions its own
# `.cursor/` files is unaffected either way.
GIT_EXCLUDE_BEGIN="# >>> pancreator >>>"
GIT_EXCLUDE_END="# <<< pancreator <<<"

ensure_target_git_exclude() {
  local git_dir exclude_file

  if ! git_dir="$(git -C "$TARGET_DIR" rev-parse --absolute-git-dir 2>/dev/null)"; then
    return
  fi

  exclude_file="$git_dir/info/exclude"
  mkdir -p "$git_dir/info"

  # Drop any previous block so the managed patterns stay current and the file
  # never accumulates duplicates across refreshes.
  if [[ -f "$exclude_file" ]]; then
    awk -v begin="$GIT_EXCLUDE_BEGIN" -v end="$GIT_EXCLUDE_END" '
      $0 == begin { skipping = 1; next }
      $0 == end { skipping = 0; next }
      !skipping { print }
    ' "$exclude_file" >"$exclude_file.pancreator-tmp"
    mv "$exclude_file.pancreator-tmp" "$exclude_file"
  fi

  if [[ -s "$exclude_file" && -n "$(tail -c 1 "$exclude_file")" ]]; then
    printf '\n' >>"$exclude_file"
  fi

  {
    printf '%s\n' "$GIT_EXCLUDE_BEGIN"

    # A detached harness lives outside the target, so there is nothing at
    # `.pancreator/` to exclude.
    if [[ "$DETACHED" -eq 0 ]]; then
      printf '/.pancreator/\n'
    fi

    cat <<'EXCLUDE'
/.cursor/agents/pan-*.md
/.cursor/commands/pan-*.md
/.cursor/rules/pan-*.mdc
/.cursor/rules/pancreator.mdc
EXCLUDE

    printf '%s\n' "$GIT_EXCLUDE_END"
  } >>"$exclude_file"

  echo "Ignored Pancreator files via $exclude_file (local only; not tracked)"
}

configure_shell_alias() {
  if [[ "$SKIP_SHELL_ALIAS" -eq 1 ]]; then
    return 0
  fi

  if [[ ! -f "$PANCREATOR_ROOT/dist/src/lib/shell-alias.js" ]]; then
    echo "Skipping pan shell function; dist build is required before install can configure it."
    return 0
  fi

  node "$PANCREATOR_ROOT/bin/install-support" configure-shell-alias \
    --dist-root "$PANCREATOR_ROOT/dist" || true
}

configure_install_shell_aliases() {
  configure_shell_alias
}

prepare_persistent_layout() {
  local migrated_at backup_dir

  mkdir -p \
    "$INBOX_DIR" \
    "$RUNTIME_DIR/logs/workflows" \
    "$RUNTIME_DIR/backlog" \
    "$DOCS_DIR" \
    "$PANCREATOR_DIR/worktrees"

  # Per-file workspace locks were removed. Refreshes clean up stale lock files
  # from older installations so they can never block run completion again.
  rm -rf "$RUNTIME_DIR/locks"
  find "$RUNTIME_DIR/logs/workflows" -type f -name '.lock' -delete

  # Remove the retired recursive workspace-tracking payload from every refresh
  # or version update. Split the legacy filename so the obsolete subsystem name
  # does not remain in active documentation or runtime contracts.
  legacy_validation_name="led""ger-validation.json"
  rm -rf "$RUNTIME_DIR/workspace"
  for workflow_root in \
    "$RUNTIME_DIR/workflows" \
    "$RUNTIME_DIR/logs/workflows"; do
    [[ -d "$workflow_root" ]] || continue
    find "$workflow_root" -type f \
      \( -name "$legacy_validation_name" -o -name 'baseline.json' \) -delete
  done

  if [[ ! -f "$PRIMER_PATH" ]]; then
    if [[ -f "$LEGACY_PRIMER_PATH" ]]; then
      mv "$LEGACY_PRIMER_PATH" "$PRIMER_PATH"
      echo "Migrated target repository primer to $PRIMER_PATH"
    else
      cp "$PANCREATOR_ROOT/library/templates/target-repo-primer.md" \
        "$PRIMER_PATH"
    fi
  elif [[ -f "$LEGACY_PRIMER_PATH" ]]; then
    if ! cmp -s "$LEGACY_PRIMER_PATH" "$PRIMER_PATH"; then
      migrated_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
      backup_dir="$PANCREATOR_DIR/backups/target-repo-primer/${migrated_at//:/-}"
      mkdir -p "$backup_dir"
      cp "$LEGACY_PRIMER_PATH" "$backup_dir/target-repo-primer.md"
    fi
    rm -f "$LEGACY_PRIMER_PATH"
  fi

  if [[ ! -f "$RUNTIME_DIR/repository-checks.json" ]]; then
    cp "$PANCREATOR_ROOT/library/templates/repository-checks.json" \
      "$RUNTIME_DIR/repository-checks.json"
  fi

  node "$PANCREATOR_ROOT/bin/install-support" migrate-repository-checks \
    --config "$RUNTIME_DIR/repository-checks.json" \
    --template "$PANCREATOR_ROOT/library/templates/repository-checks.json" \
    --backup-root "$PANCREATOR_DIR/backups/repository-checks"
}

# Installations created before the harness configuration was renamed carry
# `project.json`. Move it into place before any completeness check so an
# existing install is not misread as partial, and so `write-project` merges the
# operator's `active_config` and model overrides forward instead of discarding
# them. Runs on every install, refresh, repair, and update.
migrate_legacy_config() {
  local migrated_at backup_dir

  if [[ ! -f "$LEGACY_CONFIG_JSON" ]]; then
    return
  fi

  if [[ ! -f "$CONFIG_JSON" ]]; then
    mv "$LEGACY_CONFIG_JSON" "$CONFIG_JSON"
    echo "Migrated harness configuration: project.json -> config.json"
    return
  fi

  # Both names present: config.json is authoritative. Retain the superseded
  # file as evidence rather than deleting a config the operator may have edited.
  if cmp -s "$LEGACY_CONFIG_JSON" "$CONFIG_JSON"; then
    rm -f "$LEGACY_CONFIG_JSON"
    return
  fi

  migrated_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  backup_dir="$PANCREATOR_DIR/backups/config/${migrated_at//:/-}"
  mkdir -p "$backup_dir"
  mv "$LEGACY_CONFIG_JSON" "$backup_dir/project.json"
  echo "Superseded legacy project.json retained at $backup_dir/project.json"
}

is_complete_install() {
  [[ -x "$PANCREATOR_DIR/bin/pan" \
    && -f "$CONFIG_JSON" \
    && -f "$INSTALL_MARKER" \
    && -d "$INBOX_DIR" \
    && -L "$PANCREATOR_DIR/.cursor" \
    && -f "$CURSOR_DIR/commands/pan-start.md" ]]
}

is_partial_install() {
  if is_complete_install; then
    return 1
  fi

  if [[ ! -d "$PANCREATOR_DIR" ]]; then
    return 1
  fi

  # `--harness-dir` is routinely pointed at a directory the operator already
  # created, and this script's own `mkdir -p` creates one too, so an empty
  # detached destination is fresh rather than damaged. An embedded
  # `.pancreator/` is created only by Pancreator, so its mere presence still
  # requires an explicit repair or clean decision.
  if [[ "$DETACHED" -eq 1 && -z "$(ls -A "$PANCREATOR_DIR" 2>/dev/null)" ]]; then
    return 1
  fi

  return 0
}

apply_partial_choice() {
  local choice="$1"

  case "$choice" in
    r | R)
      MODE="repair"
      ;;
    c | C)
      MODE="clean"
      ;;
    a | A | '')
      echo "Aborted."
      exit 0
      ;;
    *)
      echo "Invalid choice. Aborted." >&2
      exit 1
      ;;
  esac
}

prompt_partial_choice() {
  if [[ -n "$CHOICE" ]]; then
    apply_partial_choice "$CHOICE"
    return
  fi

  if [[ "$NON_INTERACTIVE" -eq 1 || ! -t 0 ]]; then
    echo "Error: partial installation detected; supply --repair or --clean." >&2
    exit 1
  fi

  echo "Partial Pancreator installation detected in $TARGET_DIR."
  echo "Choose: [r] repair, [c] clean install, [a] abort"
  read -r -p "> " choice
  apply_partial_choice "$choice"
}

prepare_staging_payload() {
  local staging="$1"
  local entry

  mkdir -p "$staging"

  for entry in "${SOURCE_PAYLOAD_ENTRIES[@]}"; do
    if [[ ! -e "$PANCREATOR_ROOT/$entry" ]]; then
      echo "Error: Pancreator payload entry is missing: $entry" >&2
      exit 1
    fi

    cp -Rp "$PANCREATOR_ROOT/$entry" "$staging/$entry"
  done

  local self_development_only
  for self_development_only in "${SELF_DEVELOPMENT_ONLY_PAYLOAD_PATHS[@]}"; do
    rm -f "$staging/$self_development_only"
  done

  # The harness test suite is not installed, so the staged package must not
  # advertise scripts that would invoke it.
  node "$PANCREATOR_ROOT/bin/install-support" strip-harness-test-scripts \
    --package "$staging/package.json"

  if [[ "$DETACHED" -eq 1 ]]; then
    cp "$PANCREATOR_ROOT/library/templates/detached-AGENTS.md" \
      "$staging/AGENTS.md"
  else
    cp "$PANCREATOR_ROOT/library/templates/embedded-AGENTS.md" \
      "$staging/AGENTS.md"
  fi
  cp "$PANCREATOR_ROOT/library/templates/embedded-gitignore" \
    "$staging/.gitignore"

  if [[ "$SKIP_DEPENDENCIES" -eq 0 ]]; then
    if ! command -v npm >/dev/null 2>&1; then
      echo "Error: npm is required to build the embedded harness." >&2
      exit 1
    fi

    (
      cd "$staging"
      npm ci --ignore-scripts --no-audit --no-fund --loglevel=error
      npm run build --silent
    )
  elif [[ -d "$PANCREATOR_ROOT/dist" ]]; then
    cp -Rp "$PANCREATOR_ROOT/dist" "$staging/dist"
    # A built payload compiles no test sources. Copying the self-development
    # dist would otherwise reintroduce the compiled harness suite.
    rm -rf "$staging/dist/tests"
  fi
}

remove_previous_payload() {
  local entry

  for entry in "${SOURCE_PAYLOAD_ENTRIES[@]}" "${GENERATED_PAYLOAD_ENTRIES[@]}"; do
    rm -rf "$PANCREATOR_DIR/$entry"
  done
}

install_payload() {
  local harness_preexisting="$1"
  local previous_marker="${2:-$INSTALL_MARKER}"
  local staging backup_root cursor_manifest payload_manifest installed_at entry
  local cursor_args project_args

  staging="$(mktemp -d "${TMPDIR:-/tmp}/pancreator-install.XXXXXX")"
  trap 'rm -rf "$staging"' RETURN

  installed_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  prepare_staging_payload "$staging"

  # Hash the pristine staged release before any target-specific seeding. The
  # manifest describes release-owned content only, so later updates can tell
  # local fixes and target extensions apart from files the release shipped.
  payload_manifest="$staging/payload-manifest.json"
  node "$PANCREATOR_ROOT/bin/install-support" hash-payload \
    --root "$staging" \
    --entries "$(payload_entries_csv)" \
    --out "$payload_manifest"
  ensure_target_git_exclude
  report_legacy_gitignore

  mkdir -p "$PANCREATOR_DIR" "$CURSOR_DIR"
  prepare_persistent_layout

  if [[ -f "$staging/dist/src/runtime-maintenance-cli.js" ]]; then
    node "$staging/dist/src/runtime-maintenance-cli.js" \
      --root "$PANCREATOR_DIR" --days 7 >/dev/null
  elif [[ "$SKIP_DEPENDENCIES" -eq 0 ]]; then
    echo "Error: runtime maintenance executable is missing from staged payload." >&2
    exit 1
  fi

  # `docs/` is release-owned except for the generated target primer. Seed the
  # staged payload with the target-specific file so refreshes and updates do not
  # replace it with Pancreator's self-development primer.
  cp "$PRIMER_PATH" "$staging/docs/target-repo-primer.md"

  # The shared brief model ships with the harness, but the project ontology and
  # design tokens belong to the target. Preserve them on refresh and omit the
  # Pancreator self-development layer from fresh embedded installations.
  rm -rf "$staging/docs/operator-briefs"
  if [[ -d "$BRIEF_SYSTEM_DIR" ]]; then
    cp -Rp "$BRIEF_SYSTEM_DIR" "$staging/docs/operator-briefs"
  fi

  # Generated target language guidance is durable target state. Preserve only a
  # complete marked bundle; malformed bundles are removed and must be rebuilt
  # by /pan-build-docs, where the registered validator explains the defect.
  node "$PANCREATOR_ROOT/bin/install-support" preserve-language-governance \
    --existing-root "$PANCREATOR_DIR" \
    --staging-root "$staging"

  # A refresh or update onto an existing installation reconciles the installed
  # payload first: local fixes lose to the Pancreator source but are backed up
  # and flagged, and target-specific extensions are carried forward.
  if [[ -f "$previous_marker" ]]; then
    node "$PANCREATOR_ROOT/bin/install-support" reconcile-payload \
      --existing-root "$PANCREATOR_DIR" \
      --staging-root "$staging" \
      --previous-marker "$previous_marker" \
      --backup-root "$PANCREATOR_DIR/backups/payload/${installed_at//:/-}" \
      --entries "$(payload_entries_csv)" \
      --retired-entries "$(retired_payload_entries_csv)"
  fi

  node "$PANCREATOR_ROOT/bin/install-support" migrate-policy-extensions \
    --staging-root "$staging"

  if [[ "$harness_preexisting" == "true" ]]; then
    report_existing_harness "$previous_marker"
  fi

  backup_root="$PANCREATOR_DIR/backups/cursor/${installed_at//:/-}"
  cursor_manifest="$staging/cursor-manifest.json"

  cursor_args=(
    project-cursor
    --source-root "$PANCREATOR_ROOT"
    --target-root "$TARGET_DIR"
    --manifest-out "$cursor_manifest"
    --backup-root "$backup_root"
    --previous-marker "$previous_marker"
  )

  if [[ -f "$CONFIG_JSON" ]]; then
    cursor_args+=(--persona-config "$CONFIG_JSON")
  fi

  # Projected Cursor artifacts address the harness by path. An embedded harness
  # is reachable at `.pancreator`; a detached one only by absolute path.
  if [[ "$DETACHED" -eq 1 ]]; then
    cursor_args+=(--harness-prefix "$PANCREATOR_DIR")
  fi

  node "$PANCREATOR_ROOT/bin/install-support" "${cursor_args[@]}"

  remove_previous_payload

  for entry in "${SOURCE_PAYLOAD_ENTRIES[@]}" "${GENERATED_PAYLOAD_ENTRIES[@]}"; do
    if [[ -e "$staging/$entry" ]]; then
      cp -Rp "$staging/$entry" "$PANCREATOR_DIR/$entry"
    fi
  done

  project_args=(
    write-project
    --source "$PANCREATOR_ROOT/config.json"
    --destination "$CONFIG_JSON"
    --workspace-id "$(workspace_id)"
  )

  if [[ "$DETACHED" -eq 1 ]]; then
    project_args+=(--detached-workspace "$TARGET_DIR")
  fi

  node "$PANCREATOR_ROOT/bin/install-support" "${project_args[@]}"

  # The runtime reaches the Cursor surface as `<installation>/.cursor`. An
  # embedded harness links to its parent; a detached one MUST link absolutely.
  rm -rf "$PANCREATOR_DIR/.cursor"

  if [[ "$DETACHED" -eq 1 ]]; then
    ln -s "$CURSOR_DIR" "$PANCREATOR_DIR/.cursor"
  else
    ln -s ../.cursor "$PANCREATOR_DIR/.cursor"
  fi

  node "$PANCREATOR_ROOT/bin/install-support" write-marker \
    --destination "$INSTALL_MARKER" \
    --cursor-manifest "$cursor_manifest" \
    --version "$VERSION" \
    --source-commit "$SOURCE_COMMIT" \
    --source-dirty "$SOURCE_DIRTY" \
    --source-indexed "$SOURCE_INDEXED" \
    --installed-at "$installed_at" \
    --payload-entries "$(payload_entries_csv)" \
    --payload-manifest "$payload_manifest"

  rm -rf "$staging"
  trap - RETURN

  echo "Pancreator $VERSION installed in $PANCREATOR_DIR"
  echo "  workspace:      $TARGET_DIR"
  echo "  harness config: $CONFIG_JSON"
  echo "  target primer:  $PRIMER_PATH"
  echo "  brief system:   run /pan-build-briefs after install"
  echo "  runtime state:  $RUNTIME_DIR"
  echo "  Cursor surface: $CURSOR_DIR"

  if [[ "$SOURCE_DIRTY" == "true" ]]; then
    echo ""
    echo "Development snapshot: source worktree is dirty."
    echo "Automatic release updates will remain disabled for this install."
  elif [[ "$SOURCE_INDEXED" != "true" ]]; then
    echo ""
    echo "Unindexed release candidate: version $VERSION has no release-index entry yet."
    echo "Automatic release updates will remain disabled for this install."
  fi

  report_browser_readiness

  echo ""

  if [[ "$DETACHED" -eq 1 ]]; then
    echo "Detached installation: the harness lives outside the target repository."
    echo "Invoke it by absolute path, or export PANCREATOR_ROOT to run from anywhere:"
    echo "  $PANCREATOR_DIR/bin/pan doctor"
    echo "  export PANCREATOR_ROOT=$PANCREATOR_DIR"
  else
    echo "Run from the target repository:"
    echo "  ./.pancreator/bin/pan doctor"
    echo "  ./.pancreator/bin/pan init --workflow delivery --request runtime/inbox/request.md"
  fi

  configure_install_shell_aliases
}

# BROWSER-001 requires a Chrome for Testing bundle and a chrome-devtools MCP
# server. Pancreator installs neither a browser nor target MCP config, so the gap
# is reported rather than silently deferred to a stage that owes a verdict.
report_browser_readiness() {
  local found=""
  local candidate

  for candidate in \
    "/Applications/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing" \
    "/opt/chrome-for-testing/chrome" \
    "/usr/local/bin/chrome-for-testing"; do
    if [[ -e "$candidate" ]]; then
      found="$candidate"
      break
    fi
  done

  local mcp=""

  for candidate in "$TARGET_DIR/.cursor/mcp.json" "$TARGET_DIR/.mcp.json"; do
    if [[ -f "$candidate" ]] && grep -q 'chrome-devtools' "$candidate"; then
      mcp="$candidate"
      break
    fi
  done

  if [[ -n "$found" && -n "$mcp" ]]; then
    return 0
  fi

  echo ""
  echo "Visual QA readiness (BROWSER-001):"

  if [[ -z "$found" ]]; then
    echo "  - Chrome for Testing was not found. Install it if this target has a web UI."
  fi

  if [[ -z "$mcp" ]]; then
    echo "  - No chrome-devtools MCP server is configured in the target's .cursor/mcp.json."
  fi

  echo "  Until both are present, browser verdicts report environment-blocked."
  echo "  Details: pan doctor, and docs/embedded-installation.md"
}

migrate_legacy_config

# Report the target's pre-existing agentic harness configuration on first
# install only. The detector no-ops when the repository has none, so this covers
# `.cursor/`, CLAUDE.md, AGENTS.md, and every other surface it knows about.
HARNESS_PREEXISTING=false

if [[ ! -f "$INSTALL_MARKER" ]]; then
  HARNESS_PREEXISTING=true
fi

if is_complete_install; then
  if [[ -z "$MODE" ]]; then
    MODE="yes"
  fi

  case "$MODE" in
    yes | repair)
      install_payload false
      echo "Installation refresh completed."
      ;;
    update)
      install_payload false
      echo "Fast-forward update completed."
      ;;
    clean)
      previous_marker_copy="$(mktemp "${TMPDIR:-/tmp}/pancreator-marker.XXXXXX")"
      trap 'rm -f "$previous_marker_copy"' EXIT
      cp "$INSTALL_MARKER" "$previous_marker_copy"
      report_clean_target_extensions
      rm -rf "$PANCREATOR_DIR"
      install_payload "$HARNESS_PREEXISTING" "$previous_marker_copy"
      rm -f "$previous_marker_copy"
      trap - EXIT
      echo "Clean reinstall completed."
      ;;
    *)
      echo "Error: unsupported mode for complete installation: $MODE" >&2
      exit 1
      ;;
  esac

  exit 0
fi

if is_partial_install; then
  if [[ -z "$MODE" ]]; then
    prompt_partial_choice
  fi

  case "$MODE" in
    repair)
      install_payload "$HARNESS_PREEXISTING"
      echo "Repair completed."
      ;;
    clean)
      report_clean_target_extensions
      rm -rf "$PANCREATOR_DIR"
      install_payload "$HARNESS_PREEXISTING"
      echo "Clean reinstall completed."
      ;;
    *)
      echo "Error: partial installation requires --repair or --clean." >&2
      exit 1
      ;;
  esac

  exit 0
fi

install_payload "$HARNESS_PREEXISTING"

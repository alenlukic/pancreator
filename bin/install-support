#!/usr/bin/env node
import { createHash } from 'node:crypto'
import {
  cpSync,
  copyFileSync,
  existsSync,
  lstatSync,
  mkdirSync,
  readFileSync,
  readdirSync,
  renameSync,
  rmdirSync,
  rmSync,
  writeFileSync,
} from 'node:fs'
import path from 'node:path'
import { fileURLToPath, pathToFileURL } from 'node:url'

function fail(message) {
  process.stderr.write(`${message}\n`)
  process.exit(1)
}

function option(name) {
  const index = process.argv.indexOf(name)

  if (index === -1) {
    return null
  }

  const value = process.argv[index + 1]

  if (!value || value.startsWith('--')) {
    fail(`${name} requires a value`)
  }

  return value
}

function requiredOption(name) {
  return option(name) ?? fail(`${name} is required`)
}

function readJson(filePath) {
  return JSON.parse(readFileSync(filePath, 'utf8'))
}

function writeJson(filePath, value) {
  mkdirSync(path.dirname(filePath), { recursive: true })
  writeFileSync(filePath, `${JSON.stringify(value, null, 2)}\n`)
}

function writeJsonAtomic(filePath, value) {
  mkdirSync(path.dirname(filePath), { recursive: true })

  const temporary = `${filePath}.tmp-${process.pid}`

  writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`)
  renameSync(temporary, filePath)
}

function sha256(value) {
  return createHash('sha256').update(value).digest('hex')
}

const EMBEDDED_HARNESS_PREFIX = '.pancreator'
const CURSOR_PROJECTION_TOKENS = {
  harnessPath: '{{PANCREATOR_HARNESS_PATH}}',
  panCommand: '{{PANCREATOR_PAN_COMMAND}}',
  npmPrefix: '{{PANCREATOR_NPM_PREFIX}}',
  cliPath: '{{PANCREATOR_CLI_PATH}}',
}
const UNRESOLVED_PROJECTION_TOKEN = /\{\{PANCREATOR_[A-Z_]+\}\}/gu
const GUIDANCE_DIGEST_BASIS =
  'SHA-256 of the selected text after leading and trailing whitespace is trimmed.'

// Installer-time mirror of src/lib/cursor-content.ts. The installer runs before
// the staged payload is built, so it cannot import the compiled module.
// `tests/unit/projection.test.ts` pins the compiled behavior and
// `tests/secondary/embedded-installation.test.ts` pins this one. Keep the two
// in step when either changes.
function projectCursorContent(
  content,
  relative,
  harnessPrefix = EMBEDDED_HARNESS_PREFIX,
) {
  const panCommand =
    harnessPrefix === EMBEDDED_HARNESS_PREFIX
      ? `./${harnessPrefix}/bin/pan`
      : `${harnessPrefix}/bin/pan`
  const projected = content
    .replaceAll(CURSOR_PROJECTION_TOKENS.harnessPath, `${harnessPrefix}/`)
    .replaceAll(CURSOR_PROJECTION_TOKENS.panCommand, panCommand)
    .replaceAll(
      CURSOR_PROJECTION_TOKENS.npmPrefix,
      ` --prefix ${harnessPrefix}`,
    )
    .replaceAll(CURSOR_PROJECTION_TOKENS.cliPath, '')
  const unresolved = projected.match(UNRESOLVED_PROJECTION_TOKEN) ?? []

  if (unresolved.length > 0) {
    fail(
      `${relative} contains unresolved projection tokens: ${[
        ...new Set(unresolved),
      ].join(', ')}`,
    )
  }

  return projected
}

// Kept in sync with renderGuidanceBlock in src/lib/policy-guidance.ts.
function guidanceSelectedRange(guidance) {
  if (guidance.start_heading && guidance.end_heading) {
    return `from \`${guidance.start_heading}\` to \`${guidance.end_heading}\``
  }

  if (guidance.start_heading) {
    return `from \`${guidance.start_heading}\` to the end of the file`
  }

  if (guidance.end_heading) {
    return `from the start of the file to \`${guidance.end_heading}\``
  }

  return 'the complete file'
}

// Kept in sync with renderPolicyCursorRule in src/lib/cursor-content.ts. This
// script runs before the harness is built, so it cannot import that module.
function renderPolicyCursorRule(policy) {
  return [
    '---',
    `description: ${policy.id} — ${policy.title}`,
    'alwaysApply: true',
    '---',
    '',
    `<!-- Generated from governance/policies/${policy.id}.json. Edit the policy, not this file. -->`,
    '',
    'The terms MUST, MUST NOT, SHOULD, SHOULD NOT, and MAY use RFC 2119 meanings.',
    '',
    `# ${policy.id} · ${policy.title}`,
    '',
    policy.summary,
    '',
    ...policy.instructions.map((instruction) => `- ${instruction}`),
    ...(policy.guidance_sources ?? []).flatMap((guidance) => [
      '',
      `## Guidance reference · \`${guidance.path}\``,
      '',
      `- Read when: ${guidance.read_trigger}`,
      `- Selected range: ${guidanceSelectedRange(guidance)}.`,
      `- Content digest: \`sha256:${guidance.content_sha256}\` — ` +
        `${guidance.line_count} lines, ${guidance.byte_length} bytes.`,
      `- Digest basis: ${GUIDANCE_DIGEST_BASIS}`,
    ]),
    '',
  ].join('\n')
}

/** Resolve a policy and inline its declared guidance slices. */
function policyRuleSource(sourceRoot, sourcePath) {
  const policy = readJson(sourcePath)

  if (
    typeof policy?.id !== 'string' ||
    typeof policy.title !== 'string' ||
    typeof policy.summary !== 'string' ||
    !Array.isArray(policy.instructions)
  ) {
    fail(`Invalid policy-rule projection source: ${sourcePath}`)
  }

  for (const guidance of policy.guidance_sources ?? []) {
    const full = readFileSync(
      path.join(sourceRoot, guidance.path),
      'utf8',
    ).trim()
    const start = guidance.start_heading
      ? full.indexOf(guidance.start_heading)
      : 0
    const end = guidance.end_heading
      ? full.indexOf(guidance.end_heading, start)
      : full.length

    if (start < 0 || end <= start) {
      fail(`Invalid guidance slice for ${policy.id}: ${guidance.path}`)
    }

    const content = full.slice(start, end).trim()

    guidance.content = content
    guidance.content_sha256 = createHash('sha256').update(content).digest('hex')
    guidance.line_count = content.split('\n').length
    guidance.byte_length = Buffer.byteLength(content, 'utf8')
    guidance.read_trigger =
      guidance.read_trigger ??
      `Read this guidance before work that ${policy.id} governs.`
  }

  return policy
}

function expandProjection(sourceRoot, projection) {
  const match = /\{([a-z_]+)\}/u.exec(projection.source)

  if (!match) {
    return [
      {
        source: path.join(sourceRoot, projection.source),
        relative: projection.target,
        variable: null,
        generatedFields: projection.generated_fields ?? [],
        transforms: projection.transforms ?? [],
      },
    ]
  }

  const token = match[0]
  const sourceDirectory = path.dirname(projection.source)
  const sourceBasename = path.basename(projection.source)
  const [prefix, suffix] = sourceBasename.split(token)
  const absoluteDirectory = path.join(sourceRoot, sourceDirectory)

  return readdirSync(absoluteDirectory, { withFileTypes: true })
    .filter(
      (entry) =>
        entry.isFile() &&
        entry.name.startsWith(prefix ?? '') &&
        entry.name.endsWith(suffix ?? ''),
    )
    .map((entry) => {
      const variable = entry.name.slice(
        (prefix ?? '').length,
        entry.name.length - (suffix ?? '').length,
      )

      return {
        source: path.join(absoluteDirectory, entry.name),
        relative: projection.target.replace(token, variable),
        variable,
        generatedFields: projection.generated_fields ?? [],
        transforms: projection.transforms ?? [],
      }
    })
}

function cursorSourceFiles(sourceRoot) {
  const manifest = readJson(
    path.join(
      sourceRoot,
      'governance',
      'registries',
      'projection_manifest.json',
    ),
  )

  if (manifest.schema_version !== 2 || !Array.isArray(manifest.projections)) {
    fail('Invalid governance/registries/projection_manifest.json')
  }

  for (const projection of manifest.projections) {
    if (
      !projection ||
      typeof projection.source !== 'string' ||
      projection.source.startsWith('.cursor/') ||
      typeof projection.target !== 'string' ||
      !projection.target.startsWith('.cursor/')
    ) {
      fail(
        'Projection sources MUST be canonical and targets MUST be under .cursor/',
      )
    }
  }

  const expanded = manifest.projections
    .filter(
      (projection) =>
        Array.isArray(projection.installation_modes) &&
        projection.installation_modes.includes('embedded'),
    )
    .flatMap((projection) => expandProjection(sourceRoot, projection))
    .sort((left, right) => left.relative.localeCompare(right.relative))

  // Mirrors the invariant in src/lib/projection.ts: every file installed into a
  // target repository's .cursor/ MUST be pan-namespaced so it can never collide
  // with a target-authored agent, command, or rule.
  for (const entry of expanded) {
    if (!/^pan(-|creator\.)/u.test(path.basename(entry.relative))) {
      fail(
        `Embedded projection targets MUST use a pan-namespaced filename: ${entry.relative}`,
      )
    }
  }

  return expanded
}

/**
 * Read a harness config with the untracked operator-overrides file beside it
 * merged over it. The self-development checkout blanks its model values in
 * the tracked config.json and keeps the real specs in config_overrides.json,
 * so every installer read of a source config MUST see the effective merge.
 */
/**
 * An empty model string in a named config's personas inherits the default
 * for that persona. Drop those placeholders so every `{...defaults,
 * ...personas}` spread below resolves the same way `parsePipelineConfig` does.
 * `defaults` keeps its entries; the parser rejects an empty default.
 */
function stripInheritedPlaceholders(config) {
  if (typeof config !== 'object' || config === null) {
    return config
  }

  for (const [name, namedConfig] of Object.entries(config.configs ?? {})) {
    if (
      typeof namedConfig !== 'object' ||
      namedConfig === null ||
      typeof namedConfig.personas !== 'object' ||
      namedConfig.personas === null
    ) {
      continue
    }

    config.configs[name] = {
      ...namedConfig,
      personas: Object.fromEntries(
        Object.entries(namedConfig.personas).filter(
          ([, model]) => model !== '',
        ),
      ),
    }
  }

  return config
}

function readConfigWithOverrides(configPath) {
  let config = readJson(configPath)

  for (const overridesName of ['config_overrides.json', 'config.local.json']) {
    const overridesPath = path.join(path.dirname(configPath), overridesName)

    if (existsSync(overridesPath)) {
      config = mergeConfigObjects(config, readJson(overridesPath))
      break
    }
  }

  return stripInheritedPlaceholders(config)
}

function personaModelsFromConfig(configPath) {
  const config = readConfigWithOverrides(configPath)
  const active = config.configs?.[config.active_config]
  const defaults =
    typeof config.defaults === 'object' && config.defaults !== null
      ? config.defaults
      : {}

  if (!active || typeof active.personas !== 'object') {
    fail('config.json active config does not define personas')
  }

  return { ...defaults, ...active.personas }
}

function personaModelsForProjection(personaConfigPath, sourceRoot) {
  const sourceConfigPath = path.join(sourceRoot, 'config.json')
  const sourceConfig = readConfigWithOverrides(sourceConfigPath)
  const sourceDefaults =
    typeof sourceConfig.defaults === 'object' && sourceConfig.defaults !== null
      ? sourceConfig.defaults
      : {}

  if (!personaConfigPath) {
    return personaModelsFromConfig(sourceConfigPath)
  }

  const targetConfig = stripInheritedPlaceholders(readJson(personaConfigPath))
  const activeConfigName =
    typeof targetConfig.active_config === 'string'
      ? targetConfig.active_config
      : sourceConfig.active_config
  const sourcePersonas =
    sourceConfig.configs?.[activeConfigName]?.personas ??
    sourceConfig.configs?.[sourceConfig.active_config]?.personas
  const targetDefaults =
    typeof targetConfig.defaults === 'object' && targetConfig.defaults !== null
      ? targetConfig.defaults
      : {}
  const targetPersonas = targetConfig.configs?.[activeConfigName]?.personas

  if (!sourcePersonas || typeof sourcePersonas !== 'object') {
    fail('config.json active config does not define personas')
  }

  const mergedSource = { ...sourceDefaults, ...sourcePersonas }

  if (!targetPersonas || typeof targetPersonas !== 'object') {
    return mergedSource
  }

  return { ...mergedSource, ...targetDefaults, ...targetPersonas }
}

/** Objects merge recursively; any other override value replaces the base. */
function mergeConfigObjects(base, override) {
  if (
    typeof base !== 'object' ||
    base === null ||
    Array.isArray(base) ||
    typeof override !== 'object' ||
    override === null ||
    Array.isArray(override)
  ) {
    return override
  }

  const merged = { ...base }

  for (const [key, value] of Object.entries(override)) {
    merged[key] = mergeConfigObjects(base[key], value)
  }

  return merged
}

/**
 * Keep only the personas the incoming release ships. A retired persona would
 * otherwise survive in a target config forever, because the merge below
 * prefers every existing target value.
 */
function retainShippedPersonas(personas, shipped) {
  if (typeof personas !== 'object' || personas === null || shipped.size === 0) {
    return personas
  }

  return Object.fromEntries(
    Object.entries(personas).filter(([persona]) => shipped.has(persona)),
  )
}

function mergeEmbeddedProjectConfig(source, existing) {
  const shipped = new Set(
    typeof source.defaults === 'object' && source.defaults !== null
      ? Object.keys(source.defaults)
      : [],
  )
  const merged = {
    ...source,
    defaults: {
      ...(typeof source.defaults === 'object' && source.defaults !== null
        ? source.defaults
        : {}),
      ...(typeof existing.defaults === 'object' && existing.defaults !== null
        ? existing.defaults
        : {}),
    },
    configs: { ...(existing.configs ?? {}) },
  }
  const activeConfig =
    typeof existing.active_config === 'string' &&
    existing.configs?.[existing.active_config]
      ? existing.active_config
      : source.active_config

  merged.active_config = activeConfig

  for (const [name, sourceConfig] of Object.entries(source.configs ?? {})) {
    if (typeof sourceConfig !== 'object' || sourceConfig === null) {
      continue
    }

    const existingConfig = merged.configs[name]

    if (!existingConfig || typeof existingConfig !== 'object') {
      merged.configs[name] = sourceConfig
      continue
    }

    merged.configs[name] = {
      ...sourceConfig,
      ...existingConfig,
      personas: {
        ...(typeof sourceConfig.personas === 'object'
          ? sourceConfig.personas
          : {}),
        ...(typeof existingConfig.personas === 'object'
          ? existingConfig.personas
          : {}),
      },
    }
  }

  merged.defaults = retainShippedPersonas(merged.defaults, shipped)

  for (const [name, config] of Object.entries(merged.configs)) {
    if (typeof config !== 'object' || config === null) {
      continue
    }

    merged.configs[name] = {
      ...config,
      personas: retainShippedPersonas(config.personas, shipped),
    }
  }

  return merged
}

const LANGUAGE_BUNDLE_MARKER = 'pancreator-target-language-handbooks'
const LANGUAGE_CODE_PERSONAS = new Set([
  'coder',
  'planner',
  'qa-tester',
  'remediator',
  'remediator-severe',
  'reviewer',
  'spotfixer',
  'verifier',
])

function isGeneratedLanguageRow(row) {
  return (
    row &&
    typeof row === 'object' &&
    row.generated_by === LANGUAGE_BUNDLE_MARKER
  )
}

function validLanguageBundle(existingRoot) {
  const policyPath = path.join(
    existingRoot,
    'governance',
    'policies',
    'LANG-001.json',
  )
  const handbookRoot = path.join(
    existingRoot,
    'governance',
    'handbooks',
    'target',
  )
  const lookupPath = path.join(
    existingRoot,
    'governance',
    'registries',
    'policy_lookup_table.json',
  )

  if (
    !existsSync(policyPath) ||
    !existsSync(handbookRoot) ||
    !existsSync(lookupPath)
  ) {
    return false
  }

  let policy
  let lookup

  try {
    policy = readJson(policyPath)
    lookup = readJson(lookupPath)
  } catch {
    return false
  }

  if (
    policy?.id !== 'LANG-001' ||
    policy?.generated_by !== LANGUAGE_BUNDLE_MARKER ||
    !Array.isArray(policy.guidance_sources) ||
    !Array.isArray(lookup?.rows)
  ) {
    return false
  }

  const sources = policy.guidance_sources
    .map((source) => (typeof source?.path === 'string' ? source.path : null))
    .filter(Boolean)
    .sort()
  const handbooks = readdirSync(handbookRoot, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => {
      const relative = `governance/handbooks/target/${entry.name}/style-guide.md`
      const absolute = path.join(existingRoot, relative)

      return existsSync(absolute) &&
        readFileSync(absolute, 'utf8').includes(
          `<!-- pancreator-target-language-handbook: ${entry.name} -->`,
        )
        ? relative
        : null
    })
    .filter(Boolean)
    .sort()

  if (
    sources.length === 0 ||
    sources.length !== handbooks.length ||
    sources.some((source, index) => source !== handbooks[index])
  ) {
    return false
  }

  const rows = lookup.rows.filter(isGeneratedLanguageRow)
  const expectedPolicies = ['LANG-001']

  if (handbooks.includes('governance/handbooks/target/python/style-guide.md')) {
    expectedPolicies.push('PY-001')
  }

  expectedPolicies.sort()

  const personas = rows
    .filter(
      (row) =>
        Array.isArray(row.policies) &&
        row.policies.length === expectedPolicies.length &&
        [...row.policies].sort().join('\n') === expectedPolicies.join('\n') &&
        typeof row.persona === 'string',
    )
    .map((row) => row.persona)

  return (
    rows.length === LANGUAGE_CODE_PERSONAS.size &&
    personas.length === LANGUAGE_CODE_PERSONAS.size &&
    personas.every((persona) => LANGUAGE_CODE_PERSONAS.has(persona)) &&
    new Set(personas).size === LANGUAGE_CODE_PERSONAS.size
  )
}

function preserveLanguageGovernance() {
  const existingRoot = path.resolve(requiredOption('--existing-root'))
  const stagingRoot = path.resolve(requiredOption('--staging-root'))

  if (!validLanguageBundle(existingRoot)) {
    return
  }

  const existingHandbooks = path.join(
    existingRoot,
    'governance',
    'handbooks',
    'target',
  )
  const stagedHandbooks = path.join(
    stagingRoot,
    'governance',
    'handbooks',
    'target',
  )
  cpSync(existingHandbooks, stagedHandbooks, { recursive: true, force: true })
  copyFileSync(
    path.join(existingRoot, 'governance', 'policies', 'LANG-001.json'),
    path.join(stagingRoot, 'governance', 'policies', 'LANG-001.json'),
  )

  const existingLookup = readJson(
    path.join(
      existingRoot,
      'governance',
      'registries',
      'policy_lookup_table.json',
    ),
  )
  const stagedLookupPath = path.join(
    stagingRoot,
    'governance',
    'registries',
    'policy_lookup_table.json',
  )
  const stagedLookup = readJson(stagedLookupPath)
  const rows = [
    ...stagedLookup.rows.filter((row) => !isGeneratedLanguageRow(row)),
    ...existingLookup.rows.filter(isGeneratedLanguageRow),
  ]

  if (JSON.stringify(stagedLookup.rows) !== JSON.stringify(rows)) {
    stagedLookup.rows = rows
    writeJson(stagedLookupPath, stagedLookup)
  }
}

function migratePolicyExtensions() {
  const stagingRoot = path.resolve(requiredOption('--staging-root'))
  const registryRoot = path.join(stagingRoot, 'governance', 'registries')

  if (!existsSync(registryRoot)) {
    return
  }

  const legacyNames = readdirSync(registryRoot)
    .filter((name) => name.endsWith('_policy_rows.json'))
    .sort()

  for (const name of legacyNames) {
    const sourcePath = path.join(registryRoot, name)
    const source = readJson(sourcePath)
    const rows = Array.isArray(source) ? source : source?.rows

    if (!Array.isArray(rows)) {
      fail(`${name} must contain an array or rows[].`)
    }

    const extensionId = name
      .slice(0, -'_policy_rows.json'.length)
      .replaceAll('_', '-')

    if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/u.test(extensionId)) {
      fail(`${name} cannot produce a valid extension id.`)
    }

    const policies = [
      ...new Set(
        rows.flatMap((row) =>
          row && Array.isArray(row.policies)
            ? row.policies.filter(
                (policy) => typeof policy === 'string' && policy.length > 0,
              )
            : [],
        ),
      ),
    ].sort()

    if (policies.length === 0) {
      fail(`${name} does not contain a policy binding.`)
    }

    const migrated = {
      schema_version: 1,
      extension_id: extensionId,
      policies,
      rows,
    }
    const destination = path.join(
      registryRoot,
      'policy_lookup.d',
      `${extensionId}.json`,
    )

    if (existsSync(destination)) {
      const existing = readJson(destination)

      if (JSON.stringify(existing) !== JSON.stringify(migrated)) {
        fail(`${name} conflicts with policy_lookup.d/${extensionId}.json.`)
      }

      continue
    }

    writeJsonAtomic(destination, migrated)
  }
}

// Build artifacts are machine-generated and env-dependent; hashing them would
// flag every rebuild as a local modification.
const PAYLOAD_MANIFEST_SKIP = new Set(['dist', 'node_modules'])

/**
 * Hash every harness-owned payload file under `rootDir`, sorted by path.
 * Symlinks (the `.cursor` link) are skipped: they point outside the payload.
 */
function listPayloadFiles(rootDir, entries) {
  const files = []

  const walk = (absolute, relative) => {
    const stats = lstatSync(absolute)

    if (stats.isSymbolicLink()) {
      return
    }

    if (stats.isDirectory()) {
      for (const name of readdirSync(absolute)) {
        walk(path.join(absolute, name), `${relative}/${name}`)
      }

      return
    }

    if (stats.isFile()) {
      files.push({ path: relative, sha256: sha256(readFileSync(absolute)) })
    }
  }

  for (const entry of entries) {
    if (PAYLOAD_MANIFEST_SKIP.has(entry)) {
      continue
    }

    const absolute = path.join(rootDir, entry)

    if (existsSync(absolute)) {
      walk(absolute, entry)
    }
  }

  return files.sort((left, right) => left.path.localeCompare(right.path))
}

function previousPayloadManifest(markerPath) {
  if (!markerPath || !existsSync(markerPath)) {
    return new Map()
  }

  const marker = readJson(markerPath)
  const entries = Array.isArray(marker.payload_files)
    ? marker.payload_files
    : []

  return new Map(
    entries
      .filter(
        (entry) =>
          entry &&
          typeof entry.path === 'string' &&
          typeof entry.sha256 === 'string',
      )
      .map((entry) => [entry.path, entry.sha256]),
  )
}

function removeEmptyParents(filePath, rootDir) {
  let directory = path.dirname(filePath)

  while (
    directory !== rootDir &&
    directory.startsWith(`${rootDir}${path.sep}`)
  ) {
    if (readdirSync(directory).length > 0) {
      return
    }

    rmdirSync(directory)
    directory = path.dirname(directory)
  }
}

/**
 * Reconcile the installed payload with the staged release before the payload
 * swap. Local modifications to harness-owned files lose to the Pancreator
 * source but are backed up and flagged; files the harness never shipped are
 * target-specific extensions and are carried into the staged payload so the
 * swap cannot destroy them.
 */
function reconcilePayload() {
  const existingRoot = path.resolve(requiredOption('--existing-root'))
  const stagingRoot = path.resolve(requiredOption('--staging-root'))
  const markerPath = path.resolve(requiredOption('--previous-marker'))
  const backupRoot = path.resolve(requiredOption('--backup-root'))
  const entries = requiredOption('--entries').split(',').filter(Boolean)
  const retiredEntries = (option('--retired-entries') ?? '')
    .split(',')
    .filter(Boolean)
  const manifest = previousPayloadManifest(markerPath)

  if (manifest.size === 0) {
    if (existsSync(markerPath)) {
      process.stdout.write(
        'Installed payload predates local-change tracking: harness-owned ' +
          'files are replaced wholesale this update and tracked from now on. ' +
          'Retired entries remain because their ownership cannot be proven.\n',
      )
    }

    return
  }

  const superseded = []
  const preserved = []
  const restored = []
  const retainedRetired = []
  const removedRetired = []

  const backup = (relative) => {
    const destination = path.join(backupRoot, relative)

    mkdirSync(path.dirname(destination), { recursive: true })
    copyFileSync(path.join(existingRoot, relative), destination)
  }

  for (const entry of listPayloadFiles(existingRoot, entries)) {
    const recordedDigest = manifest.get(entry.path)
    const stagingPath = path.join(stagingRoot, entry.path)
    const stagingDigest = existsSync(stagingPath)
      ? sha256(readFileSync(stagingPath))
      : null

    if (recordedDigest === undefined) {
      // Never shipped by the harness: a target-specific extension, unless the
      // new release now claims the path, in which case the release wins.
      if (stagingDigest === null) {
        mkdirSync(path.dirname(stagingPath), { recursive: true })
        copyFileSync(path.join(existingRoot, entry.path), stagingPath)
        preserved.push(entry.path)
      } else if (stagingDigest !== entry.sha256) {
        backup(entry.path)
        superseded.push(entry.path)
      }

      continue
    }

    // Locally modified since install. When the staged release already carries
    // the same bytes the fix was upstreamed and needs no flag.
    if (recordedDigest !== entry.sha256 && stagingDigest !== entry.sha256) {
      backup(entry.path)
      superseded.push(entry.path)
    }
  }

  for (const entry of listPayloadFiles(existingRoot, retiredEntries)) {
    const recordedDigest = manifest.get(entry.path)

    if (recordedDigest === entry.sha256) {
      const existingPath = path.join(existingRoot, entry.path)

      rmSync(existingPath)
      removeEmptyParents(existingPath, existingRoot)
      removedRetired.push(entry.path)
      continue
    }

    backup(entry.path)
    retainedRetired.push(entry.path)
  }

  for (const relative of manifest.keys()) {
    if (
      !existsSync(path.join(existingRoot, relative)) &&
      existsSync(path.join(stagingRoot, relative))
    ) {
      restored.push(relative)
    }
  }

  const lines = []

  if (superseded.length > 0) {
    lines.push(
      '',
      'Local changes to harness-owned files detected. The Pancreator source is',
      'authoritative; each superseded local version is preserved under',
      `${backupRoot}:`,
      '',
      ...superseded.sort().map((relative) => `  superseded  ${relative}`),
    )
  }

  if (restored.length > 0) {
    lines.push(
      '',
      'Locally deleted harness-owned files restored from the release:',
      '',
      ...restored.sort().map((relative) => `  restored  ${relative}`),
    )
  }

  if (preserved.length > 0) {
    lines.push(
      '',
      'Target-specific extensions preserved through the update:',
      '',
      ...preserved.sort().map((relative) => `  preserved  ${relative}`),
    )
  }

  if (retainedRetired.length > 0) {
    lines.push(
      '',
      'Changed or target-added files under retired payload entries were retained.',
      'Each retained version is also preserved under',
      `${backupRoot}:`,
      '',
      ...retainedRetired.sort().map((relative) => `  retained  ${relative}`),
    )
  }

  if (removedRetired.length > 0) {
    lines.push(
      '',
      'Unmodified release-owned files removed from retired payload entries:',
      '',
      ...removedRetired.sort().map((relative) => `  retired  ${relative}`),
    )
  }

  if (lines.length > 0) {
    process.stdout.write(`${lines.join('\n')}\n\n`)
  }
}

function previousCursorFiles(markerPath) {
  if (!markerPath || !existsSync(markerPath)) {
    return new Map()
  }

  const marker = readJson(markerPath)
  const entries = Array.isArray(marker.cursor_files) ? marker.cursor_files : []

  return new Map(
    entries
      .filter(
        (entry) =>
          entry &&
          typeof entry.path === 'string' &&
          typeof entry.sha256 === 'string',
      )
      .map((entry) => [entry.path, entry.sha256]),
  )
}

function projectCursor() {
  const sourceRoot = path.resolve(requiredOption('--source-root'))
  const targetRoot = path.resolve(requiredOption('--target-root'))
  const manifestOut = path.resolve(requiredOption('--manifest-out'))
  const markerPath = option('--previous-marker')
  const backupRoot = option('--backup-root')
  const previous = previousCursorFiles(markerPath)
  const projected = []
  const backups = []
  const currentPaths = new Set()
  const personaConfigPath = option('--persona-config')
  // Absolute installation root for a detached install; `.pancreator` otherwise.
  const harnessPrefix = option('--harness-prefix') ?? EMBEDDED_HARNESS_PREFIX
  const personaModels = personaModelsForProjection(
    personaConfigPath ? path.resolve(personaConfigPath) : null,
    sourceRoot,
  )

  for (const entry of cursorSourceFiles(sourceRoot)) {
    let content = entry.transforms.includes('policy-rule')
      ? renderPolicyCursorRule(policyRuleSource(sourceRoot, entry.source))
      : readFileSync(entry.source, 'utf8')

    if (entry.generatedFields.includes('frontmatter.model')) {
      const model = personaModels[entry.variable]

      if (typeof model !== 'string' || model.length === 0) {
        fail(`No active model mapping for Cursor persona: ${entry.variable}`)
      }

      // An external-executor persona (e.g. `claude-code:<model>`) has no
      // Cursor subagent, so nothing is projected for it. Skipping here also
      // lets the stale-file sweep below remove a previously projected agent.
      // Kept in sync with the executor handling in `src/lib/projection.ts`.
      const executorMatch = /^([a-z][a-z0-9-]*):/u.exec(model)

      if (executorMatch && executorMatch[1] !== 'cursor') {
        continue
      }

      const projectedModel = executorMatch
        ? model.slice(executorMatch[0].length)
        : model

      if (!content.includes('__PANCREATOR_MODEL__')) {
        fail(`${entry.source} is missing __PANCREATOR_MODEL__`)
      }

      content = content.replaceAll('__PANCREATOR_MODEL__', projectedModel)
    }

    if (entry.transforms.includes('installation-paths')) {
      content = projectCursorContent(content, entry.relative, harnessPrefix)
    }
    const destination = path.join(targetRoot, entry.relative)
    const digest = sha256(content)

    currentPaths.add(entry.relative)

    if (existsSync(destination)) {
      const existing = readFileSync(destination)
      const existingDigest = sha256(existing)
      const previousDigest = previous.get(entry.relative)
      const isOperatorFile = previousDigest === undefined
      const wasModifiedAfterInstall =
        previousDigest !== undefined && previousDigest !== existingDigest

      if (
        existingDigest !== digest &&
        (isOperatorFile || wasModifiedAfterInstall) &&
        backupRoot
      ) {
        const backupPath = path.join(path.resolve(backupRoot), entry.relative)

        mkdirSync(path.dirname(backupPath), { recursive: true })
        copyFileSync(destination, backupPath)
        backups.push(entry.relative)
      }
    }

    mkdirSync(path.dirname(destination), { recursive: true })
    writeFileSync(destination, content)
    projected.push({ path: entry.relative, sha256: digest })
  }

  for (const [relative, previousDigest] of previous) {
    if (currentPaths.has(relative)) {
      continue
    }

    const destination = path.join(targetRoot, relative)

    if (!existsSync(destination)) {
      continue
    }

    const existingDigest = sha256(readFileSync(destination))

    if (existingDigest === previousDigest) {
      rmSync(destination)
    }
  }

  writeJson(manifestOut, { cursor_files: projected, backups })
}

function normalizedCommands(profile) {
  if (!profile || !Array.isArray(profile.commands)) {
    return []
  }

  return profile.commands.map((command) =>
    typeof command === 'string'
      ? command.trim().replace(/\s+/gu, ' ')
      : command,
  )
}

function sameNonEmptyCommands(left, right) {
  const leftCommands = normalizedCommands(left)
  const rightCommands = normalizedCommands(right)

  return (
    leftCommands.length > 0 &&
    leftCommands.length === rightCommands.length &&
    leftCommands.every((command, index) => command === rightCommands[index])
  )
}

function migrateRepositoryChecks() {
  const configPath = path.resolve(requiredOption('--config'))
  const templatePath = path.resolve(requiredOption('--template'))
  const backupRoot = path.resolve(requiredOption('--backup-root'))
  const config = readJson(configPath)
  const template = readJson(templatePath)

  if (
    config.schema_version !== 1 ||
    !config.profiles ||
    typeof config.profiles !== 'object' ||
    template.schema_version !== 1 ||
    !template.profiles ||
    typeof template.profiles !== 'object'
  ) {
    fail(
      'Repository-check configuration migration requires schema_version 1 profile maps',
    )
  }

  const original = `${JSON.stringify(config, null, 2)}\n`
  const notes = []

  for (const [name, profile] of Object.entries(template.profiles)) {
    if (!(name in config.profiles)) {
      config.profiles[name] = profile
      notes.push(`Added missing ${name} repository-check profile.`)
    }
  }

  if (sameNonEmptyCommands(config.profiles.fast, config.profiles.full)) {
    config.profiles.fast = {
      ...(typeof config.profiles.fast?.description === 'string'
        ? { description: config.profiles.fast.description }
        : { description: template.profiles.fast.description }),
      probes: [],
      commands: [],
    }
    notes.push(
      "Disabled fast because it duplicated full. Rebuild target documentation so fast uses the repository's distinct default/primary suite.",
    )
  }

  if (notes.length === 0) {
    return
  }

  const operator =
    config.$operator && typeof config.$operator === 'object'
      ? config.$operator
      : {}
  const priorNotes = Array.isArray(operator.migration_notes)
    ? operator.migration_notes.filter((note) => typeof note === 'string')
    : []

  operator.migration_notes = [...priorNotes, ...notes]
  config.$operator = operator

  mkdirSync(backupRoot, { recursive: true })
  const stamp = new Date()
    .toISOString()
    .replaceAll(':', '-')
    .replaceAll('.', '-')
  const backupPath = path.join(backupRoot, `${stamp}.json`)

  writeFileSync(backupPath, original)
  writeJson(configPath, config)
  process.stdout.write(
    `Migrated repository checks; backup: ${backupPath}\n${notes
      .map((note) => `  - ${note}`)
      .join('\n')}\n`,
  )
}

function writeProject() {
  const source = path.resolve(requiredOption('--source'))
  const destination = path.resolve(requiredOption('--destination'))
  const workspaceId = requiredOption('--workspace-id')
  // An install ships the effective configuration: the source checkout's
  // tracked config.json merged with its untracked operator overrides.
  let config = readConfigWithOverrides(source)

  if (existsSync(destination)) {
    config = mergeEmbeddedProjectConfig(
      config,
      stripInheritedPlaceholders(readJson(destination)),
    )
  }

  // A detached harness has no stable relative path to its target, so the target
  // is recorded absolutely and the mode is distinguished from `embedded`.
  const detachedWorkspace = option('--detached-workspace')

  config.workspace_id = workspaceId
  config.workspace_root = detachedWorkspace
    ? path.resolve(detachedWorkspace)
    : '..'
  config.state_root = 'runtime'
  config.installation_mode = detachedWorkspace ? 'detached' : 'embedded'
  delete config.self_development

  const defaults =
    typeof config.defaults === 'object' && config.defaults !== null
      ? config.defaults
      : {}

  for (const [name, namedConfig] of Object.entries(config.configs ?? {})) {
    if (typeof namedConfig !== 'object' || namedConfig === null) {
      continue
    }

    const personas =
      typeof namedConfig.personas === 'object' && namedConfig.personas !== null
        ? Object.fromEntries(
            Object.entries(namedConfig.personas).filter(
              ([persona, model]) => defaults[persona] !== model,
            ),
          )
        : {}

    config.configs[name] = {
      ...namedConfig,
      personas,
    }
  }

  if (config.$operator?.note) {
    config.$operator.note = config.$operator.note.replaceAll(
      './bin/pan',
      detachedWorkspace
        ? path.join(path.dirname(destination), 'bin', 'pan')
        : `./${EMBEDDED_HARNESS_PREFIX}/bin/pan`,
    )
  }

  writeJson(destination, config)
}

async function configureShellAlias() {
  const distRoot = path.resolve(
    option('--dist-root') ??
      path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'dist'),
  )
  const modulePath = path.join(distRoot, 'src/lib/shell-alias.js')

  if (!existsSync(modulePath)) {
    fail(`Shell alias module is missing: ${modulePath}`)
  }

  const { configureShellAlias: applyShellAlias } = await import(
    pathToFileURL(modulePath).href
  )
  const result = applyShellAlias()

  for (const message of result.messages) {
    process.stdout.write(`${message}\n`)
  }
}

/**
 * Agentic-harness configuration a target repository may already own. Pancreator
 * coexists with all of it: nothing here is read as instruction, modified, or
 * removed by installation. The report exists so the operator knows which other
 * harnesses are live in the repository before running governed workflows.
 */
const FOREIGN_HARNESS_SURFACES = [
  { path: 'AGENTS.md', label: 'Generic agent instructions' },
  { path: 'CLAUDE.md', label: 'Claude Code instructions' },
  { path: '.claude', label: 'Claude Code configuration' },
  { path: '.cursorrules', label: 'Legacy Cursor rules' },
  { path: '.cursorignore', label: 'Cursor ignore rules' },
  { path: '.cursor/mcp.json', label: 'Cursor MCP servers' },
  { path: '.mcp.json', label: 'Project MCP servers' },
  { path: '.github/copilot-instructions.md', label: 'GitHub Copilot' },
  { path: '.windsurfrules', label: 'Windsurf rules' },
  { path: '.windsurf', label: 'Windsurf configuration' },
  { path: '.clinerules', label: 'Cline rules' },
  { path: '.roo', label: 'Roo Code configuration' },
  { path: '.kilocode', label: 'Kilo Code configuration' },
  { path: '.continue', label: 'Continue configuration' },
  { path: '.aider.conf.yml', label: 'Aider configuration' },
  { path: '.junie/guidelines.md', label: 'JetBrains Junie' },
  { path: '.gemini', label: 'Gemini CLI configuration' },
  { path: '.codex', label: 'Codex configuration' },
  { path: '.opencode', label: 'OpenCode configuration' },
  { path: '.amazonq', label: 'Amazon Q configuration' },
  { path: '.zed', label: 'Zed configuration' },
  { path: '.trae', label: 'Trae configuration' },
]

/** Target-owned `.cursor/` entries that Pancreator does not project. */
function foreignCursorEntries(targetRoot) {
  const found = []

  for (const group of ['agents', 'commands', 'rules']) {
    const directory = path.join(targetRoot, '.cursor', group)

    if (!existsSync(directory)) {
      continue
    }

    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      if (!entry.isFile() || /^pan(-|creator\.)/u.test(entry.name)) {
        continue
      }

      found.push(`.cursor/${group}/${entry.name}`)
    }
  }

  return found.sort()
}

function stripHarnessTestScripts() {
  const packagePath = path.resolve(requiredOption('--package'))
  const value = readJson(packagePath)

  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    fail(`${packagePath} MUST contain a package object.`)
  }

  if (
    typeof value.scripts !== 'object' ||
    value.scripts === null ||
    Array.isArray(value.scripts)
  ) {
    fail(`${packagePath} MUST contain a scripts object.`)
  }

  const scripts = { ...value.scripts }

  for (const name of Object.keys(scripts)) {
    if (name === 'test' || name.startsWith('test:')) {
      delete scripts[name]
    }
  }

  writeJson(packagePath, { ...value, scripts })
}

function detectExistingHarness() {
  const targetRoot = path.resolve(requiredOption('--target-root'))
  const sourceRoot = path.resolve(requiredOption('--source-root'))
  const previousMarker = option('--previous-marker')
  const installationMode = option('--installation-mode') ?? 'embedded'

  const detected = FOREIGN_HARNESS_SURFACES.filter((surface) =>
    existsSync(path.join(targetRoot, surface.path)),
  )
  const cursorEntries = foreignCursorEntries(targetRoot)

  // A collision is a Pancreator-owned projection target that already exists and
  // is not recorded as Pancreator-installed. Namespacing makes this rare; when
  // it happens the operator MUST be told which file is being taken over.
  const previous = previousCursorFiles(previousMarker)
  const collisions = cursorSourceFiles(sourceRoot)
    .map((entry) => entry.relative)
    .filter(
      (relative) =>
        !previous.has(relative) && existsSync(path.join(targetRoot, relative)),
    )
    .sort()

  if (detected.length === 0 && cursorEntries.length === 0) {
    return
  }

  const lines = [
    '',
    'Existing agentic harness configuration detected in the target repository.',
    'Pancreator installs alongside it and does not modify or remove it.',
    'Pancreator-owned Cursor files are namespaced `pan-*`.',
    '',
  ]

  if (installationMode === 'detached') {
    lines.push(
      'Detached installation: applicable target instruction surfaces remain live target authority for target application work.',
      'Hard conflicts between target policy and Pancreator defaults fall back to the target.',
      'Pancreator retains authority for harness runtime/state and operator-owned source-control actions.',
      '',
    )
  } else {
    lines.push(
      'Embedded installation: applicable target instruction surfaces remain live target authority for target application work.',
      'Hard conflicts between target policy and Pancreator defaults fall back to the target.',
      '',
    )
  }

  for (const surface of detected) {
    lines.push(`  retained  ${surface.path}  (${surface.label})`)
  }

  for (const relative of cursorEntries) {
    lines.push(`  retained  ${relative}  (target-owned Cursor file)`)
  }

  if (collisions.length > 0) {
    lines.push(
      '',
      'The following target files use Pancreator-owned names and WILL be replaced.',
      'Each is backed up under .pancreator/backups/cursor/ before it is written:',
      '',
    )

    for (const relative of collisions) {
      lines.push(`  replaced  ${relative}`)
    }
  }

  process.stdout.write(`${lines.join('\n')}\n\n`)
}

/**
 * Hash a pristine staged payload into a manifest file. Recorded before any
 * target-specific seeding so the manifest describes release-owned content
 * only: files absent from it are target extensions on every later update.
 */
function hashPayload() {
  const rootDir = path.resolve(requiredOption('--root'))
  const entries = requiredOption('--entries').split(',').filter(Boolean)
  const out = path.resolve(requiredOption('--out'))

  writeJson(out, { payload_files: listPayloadFiles(rootDir, entries) })
}

function writeMarker() {
  const destination = path.resolve(requiredOption('--destination'))
  const cursorManifest = readJson(
    path.resolve(requiredOption('--cursor-manifest')),
  )
  const payloadManifest = readJson(
    path.resolve(requiredOption('--payload-manifest')),
  )
  const payloadEntries = requiredOption('--payload-entries')
    .split(',')
    .filter(Boolean)

  writeJson(destination, {
    schema_version: 4,
    version: requiredOption('--version'),
    source_commit: requiredOption('--source-commit'),
    source_dirty: requiredOption('--source-dirty') === 'true',
    source_indexed: requiredOption('--source-indexed') === 'true',
    installed_at: requiredOption('--installed-at'),
    payload_entries: payloadEntries,
    payload_files: payloadManifest.payload_files,
    cursor_files: cursorManifest.cursor_files,
  })
}

const command = process.argv[2]

if (command === 'project-cursor') {
  projectCursor()
} else if (command === 'write-project') {
  writeProject()
} else if (command === 'detect-existing-harness') {
  detectExistingHarness()
} else if (command === 'write-marker') {
  writeMarker()
} else if (command === 'migrate-repository-checks') {
  migrateRepositoryChecks()
} else if (command === 'preserve-language-governance') {
  preserveLanguageGovernance()
} else if (command === 'migrate-policy-extensions') {
  migratePolicyExtensions()
} else if (command === 'reconcile-payload') {
  reconcilePayload()
} else if (command === 'hash-payload') {
  hashPayload()
} else if (command === 'configure-shell-alias') {
  await configureShellAlias()
} else if (command === 'strip-harness-test-scripts') {
  stripHarnessTestScripts()
} else {
  fail(`Unknown install support command: ${command ?? '(missing)'}`)
}

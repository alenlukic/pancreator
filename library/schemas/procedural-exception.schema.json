{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Procedural exception input (accountability only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_id",
    "affected",
    "classification",
    "observed_defect",
    "evidence",
    "workaround",
    "justification",
    "preserved_constraints"
  ],
  "anyOf": [
    { "required": ["outcome"] },
    { "required": ["required_follow_up"] }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "client_id": { "type": "string", "minLength": 1 },
    "affected": { "type": "string", "minLength": 1 },
    "classification": {
      "enum": ["harness_defect", "procedural_exception", "product_failure"]
    },
    "observed_defect": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "workaround": { "type": "string", "minLength": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "preserved_constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "outcome": { "type": "string", "minLength": 1 },
    "required_follow_up": { "type": "string", "minLength": 1 }
  }
}

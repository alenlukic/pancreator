{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pancreator://config/v1",
  "title": "Pancreator harness configuration",
  "description": "Workspace identity, state root, tracking patterns, and named persona-to-model mappings for a Pancreator workspace.",
  "type": "object",
  "required": ["schema_version"],
  "$defs": {
    "modelSpec": {
      "type": "string",
      "minLength": 1,
      "description": "A model spec, optionally prefixed with one of the closed persona-executor set: cursor, claude-code, openai. An absent prefix means cursor.",
      "pattern": "^((cursor|claude-code|openai):)?[^:]+$"
    },
    "modelAlias": {
      "type": "string",
      "pattern": "^(anthropic|oai|open|cursor):(balanced|advanced|ultra)$"
    },
    "modelSpecOrAlias": {
      "anyOf": [
        { "$ref": "#/$defs/modelSpec" },
        { "$ref": "#/$defs/modelAlias" }
      ]
    },
    "inheritableMapping": {
      "anyOf": [{ "const": "" }, { "$ref": "#/$defs/modelSpecOrAlias" }]
    },
    "aliasValue": {
      "description": "A tier alias resolves to a Cursor model spec. An external executor prefix is refused here so an alias family never changes which runtime executes a persona.",
      "allOf": [
        { "$ref": "#/$defs/modelSpec" },
        { "not": { "pattern": "^claude-code:" } },
        { "not": { "pattern": "^openai:" } },
        {
          "not": {
            "pattern": "^(anthropic|oai|open|cursor):(balanced|advanced|ultra)$"
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "state_root": {
      "type": "string",
      "minLength": 1
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "installations": {
      "type": "array",
      "description": "Operator-declared Pancreator installation roots on this machine. Values belong in config_overrides.json.",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/",
            "description": "Absolute path to the installation root. The loader rejects a relative path."
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "description": "Retention windows in days for harness-owned ephemeral artifact classes.",
      "additionalProperties": false,
      "properties": {
        "default_days": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "classes": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "fast_wall": {
      "type": "object",
      "description": "Optional soft fast-lane wall advisory. The permitted value rises by weekly_allowance_ms for each complete elapsed week after anchor_date; only qualified harness-gate samples under the configured normalized host-load threshold contribute. A target installation ships ceiling_ms as null, and its first passing harness fast baseline sets it with a cushion.",
      "required": [
        "ceiling_ms",
        "anchor_date",
        "weekly_allowance_ms",
        "max_load_average_per_cpu",
        "minimum_qualified_samples"
      ],
      "additionalProperties": false,
      "properties": {
        "ceiling_ms": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Base rolling 24-hour fast-lane wall ceiling in milliseconds, or null until a measured baseline sets it."
        },
        "calibrated_at": {
          "type": "string",
          "format": "date-time",
          "description": "When a measured harness fast baseline set ceiling_ms on this installation. A refresh keeps only a calibrated ceiling."
        },
        "anchor_date": {
          "type": "string",
          "format": "date",
          "description": "UTC date from which complete elapsed weeks are counted."
        },
        "weekly_allowance_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum permitted ceiling increase per complete elapsed week, in milliseconds."
        },
        "max_load_average_per_cpu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum qualifying one-minute load average divided by the host's logical CPU count."
        },
        "minimum_qualified_samples": {
          "type": "integer",
          "minimum": 1,
          "description": "Qualified samples required before the advisory reports a pass or failure verdict."
        }
      }
    },
    "test_scratch": {
      "type": "object",
      "description": "Self-development test scratch location. bin/run-tests and tests/temp.ts place each checkout's fixtures in its own <checkout-name>-<hash>.noindex child of root, so the main checkout and its worktrees never share one. Absent, fixtures stay under runtime/tmp/tests.noindex.",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Directory that holds every checkout's scratch. A leading ~/ expands to the home directory, and a relative path resolves against the checkout. null restores the default, so config_overrides.json can undo a checked-in value."
        }
      }
    },
    "active_config": {
      "type": "string",
      "minLength": 1
    },
    "anthropic": {
      "type": "object",
      "description": "Model alias definitions for the Anthropic family. Keys are optional.",
      "additionalProperties": false,
      "properties": {
        "balanced": { "$ref": "#/$defs/aliasValue" },
        "advanced": { "$ref": "#/$defs/aliasValue" },
        "ultra": { "$ref": "#/$defs/aliasValue" }
      }
    },
    "oai": {
      "type": "object",
      "description": "Model alias definitions for the OpenAI family. Keys are optional.",
      "additionalProperties": false,
      "properties": {
        "balanced": { "$ref": "#/$defs/aliasValue" },
        "advanced": { "$ref": "#/$defs/aliasValue" },
        "ultra": { "$ref": "#/$defs/aliasValue" }
      }
    },
    "open": {
      "type": "object",
      "description": "Model alias definitions for open-source model providers. Keys are optional.",
      "additionalProperties": false,
      "properties": {
        "balanced": { "$ref": "#/$defs/aliasValue" },
        "advanced": { "$ref": "#/$defs/aliasValue" },
        "ultra": { "$ref": "#/$defs/aliasValue" }
      }
    },
    "cursor": {
      "type": "object",
      "description": "Model alias definitions for Cursor-managed providers. Keys are optional.",
      "additionalProperties": false,
      "properties": {
        "balanced": { "$ref": "#/$defs/aliasValue" },
        "advanced": { "$ref": "#/$defs/aliasValue" },
        "ultra": { "$ref": "#/$defs/aliasValue" }
      }
    },
    "defaults": {
      "type": "object",
      "description": "Persona-to-model mappings every named config inherits. A mapping MAY carry an executor prefix from the closed set (cursor, claude-code, openai); no prefix means cursor. A mapping MAY also reference a tier alias (for example anthropic:balanced).",
      "additionalProperties": { "$ref": "#/$defs/modelSpecOrAlias" }
    },
    "$operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "configs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "personas": {
            "type": "object",
            "description": "Legacy compatibility input: nested persona-to-model mappings. Installations and overrides MAY still supply this shape. The canonical shape flattens these mappings directly under the named config object.",
            "additionalProperties": { "$ref": "#/$defs/inheritableMapping" }
          }
        },
        "additionalProperties": { "$ref": "#/$defs/inheritableMapping" }
      }
    },
    "operator_involvement": {
      "type": "object",
      "description": "Named profiles declaring how heavily the operator gates each workflow stage. Optional: an installation without this block behaves as the built-in 'standard' profile. A run resolves one profile at init and snapshots the result, so later edits never change an in-flight run.",
      "required": ["active", "profiles"],
      "additionalProperties": false,
      "properties": {
        "$operator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "active": {
          "type": "string",
          "minLength": 1,
          "description": "Profile used when `pan init` omits --involvement. Must name a key in profiles."
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["summary"],
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "gates": {
                "type": "object",
                "description": "Stage slug to gate assignment. The '*' key applies to every stage; an explicit slug overrides it. A stage declaring gate_relaxable: false rejects any assignment that lowers operator involvement.",
                "propertyNames": {
                  "pattern": "^(\\*|[a-z0-9-]+)$"
                },
                "additionalProperties": {
                  "enum": [
                    "operator",
                    "supervisor",
                    "next_stage",
                    "stage_verdict"
                  ]
                }
              },
              "contracts": {
                "type": "array",
                "uniqueItems": true,
                "description": "Run-wide contracts every stage of the run abides by. technical_director escalates the technical_plan and independent_review checkpoints to operator gates and requires interactive refinement. long_horizon selects the long-horizon policy set and arms away mode for the run.",
                "items": {
                  "enum": ["technical_director", "long_horizon"]
                }
              },
              "away_mode": {
                "type": "object",
                "required": ["enabled"],
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean" },
                  "guardrails": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "allowed_actions": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "approve",
                            "reject",
                            "revise",
                            "resume",
                            "set-stage",
                            "waive-gate"
                          ]
                        }
                      },
                      "max_decisions_per_run": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "max_remediation_attempts_per_agent": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "description": "Calendar jobs evaluated by pan schedule tick. The shipped configuration is disabled.",
      "required": ["enabled", "jobs"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "catch_up_window_minutes": {
          "type": "integer",
          "minimum": 0,
          "default": 360
        },
        "grace_period_minutes": {
          "type": "integer",
          "minimum": 0,
          "default": 60
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "enabled", "hour", "minute", "action"],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": ["workspace"],
                "not": { "required": ["worktree"] }
              },
              { "required": ["worktree"], "not": { "required": ["workspace"] } }
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "enabled": { "type": "boolean" },
              "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
              "minute": { "type": "integer", "minimum": 0, "maximum": 59 },
              "weekdays": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 0, "maximum": 6 }
              },
              "timezone": { "type": "string", "minLength": 1 },
              "catch_up_window_minutes": { "type": "integer", "minimum": 0 },
              "grace_period_minutes": { "type": "integer", "minimum": 0 },
              "workspace": { "type": "string", "minLength": 1 },
              "worktree": { "type": "string", "minLength": 1 },
              "action": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["kind", "command"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "const": "command" },
                      "command": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["kind", "workflow", "request_path"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "const": "workflow" },
                      "workflow": { "type": "string", "minLength": 1 },
                      "request_path": { "type": "string", "minLength": 1 },
                      "involvement": { "type": "string", "minLength": 1 },
                      "verification": { "type": "string", "minLength": 1 },
                      "pipeline_config": {
                        "type": "string",
                        "minLength": 1
                      },
                      "attest_supervisor_card": { "type": "boolean" }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["kind", "queue_path"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "const": "session" },
                      "queue_path": { "type": "string", "minLength": 1 },
                      "involvement": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["kind", "prompt"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "const": "prompt" },
                      "prompt": { "type": "string", "minLength": 1 },
                      "workflow": { "type": "string", "minLength": 1 },
                      "involvement": { "type": "string", "minLength": 1 },
                      "verification": { "type": "string", "minLength": 1 },
                      "pipeline_config": {
                        "type": "string",
                        "minLength": 1
                      },
                      "attest_supervisor_card": { "type": "boolean" }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "installation_mode": {
      "description": "self_development is the Pancreator source checkout. embedded installs the harness at <target>/.pancreator. detached installs it outside the target tree, requiring an absolute workspace_root.",
      "enum": ["self_development", "embedded", "detached"]
    },
    "worktrees": {
      "type": "object",
      "description": "Defaults for operator worktrees created by `pan worktree create` and `pan init --worktree`. Every field is optional. New worktrees use their exact names as branches. The code defaults to worktrees/operator and no setup commands.",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Installation-relative directory that holds operator worktrees and their index.json."
        },
        "branch_prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$",
          "description": "Deprecated compatibility input. Existing indexed branches keep their recorded names. New worktree branches ignore this value and use the exact worktree name."
        },
        "setup": {
          "type": "array",
          "description": "Shell commands run inside a new worktree, in order, immediately after creation.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

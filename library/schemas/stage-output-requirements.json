    "approach": {
      "validators": [
        {
          "registry_id": "PROTOTYPE-OUTPUT-VALIDATE-001",
          "enforcement": "blocks",
          "enforced_fields": [
            "data.technical_approach.preconditions[].exclusions[]",
            "data.technical_approach.preconditions[].exclusions[].excluded_questions[]",
            "data.technical_approach.preconditions[].exclusions[].operator_decision_path",
            "data.technical_approach",
            "data.technical_approach.preconditions[]",
            "data.technical_approach.preconditions[].id",
            "data.technical_approach.preconditions[].affected_questions[]",
            "data.technical_approach.preconditions[].check",
            "data.technical_approach.preconditions[].status",
            "data.technical_approach.preconditions[].evidence[]",
            "data.technical_approach.preconditions[].volatile"
          ]
        }
      ],
      "fields": [
        {
          "path": "data.technical_approach",
          "type": "object",
          "format": "required; the technical approach the spike will build against"
        },
        {
          "path": "data.technical_approach.preconditions[]",
          "type": "object",
          "required": [
            "id",
            "affected_questions",
            "check",
            "status",
            "evidence",
            "volatile"
          ],
          "format": "one entry per precondition the approach depends on"
        },
        {
          "path": "data.technical_approach.preconditions[].id",
          "type": "string",
          "format": "non-empty; the id a build precondition check cites"
        },
        {
          "path": "data.technical_approach.preconditions[].affected_questions[]",
          "type": "string",
          "format": "non-empty array of declared technical question ids the precondition affects"
        },
        {
          "path": "data.technical_approach.preconditions[].check",
          "type": "string",
          "format": "non-empty; how the precondition was checked"
        },
        {
          "path": "data.technical_approach.preconditions[].evidence[]",
          "type": "string",
          "format": "non-empty array of paths, commands, or observations for the check"
        },
        {
          "path": "data.technical_approach.preconditions[].status",
          "type": "string",
          "enum": ["ready", "unavailable", "unknown"]
        },
        {
          "path": "data.technical_approach.preconditions[].volatile",
          "type": "boolean",
          "format": "required on every precondition; true when the build MUST recheck it immediately before source edits"
        },
        {
          "path": "data.technical_approach.preconditions[].exclusions[]",
          "type": "object",
          "required": ["excluded_questions", "operator_decision_path"],
          "format": "optional; each entry cites one operator decision recorded on this run that excludes the listed questions"
        },
        {
          "path": "data.technical_approach.preconditions[].exclusions[].excluded_questions[]",
          "type": "string",
          "format": "technical question id the operator decision excludes; the decision note MUST name it"
        },
        {
          "path": "data.technical_approach.preconditions[].exclusions[].operator_decision_path",
          "type": "string",
          "format": "path of an operator decision on the run's operator-feedback ledger; a harness pause record does not qualify"
        }
      ]
    },

{
  "schema_version": 1,
  "policy_id": "CONTRACT-001",
  "validator_id": "FIELD-CONTRACT-VALIDATE-001",
  "criterion_results": {
    "unevaluated": "Scaffold-only. The harness writes this value and submission rejects it.",
    "skipped": "Terminal non-success. Permitted on a blocked output or on a shell criterion when the stage already failed. Forbidden on success.",
    "not_applicable": "Worker judgment that a criterion does not apply. Hard criteria MUST NOT use it."
  },
  "stages": {
    "plan": {
      "validators": [
        {
          "registry_id": "PLAN-TRACE-VALIDATE-001",
          "enforcement": "blocks",
          "enforced_fields": [
            "data.acceptance_criteria[].id",
            "data.acceptance_criteria[].maps_to",
            "data.acceptance_criteria[].verification",
            "data.acceptance_criteria[].verification.method",
            "data.acceptance_criteria[].verification.expected",
            "data.engineering_plan.files[]",
            "data.engineering_plan.files[].path",
            "data.engineering_plan.files[].status",
            "data.engineering_plan.files[].purpose",
            "data.test_plan[]",
            "data.open_question_dispositions[].id",
            "data.open_question_dispositions[].answer",
            "data.open_question_dispositions[].disposition",
            "data.open_question_dispositions[].evidence",
            "data.verification_recommendation",
            "data.verification_recommendation.level",
            "data.verification_recommendation.reason"
          ]
        }
      ],
      "fields": [
        {
          "path": "data.design_plan",
          "type": "object",
          "format": "required only for a design-composed planning run; names where design planning and verification execute"
        },
        {
          "path": "data.design_plan.planning_stage",
          "type": "string"
        },
        {
          "path": "data.design_plan.verification_stage",
          "type": "string"
        },
        {
          "path": "data.design_plan.evidence_roles",
          "type": "array",
          "format": "string array of design evidence-worker roles"
        },
        {
          "path": "data.acceptance_criteria[].id",
          "type": "string"
        },
        {
          "path": "data.acceptance_criteria[].maps_to",
          "type": "array",
          "format": "string array of user-story ids (US-*), constraint ids (C-*), out-of-scope ids (OOS-*), or related registry ids; C-* and OOS-* ids must be defined by the same product specification"
        },
        {
          "path": "data.acceptance_criteria[].verification",
          "type": "object",
          "required": ["method", "expected"],
          "format": "verification method and expected outcome for the criterion"
        },
        {
          "path": "data.acceptance_criteria[].verification.method",
          "type": "string"
        },
        {
          "path": "data.acceptance_criteria[].verification.expected",
          "type": "string"
        },
        {
          "path": "data.engineering_plan.files[]",
          "type": "object",
          "required": ["path", "status", "purpose"],
          "format": "each planned file with path, status (new or modified), and purpose"
        },
        {
          "path": "data.engineering_plan.files[].path",
          "type": "string"
        },
        {
          "path": "data.engineering_plan.files[].status",
          "type": "string",
          "enum": ["new", "modified"]
        },
        {
          "path": "data.engineering_plan.files[].purpose",
          "type": "string"
        },
        {
          "path": "data.test_plan[]",
          "type": "object",
          "format": "focused scenario; setup, action, command, and steps MUST NOT contain a configured repository-check profile command or 'pan repository-check <profile>', because the gate runs that profile once"
        },
        {
          "path": "data.open_question_dispositions[].id",
          "type": "string"
        },
        {
          "path": "data.open_question_dispositions[].answer",
          "type": "string"
        },
        {
          "path": "data.open_question_dispositions[].disposition",
          "type": "string",
          "enum": ["resolved", "deferred", "escalated"]
        },
        {
          "path": "data.open_question_dispositions[].evidence",
          "type": "array",
          "format": "string array of paths or observations supporting the disposition"
        },
        {
          "path": "data.verification_recommendation",
          "type": "object",
          "required": ["level", "reason"],
          "format": "optional recommendation for the operator to change the run verification level"
        },
        {
          "path": "data.verification_recommendation.level",
          "type": "string"
        },
        {
          "path": "data.verification_recommendation.reason",
          "type": "string"
        }
      ]
    },
    "implement": {
      "validators": [
        {
          "registry_id": "IMPLEMENTATION-CLAIMS-VALIDATE-001",
          "enforcement": "blocks",
          "enforced_fields": [
            "data.acceptance_results[].evidence[]",
            "data.implementation.changed_files[]",
            "data.implementation.tests_added[]",
            "data.implementation.tests_added[].path",
            "data.implementation.tests_added[].contract",
            "data.implementation.remediation[]",
            "data.implementation.remediation[].cause",
            "data.implementation.remediation[].action",
            "data.implementation.remediation[].evidence[]",
            "data.acceptance_results[]",
            "data.acceptance_results[].id",
            "data.acceptance_results[].result",
            "data.implementation",
            "data.blocked",
            "data.blocked.missing_precondition",
            "data.blocked.supplying_command",
            "data.blocked.evidence[]"
          ]
        }
      ],
      "fields": [
        {
          "path": "data.acceptance_results[]",
          "type": "object",
          "required": ["id", "result", "evidence"],
          "format": "one result per ratified acceptance criterion; id names the criterion, result uses the shared criterion-result vocabulary, and evidence is non-empty"
        },
        {
          "path": "data.acceptance_results[].id",
          "type": "string",
          "format": "acceptance criterion id the ratified plan declares"
        },
        {
          "path": "data.acceptance_results[].result",
          "type": "string",
          "format": "non-empty; the criterion outcome this stage observed"
        },
        {
          "path": "data.acceptance_results[].evidence[]",
          "type": "string",
          "format": "path reference, prose observation, or pytest node id",
          "accepted_shapes": [
            "path_reference",
            "prose_observation",
            "pytest_node_id"
          ]
        },
        {
          "path": "data.implementation",
          "type": "object",
          "format": "required unless the top-level result is blocked; the stage's required data names the complete child set"
        },
        {
          "path": "data.implementation.changed_files[]",
          "type": "string",
          "format": "workspace-relative path of a file the stage changed; every entry MUST be a string, MUST exist, and MUST appear in the workspace diff"
        },
        {
          "path": "data.implementation.tests_added[]",
          "type": "object",
          "required": ["path", "contract"],
          "format": "{ path, contract }: path is '<test file path>' optionally followed by '::<test case>' (pytest node ids and the spaced ' :: ' display form both resolve) and the file portion must exist, e.g. 'tests/unit/example.test.ts::adds provenance rows'; contract is one non-empty sentence naming the behavior the test proves. Every new test file and every changed test file with a net-positive test(/it( count MUST have an entry with a contract. A bare string still parses as { path } and fails only when that delta requires a contract. A change that adds no tests needs no entry."
        },
        {
          "path": "data.implementation.tests_added[].path",
          "type": "string",
          "format": "'<test file path>' optionally followed by '::<test case>'; the file portion MUST exist"
        },
        {
          "path": "data.implementation.tests_added[].contract",
          "type": "string",
          "format": "one non-empty sentence naming the behavior the test proves"
        },
        {
          "path": "data.implementation.remediation[]",
          "type": "object",
          "required": ["cause", "action", "evidence"],
          "format": "required on attempt 2+; cause and action are non-empty strings, evidence is a non-empty string array"
        },
        {
          "path": "data.implementation.remediation[].cause",
          "type": "string",
          "format": "non-empty; the cause of the prior failure or loop"
        },
        {
          "path": "data.implementation.remediation[].action",
          "type": "string",
          "format": "non-empty; the action taken against that cause"
        },
        {
          "path": "data.implementation.remediation[].evidence[]",
          "type": "string",
          "format": "non-empty string array of paths, commands, or observations proving the remediation"
        },
        {
          "path": "data.blocked",
          "type": "object",
          "required": ["missing_precondition", "supplying_command", "evidence"],
          "format": "required when the top-level result is blocked, and forbidden otherwise"
        },
        {
          "path": "data.blocked.missing_precondition",
          "type": "string",
          "format": "required when top-level result is blocked; states the precondition implementation could not obtain"
        },
        {
          "path": "data.blocked.supplying_command",
          "type": "string",
          "format": "required when top-level result is blocked; the command or action that would supply the precondition"
        },
        {
          "path": "data.blocked.evidence[]",
          "type": "string",
          "format": "required when top-level result is blocked; non-empty string array of paths, commands, or observations proving the gap. Edits made before blocking are disclosed in top-level workspace_changes.paths, which the claims validator reconciles against the Git delta because data.implementation is forbidden on a blocked result."
        }
      ]
    },
    "verify": {
      "validators": [
        {
          "registry_id": "VERIFY-VALIDATE-001",
          "enforcement": "blocks",
          "enforced_fields": [
            "data.verify.verdict",
            "data.verify.findings[].id",
            "data.verify.findings[].severity",
            "data.verify.findings[].source",
            "data.verify.findings[].statement",
            "data.verify.findings[].evidence[]",
            "data.verify.qa_cases[].id",
            "data.verify.qa_cases[].steps",
            "data.verify.qa_cases[].expected",
            "data.verify.qa_cases[].actual",
            "data.verify.qa_cases[].result",
            "data.verify.qa_cases[].carried_from",
            "data.verify.qa_cases[].carried_from.invocation_id",
            "data.verify.qa_cases[].carried_from.workspace_fingerprint",
            "data.verify.acceptance_results[].id",
            "data.verify.acceptance_results[].result",
            "data.verify.gate_evidence_citations[]",
            "data.verify.gate_evidence_citations[].profile",
            "data.verify.gate_evidence_citations[].fingerprint",
            "data.verify.gate_evidence_citations[].evidence_path",
            "data.verify.remediation_guidance",
            "data.verify.severity_rationale",
            "data.verify.blocking_reason",
            "data.verify.missing_evidence_paths"
          ]
        }
      ],
      "fields": [
        {
          "path": "data.verify.verdict",
          "type": "string",
          "enum": ["pass", "pass_with_warnings", "fail_remedial", "fail_severe"]
        },
        {
          "path": "data.verify.findings[].id",
          "type": "string",
          "format": "non-empty stable finding identifier"
        },
        {
          "path": "data.verify.findings[].severity",
          "type": "string",
          "enum": ["blocker", "high", "medium", "low"]
        },
        {
          "path": "data.verify.findings[].source",
          "type": "string",
          "enum": ["review", "qa", "design-review", "design-qa"],
          "format": "names the evidence worker the finding came from; 'design-review' and 'design-qa' are available only on a design-composed verify stage that runs those workers"
        },
        {
          "path": "data.verify.findings[].statement",
          "type": "string",
          "format": "one non-empty sentence stating the finding"
        },
        {
          "path": "data.verify.findings[].evidence[]",
          "type": "string",
          "format": "non-empty string array of paths, commands, or observations proving the finding"
        },
        {
          "path": "data.verify.qa_cases[].id",
          "type": "string",
          "format": "non-empty stable QA case identifier"
        },
        {
          "path": "data.verify.qa_cases[].expected",
          "type": "string"
        },
        {
          "path": "data.verify.qa_cases[].actual",
          "type": "string"
        },
        {
          "path": "data.verify.qa_cases[].result",
          "type": "string",
          "enum": ["pass", "fail", "blocked"]
        },
        {
          "path": "data.verify.qa_cases[].steps",
          "type": "string",
          "format": "focused scenario steps; MUST NOT contain a configured repository-check profile command or 'pan repository-check <profile>', because the gate already ran that profile"
        },
        {
          "path": "data.verify.qa_cases[].carried_from",
          "type": "object",
          "required": ["invocation_id", "workspace_fingerprint"],
          "format": "optional; present only when the case result is carried from an earlier verification instead of executed again. A returning verification executes the cases in the remediation's blast radius and carries the rest with this citation"
        },
        {
          "path": "data.verify.qa_cases[].carried_from.invocation_id",
          "type": "string",
          "format": "invocation id of the verification the carried result was recorded by"
        },
        {
          "path": "data.verify.qa_cases[].carried_from.workspace_fingerprint",
          "type": "string",
          "format": "workspace fingerprint the carried result was observed at"
        },
        {
          "path": "data.verify.acceptance_results[].id",
          "type": "string",
          "format": "acceptance criterion id the ratified plan defines"
        },
        {
          "path": "data.verify.acceptance_results[].result",
          "type": "string",
          "format": "non-empty result for the criterion, such as pass or fail"
        },
        {
          "path": "data.verify.gate_evidence_citations[]",
          "type": "object",
          "required": ["profile", "fingerprint", "evidence_path"],
          "format": "one entry per current gate-evidence reference on the card; cites the profile, the workspace fingerprint it passed at, and the evidence path instead of re-executing the profile"
        },
        {
          "path": "data.verify.gate_evidence_citations[].profile",
          "type": "string",
          "format": "repository-check profile name the gate ran"
        },
        {
          "path": "data.verify.gate_evidence_citations[].fingerprint",
          "type": "string",
          "format": "workspace fingerprint named by the card's gate-evidence reference"
        },
        {
          "path": "data.verify.gate_evidence_citations[].evidence_path",
          "type": "string",
          "format": "harness-relative path of the gate evidence artifact"
        },
        {
          "path": "data.verify.remediation_guidance",
          "type": "string",
          "format": "required when verdict is fail_remedial or fail_severe; reproducible remediation steps"
        },
        {
          "path": "data.verify.severity_rationale",
          "type": "string",
          "format": "required when verdict is fail_severe; explains why the failure is fundamental"
        },
        {
          "path": "data.verify.blocking_reason",
          "type": "string",
          "format": "required when top-level result is blocked; states why verification cannot proceed"
        },
        {
          "path": "data.verify.missing_evidence_paths",
          "type": "array",
          "format": "required when top-level result is blocked; non-empty string array of missing evidence paths"
        }
      ]
    },
    "remediate": {
      "validators": [
        {
          "registry_id": "IMPLEMENTATION-CLAIMS-VALIDATE-001",
          "enforcement": "blocks",
          "enforced_fields": [
            "data.acceptance_results[].evidence[]",
            "data.implementation.changed_files[]",
            "data.implementation.tests_added[]",
            "data.implementation.tests_added[].path",
            "data.implementation.tests_added[].contract",
            "data.implementation.remediation[]",
            "data.implementation.remediation[].cause",
            "data.implementation.remediation[].action",
            "data.implementation.remediation[].evidence[]",
            "data.acceptance_results[]",
            "data.acceptance_results[].id",
            "data.acceptance_results[].result",
            "data.implementation",
            "data.blocked",
            "data.blocked.missing_precondition",
            "data.blocked.supplying_command",
            "data.blocked.evidence[]"
          ]
        }
      ],
      "fields": [
        {
          "path": "data.acceptance_results[]",
          "type": "object",
          "required": ["id", "result", "evidence"],
          "format": "one result per ratified acceptance criterion; id names the criterion, result uses the shared criterion-result vocabulary, and evidence is non-empty"
        },
        {
          "path": "data.acceptance_results[].id",
          "type": "string",
          "format": "acceptance criterion id the ratified plan declares"
        },
        {
          "path": "data.acceptance_results[].result",
          "type": "string",
          "format": "non-empty; the criterion outcome this stage observed"
        },
        {
          "path": "data.acceptance_results[].evidence[]",
          "type": "string",
          "format": "path reference, prose observation, or pytest node id",
          "accepted_shapes": [
            "path_reference",
            "prose_observation",
            "pytest_node_id"
          ]
        },
        {
          "path": "data.implementation",
          "type": "object",
          "format": "required unless the top-level result is blocked; the stage's required data names the complete child set"
        },
        {
          "path": "data.implementation.changed_files[]",
          "type": "string",
          "format": "workspace-relative path of a file the stage changed; every entry MUST be a string, MUST exist, and MUST appear in the workspace diff"
        },
        {
          "path": "data.implementation.tests_added[]",
          "type": "object",
          "required": ["path", "contract"],
          "format": "{ path, contract }: path is '<test file path>' optionally followed by '::<test case>' (pytest node ids and the spaced ' :: ' display form both resolve) and the file portion must exist, e.g. 'tests/unit/example.test.ts::adds provenance rows'; contract is one non-empty sentence naming the behavior the test proves. Every new test file and every changed test file with a net-positive test(/it( count MUST have an entry with a contract. A bare string still parses as { path } and fails only when that delta requires a contract. A change that adds no tests needs no entry."
        },
        {
          "path": "data.implementation.tests_added[].path",
          "type": "string",
          "format": "'<test file path>' optionally followed by '::<test case>'; the file portion MUST exist"
        },
        {
          "path": "data.implementation.tests_added[].contract",
          "type": "string",
          "format": "one non-empty sentence naming the behavior the test proves"
        },
        {
          "path": "data.implementation.remediation[]",
          "type": "object",
          "required": ["cause", "action", "evidence"],
          "format": "required on every remediation attempt; cause and action are non-empty strings, evidence is a non-empty string array"
        },
        {
          "path": "data.implementation.remediation[].cause",
          "type": "string",
          "format": "non-empty; the cause of the prior failure or loop"
        },
        {
          "path": "data.implementation.remediation[].action",
          "type": "string",
          "format": "non-empty; the action taken against that cause"
        },
        {
          "path": "data.implementation.remediation[].evidence[]",
          "type": "string",
          "format": "non-empty string array of paths, commands, or observations proving the remediation"
        },
        {
          "path": "data.blocked",
          "type": "object",
          "required": ["missing_precondition", "supplying_command", "evidence"],
          "format": "required when the top-level result is blocked, and forbidden otherwise"
        },
        {
          "path": "data.blocked.missing_precondition",
          "type": "string",
          "format": "required when top-level result is blocked; states the precondition the stage could not obtain"
        },
        {
          "path": "data.blocked.supplying_command",
          "type": "string",
          "format": "required when top-level result is blocked; the command or action that would supply the precondition"
        },
        {
          "path": "data.blocked.evidence[]",
          "type": "string",
          "format": "required when top-level result is blocked; non-empty string array of paths, commands, or observations proving the gap. Edits made before blocking are disclosed in top-level workspace_changes.paths, which the claims validator reconciles against the Git delta because data.implementation is forbidden on a blocked result."
        }
      ]
    },
    "ship": {
      "validators": [
        {
          "registry_id": "RELEASE-VALIDATE-001",
          "enforcement": "blocks",
          "enforced_fields": [
            "data.release.local_release",
            "data.release.local_release.release_commit",
            "data.release.local_release.index_commit",
            "data.release.local_release.fetched_main",
            "data.release.local_release.branch",
            "data.release.local_release.pr_description_path",
            "data.release.versioning",
            "data.release.versioning.current_version",
            "data.release.versioning.proposed_version",
            "data.release.versioning.recommendation",
            "data.release.versioning.baseline_commit",
            "data.release.versioning.rationale",
            "data.release.versioning.compatibility",
            "data.release.versioning.release_index_action",
            "data.release.versioning.updated_files[]",
            "data.release.change_list[]",
            "data.release.change_list[].path",
            "data.release.change_list[].kind",
            "data.release.change_list[].description",
            "data.release.rollback_plan",
            "data.release.governance_artifact_review",
            "data.release.governance_artifact_review.summary",
            "data.release.governance_artifact_review.issues_reviewed[]",
            "data.release.validation[]",
            "data.release.validation[].workspace_fingerprint",
            "data.release.validation[].evidence_path",
            "data.release.deferred_acceptance_criteria[]",
            "data.release.follow_up_cases[]",
            "data.release.follow_up_cases[].id",
            "data.release.follow_up_cases[].evidence[]",
            "data.release.disclosed_waivers[]",
            "data.release.disclosed_waivers[].waiver_id",
            "data.release.disclosed_waivers[].workspace_fingerprint"
          ]
        },
        {
          "registry_id": "PR-DESCRIPTION-VALIDATE-001",
          "enforcement": "blocks"
        }
      ],
      "fields": [
        {
          "path": "data.release.local_release",
          "type": "object",
          "required": [
            "release_commit",
            "index_commit",
            "fetched_main",
            "branch",
            "pr_description_path"
          ],
          "format": "required in self-development when the invocation names a managed worktree; carries the completed local release commits, ancestry, branch, and PR evidence"
        },
        {
          "path": "data.release.local_release.release_commit",
          "type": "string",
          "format": "full 40-character lowercase hash of the immutable release commit"
        },
        {
          "path": "data.release.local_release.index_commit",
          "type": "string",
          "format": "full 40-character lowercase hash of the release/index.json commit, which MUST be HEAD with the release commit as its parent"
        },
        {
          "path": "data.release.local_release.fetched_main",
          "type": "string",
          "format": "full 40-character lowercase hash of the fetched main the release commit descends from"
        },
        {
          "path": "data.release.local_release.branch",
          "type": "string",
          "format": "name of the finalized worktree branch"
        },
        {
          "path": "data.release.local_release.pr_description_path",
          "type": "string",
          "format": "harness-relative path of the final PR description, which MUST resolve inside the installation and name the release commit range"
        },
        {
          "path": "data.release.versioning",
          "type": "object",
          "required": [
            "current_version",
            "proposed_version",
            "recommendation",
            "baseline_commit",
            "rationale",
            "compatibility",
            "release_index_action",
            "updated_files"
          ],
          "format": "required in self-development; carries the version decision and the metadata files it changed"
        },
        {
          "path": "data.release.versioning.current_version",
          "type": "string",
          "format": "complete Semantic Versioning value equal to the committed VERSION before the bump"
        },
        {
          "path": "data.release.versioning.proposed_version",
          "type": "string",
          "format": "complete Semantic Versioning value for the selected bump, or a higher version pan release allocate handed this worktree for the same bump"
        },
        {
          "path": "data.release.versioning.recommendation",
          "type": "string",
          "enum": ["major", "minor", "patch"]
        },
        {
          "path": "data.release.versioning.baseline_commit",
          "type": "string",
          "format": "full 40-character lowercase hash of the commit that introduced current_version, which MUST be an ancestor of HEAD"
        },
        {
          "path": "data.release.versioning.rationale",
          "type": "string",
          "format": "non-empty explanation of the selected bump"
        },
        {
          "path": "data.release.versioning.compatibility",
          "type": "string",
          "format": "non-empty description of the compatibility impact"
        },
        {
          "path": "data.release.versioning.release_index_action",
          "type": "string",
          "format": "non-empty description of the completed separate release/index.json commit"
        },
        {
          "path": "data.release.versioning.updated_files[]",
          "type": "string",
          "format": "release metadata path the bump changed; the array MUST contain only path strings and MUST include CHANGELOG.md, VERSION, docs/embedded-installation.md, package-lock.json, and package.json"
        },
        {
          "path": "data.release.change_list[]",
          "type": "object",
          "required": ["path", "kind", "description"],
          "format": "one entry per file in the workspace diff; the diff and the change list MUST agree"
        },
        {
          "path": "data.release.change_list[].path",
          "type": "string",
          "format": "workspace-relative path of the changed file"
        },
        {
          "path": "data.release.change_list[].kind",
          "type": "string",
          "format": "the kind of change the entry records"
        },
        {
          "path": "data.release.change_list[].description",
          "type": "string",
          "format": "non-empty description of what changed and why"
        },
        {
          "path": "data.release.rollback_plan",
          "type": "string",
          "format": "non-empty rollback plan; the legacy key 'rollback' is still accepted, and any `pan …` command the prose names MUST be a real invocation"
        },
        {
          "path": "data.release.governance_artifact_review",
          "type": "object",
          "required": ["summary", "issues_reviewed"],
          "format": "required when the run recorded governance or artifact issues; dispositions every recorded issue"
        },
        {
          "path": "data.release.governance_artifact_review.summary",
          "type": "string",
          "format": "non-empty summary of the governance and artifact review"
        },
        {
          "path": "data.release.governance_artifact_review.issues_reviewed[]",
          "type": "string",
          "format": "issue id the review dispositioned; every recorded run issue id MUST appear"
        },
        {
          "path": "data.release.validation[]",
          "type": "object",
          "required": ["workspace_fingerprint"],
          "format": "one entry per validation run cited by the release"
        },
        {
          "path": "data.release.validation[].workspace_fingerprint",
          "type": "string",
          "format": "workspace fingerprint the validation ran at; it MUST be one the run stage history or a recorded waiver carries"
        },
        {
          "path": "data.release.validation[].evidence_path",
          "type": "string",
          "format": "optional; harness-relative path of the validation evidence artifact, which MUST exist when present"
        },
        {
          "path": "data.release.deferred_acceptance_criteria[]",
          "type": "string",
          "format": "acceptance criterion id deferred by the run; every criterion the run state defers MUST appear"
        },
        {
          "path": "data.release.follow_up_cases[]",
          "type": "object",
          "required": ["id", "evidence"],
          "format": "one entry per follow-up the release hands forward"
        },
        {
          "path": "data.release.follow_up_cases[].id",
          "type": "string",
          "format": "non-empty stable follow-up identifier"
        },
        {
          "path": "data.release.follow_up_cases[].evidence[]",
          "type": "string",
          "format": "non-empty string array of evidence paths, which MUST exist when they name a harness path"
        },
        {
          "path": "data.release.disclosed_waivers[]",
          "type": "object",
          "required": ["waiver_id", "workspace_fingerprint"],
          "format": "one entry per active operator gate waiver; the legacy key 'waivers' is still accepted"
        },
        {
          "path": "data.release.disclosed_waivers[].waiver_id",
          "type": "string",
          "format": "waiver id exactly as the run state records it; a disclosure under another key does not count"
        },
        {
          "path": "data.release.disclosed_waivers[].workspace_fingerprint",
          "type": "string",
          "format": "workspace fingerprint the run state recorded for that waiver"
        }
      ]
    },
    "prototype:intake": {
      "validators": [
        {
          "registry_id": "PROTOTYPE-OUTPUT-VALIDATE-001",

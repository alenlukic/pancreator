            "data.prototype_brief.technical_questions[].question"
          ]
        }
      ],
      "fields": [
        {
          "path": "data.prototype_brief.technical_questions[]",
          "type": "object",
          "required": ["id", "question"],
          "format": "one entry per technical question the spike must answer"
        },
        {
          "path": "data.prototype_brief.technical_questions[].id",
          "type": "string",
          "format": "non-empty and unique within the brief; every later prototype stage reports its results against this id"
        },
        {
          "path": "data.prototype_brief.technical_questions[].question",
          "type": "string",
          "format": "non-empty; the question the spike result MUST answer"
        }
      ]

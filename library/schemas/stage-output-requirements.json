            "data.spike.precondition_checks[].precondition_id",
            "data.spike.precondition_checks[].status",
            "data.spike.precondition_checks[].evidence[]"
          ]
        }
      ],
      "fields": [
        {
          "path": "data.spike",
          "type": "object",
          "format": "required; the spike this stage built"
        },
        {
          "path": "data.spike.precondition_checks[]",
          "type": "object",
          "required": ["precondition_id", "status", "evidence"],
          "format": "one entry per volatile precondition the approach declared, rechecked immediately before source edits"
        },
        {
          "path": "data.spike.precondition_checks[].precondition_id",
          "type": "string",
          "format": "non-empty; the approach precondition id this check answers"
        },
        {
          "path": "data.spike.precondition_checks[].evidence[]",
          "type": "string",
          "format": "non-empty array of paths, commands, or observations for the recheck"
        },
        {
          "path": "data.spike.precondition_checks[].status",
          "type": "string",
          "enum": ["ready", "unavailable", "unknown"]
        }
      ]
    },

      "validators": [
        {
          "registry_id": "PROTOTYPE-OUTPUT-VALIDATE-001",
          "enforcement": "blocks",
          "enforced_fields": [
            "data.evaluation",
            "data.evaluation.verdict",
            "data.evaluation.question_results[]",
            "data.evaluation.question_results[].question_id",
            "data.evaluation.question_results[].result",
            "data.evaluation.question_results[].cause",
            "data.evaluation.question_results[].discard_condition_met",
            "data.evaluation.question_results[].evidence[]",
            "data.evaluation.question_results[].readiness_question",
            "data.evaluation.environment_blockers[]",
            "data.evaluation.environment_blockers[].description",
            "data.evaluation.environment_blockers[].evidence[]",
            "data.evaluation.environment_blockers[].affected_questions[]"
          ]
        }
      ],
      "fields": [
        {
          "path": "data.evaluation",
          "type": "object",
          "format": "required; the evaluation of the spike against the declared questions"
        },
        {
          "path": "data.evaluation.verdict",
          "type": "string",
          "enum": [
            "validated",
            "invalidated",
            "inconclusive",
            "environment_blocked"
          ]
        },
        {
          "path": "data.evaluation.question_results[]",
          "type": "object",
          "required": [
            "question_id",
            "result",
            "cause",
            "discard_condition_met",
            "evidence"
          ],
          "format": "one result per declared technical question"
        },
        {
          "path": "data.evaluation.question_results[].question_id",
          "type": "string",
          "format": "non-empty; a technical question id the intake brief declared"
        },
        {
          "path": "data.evaluation.question_results[].result",
          "type": "string",
          "format": "non-empty; what the spike showed for the question"
        },
        {
          "path": "data.evaluation.question_results[].cause",
          "type": "string",
          "enum": ["product", "environment", "mixed", "none"]
        },
        {
          "path": "data.evaluation.question_results[].readiness_question",
          "type": "boolean",
          "format": "optional; true claims the explicit-readiness exemption so a readiness result may carry a product cause while an environment blocker names the same question"
        },
        {
          "path": "data.evaluation.question_results[].discard_condition_met",
          "type": "boolean",
          "format": "required; true when the question met the discard condition the brief declared"
        },
        {
          "path": "data.evaluation.question_results[].evidence[]",
          "type": "string",
          "format": "non-empty array of paths, commands, or observations for the result"
        },
        {
          "path": "data.evaluation.environment_blockers[]",
          "type": "object",
          "required": ["description", "evidence", "affected_questions"],
          "format": "one entry per environment gap that prevented a decision"
        },
        {
          "path": "data.evaluation.environment_blockers[].description",
          "type": "string",
          "format": "required; non-empty statement of the environment gap"
        },
        {
          "path": "data.evaluation.environment_blockers[].evidence[]",
          "type": "string",
          "format": "required; non-empty array of reproducible evidence for the gap"
        },
        {
          "path": "data.evaluation.environment_blockers[].affected_questions[]",
          "type": "string",
          "format": "required; non-empty array of declared technical question ids the blocker prevented a decision on"
        }
      ]
    }
  }

{
  "slug": "plan",
  "title": "Ratified plan and cohort fan-out",
  "persona": "planner",
  "prompt_path": "library/workflows/planning/prompts/plan.md",
  "workspace_policy": "runtime_only",
  "gate": "operator",
  "checkpoint": "technical_plan",
  "context": {
    "request": "required",
    "prior_attempts": 1,
    "operator_feedback": 1
  },
  "required_data": {
    "product_spec": "object",
    "product_spec.summary": "string",
    "product_spec.user_stories": "array",
    "product_spec.constraints": "array",
    "product_spec.out_of_scope": "array",
    "product_spec.open_questions": "array",
    "engineering_plan": "object",
    "engineering_plan.approach": "string",
    "engineering_plan.components": "array",
    "engineering_plan.files": "array",
    "engineering_plan.risks": "array",
    "engineering_plan.validation": "array",
    "acceptance_criteria": "array",
    "test_plan": "array",
    "open_question_dispositions": "array",
    "cohort_plan": "object",
    "cohort_plan.parent_spec_path": "string",
    "cohort_plan.chunks": "array",
    "cohort_plan.edges": "array",
    "cohort_plan.cohorts": "array"
  },
  "criteria": [
    {
      "id": "intake.request_covered",
      "type": "judgment",
      "hard": true,
      "statement": "The product spec faithfully covers the operator request without inventing material scope."
    },
    {
      "id": "plan.complete_mapping",
      "type": "judgment",
      "hard": true,
      "statement": "Every user story and feature requirement maps to at least one testable acceptance criterion."
    },
    {
      "id": "plan.implementation_ready",
      "type": "judgment",
      "hard": true,
      "statement": "The plan is specific enough for implementation without additional architectural decisions."
    },
    {
      "id": "plan.proportionate",
      "type": "judgment",
      "hard": true,
      "statement": "The plan minimizes new structure and complexity while addressing system-wide implications."
    },
    {
      "id": "plan.test_plan_covers",
      "type": "judgment",
      "hard": true,
      "statement": "The test plan gives every acceptance criterion at least one executable verification case that a later stage can run without editing source."
    }
  ],
  "transitions": {
    "success": "succeeded",
    "failure": "plan",
    "blocked": "paused"
  }
}

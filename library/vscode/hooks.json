{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "{{PANCREATOR_HARNESS_PATH}}bin/pan-hook-adapter --fail-closed preToolUse pan-hook-deny-await-shell",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "{{PANCREATOR_HARNESS_PATH}}bin/pan-hook-adapter --fail-closed beforeShellExecution pan-hook-shell-monitor",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "{{PANCREATOR_HARNESS_PATH}}bin/pan-hook-adapter beforeSubmitPrompt pan-hook-governance-reminder",
        "timeoutSec": 10
      }
    ]
  }
}

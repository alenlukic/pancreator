{
  "schema_version": 3,
  "policy": "CONTRACT-001",
  "regeneration_command": "./bin/pan models --sync",
  "projections": [
    {
      "id": "cursor-agents",
      "host": "cursor",
      "format_difference": "Cursor subagent frontmatter carries a Cursor model id and disallowedTools; VS Code .agent.md files take a tools list and user-invocable.",
      "source": "library/cursor/agents/{persona}.md",
      "target": ".cursor/agents/pan-{persona}.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": ["frontmatter.model"],
      "transforms": ["installation-paths"]
    },
    {
      "id": "cursor-commands",
      "host": "cursor",
      "format_difference": "Cursor lists operator commands from .cursor/commands and passes their arguments; probe PR-1 left Cursor's argument passing to a skill unconfirmed, so Cursor keeps the command form.",
      "source": "library/cursor/commands/{command}.md",
      "target": ".cursor/commands/{command}.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["installation-paths"]
    },
    {
      "id": "cursor-self-development-rule",
      "host": "cursor",
      "format_difference": "Cursor rules are .mdc files with alwaysApply frontmatter.",
      "source": "library/cursor/rules/pancreator-self-development.mdc",
      "target": ".cursor/rules/pancreator.mdc",
      "installation_modes": ["self_development"],
      "generated_fields": [],
      "transforms": []
    },
    {
      "id": "cursor-embedded-rule",
      "host": "cursor",
      "format_difference": "Cursor rules are .mdc files with alwaysApply frontmatter.",
      "source": "library/cursor/rules/pancreator-embedded.mdc",
      "target": ".cursor/rules/pancreator.mdc",
      "installation_modes": ["embedded"],
      "generated_fields": [],
      "transforms": []
    },
    {
      "id": "cursor-principles-policy-rule",
      "host": "cursor",
      "format_difference": "Cursor rules are .mdc files with alwaysApply frontmatter.",
      "source": "governance/policies/PRINCIPLES-001.json",
      "target": ".cursor/rules/pan-operating-principles.mdc",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["policy-rule"]
    },
    {
      "id": "cursor-delegation-policy-rule",
      "host": "cursor",
      "format_difference": "Cursor rules are .mdc files with alwaysApply frontmatter.",
      "source": "governance/policies/DELEGATE-001.json",
      "target": ".cursor/rules/pan-subagent-supervision.mdc",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["policy-rule"]
    },
    {
      "id": "cursor-browser-policy-rule",
      "host": "cursor",
      "format_difference": "Cursor rules are .mdc files with alwaysApply frontmatter.",
      "source": "governance/policies/BROWSER-001.json",
      "target": ".cursor/rules/pan-browser-isolation.mdc",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["policy-rule"]
    },
    {
      "id": "cursor-comms-policy-rule",
      "host": "cursor",
      "format_difference": "Cursor rules are .mdc files with alwaysApply frontmatter.",
      "source": "governance/policies/COMMS-001.json",
      "target": ".cursor/rules/pan-chat-output.mdc",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["policy-rule"]
    },
    {
      "id": "cursor-mcp",
      "host": "cursor",
      "format_difference": "Cursor reads workspace MCP servers only from .cursor/mcp.json.",
      "source": "library/cursor/mcp.json",
      "target": ".cursor/mcp.json",
      "installation_modes": ["self_development"],
      "generated_fields": [],
      "transforms": []
    },
    {
      "id": "cursor-hooks",
      "host": "cursor",
      "format_difference": "Cursor hooks use one merged .cursor/hooks.json with Cursor event names and payloads; Copilot hook files use other event names and route through bin/pan-hook-adapter.",
      "source": "library/cursor/hooks.json",
      "target": ".cursor/hooks.json",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["installation-paths", "hooks-merge"]
    },
    {
      "id": "vscode-command-skills",
      "host": "vscode",
      "format_difference": "VS Code and the Copilot runtime read operator commands as slash-only skills. The target is .github/skills, which Cursor does not read, because probe PR-2 showed Cursor lists a .agents/skills copy beside its .cursor/commands copy.",
      "source": "library/cursor/commands/{command}.md",
      "target": ".github/skills/{command}/SKILL.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["installation-paths", "skill-command"]
    },
    {
      "id": "vscode-agents",
      "host": "vscode",
      "format_difference": "VS Code and Copilot CLI custom agents are .agent.md files with name and user-invocable; the copilot executor passes the model and the tool allowlist on its command line.",
      "source": "library/cursor/agents/{persona}.md",
      "target": ".github/agents/pan-{persona}.agent.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["installation-paths", "vscode-agent"]
    },
    {
      "id": "vscode-supervisor-agent",
      "host": "vscode",
      "format_difference": "VS Code renders a selected custom agent's body as mode instructions that claim precedence over earlier system text, so the supervisor agent carries the AGENTS.md authority order; Cursor has no equivalent surface.",
      "source": "library/vscode/agents/supervisor.agent.md",
      "target": ".github/agents/pan-supervisor.agent.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["installation-paths"]
    },
    {
      "id": "vscode-self-development-instructions",
      "host": "vscode",
      "format_difference": "VS Code instruction files are .instructions.md with applyTo frontmatter.",
      "source": "library/cursor/rules/pancreator-self-development.mdc",
      "target": ".github/instructions/pancreator.instructions.md",
      "installation_modes": ["self_development"],
      "generated_fields": [],
      "transforms": ["vscode-instructions"]
    },
    {
      "id": "vscode-embedded-instructions",
      "host": "vscode",
      "format_difference": "VS Code instruction files are .instructions.md with applyTo frontmatter.",
      "source": "library/cursor/rules/pancreator-embedded.mdc",
      "target": ".github/instructions/pancreator.instructions.md",
      "installation_modes": ["embedded"],
      "generated_fields": [],
      "transforms": ["vscode-instructions"]
    },
    {
      "id": "vscode-principles-policy-instructions",
      "host": "vscode",
      "format_difference": "VS Code instruction files are .instructions.md with applyTo frontmatter.",
      "source": "governance/policies/PRINCIPLES-001.json",
      "target": ".github/instructions/pan-operating-principles.instructions.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["policy-rule", "vscode-instructions"]
    },
    {
      "id": "vscode-delegation-policy-instructions",
      "host": "vscode",
      "format_difference": "VS Code instruction files are .instructions.md with applyTo frontmatter.",
      "source": "governance/policies/DELEGATE-001.json",
      "target": ".github/instructions/pan-subagent-supervision.instructions.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["policy-rule", "vscode-instructions"]
    },
    {
      "id": "vscode-browser-policy-instructions",
      "host": "vscode",
      "format_difference": "VS Code instruction files are .instructions.md with applyTo frontmatter.",
      "source": "governance/policies/BROWSER-001.json",
      "target": ".github/instructions/pan-browser-isolation.instructions.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["policy-rule", "vscode-instructions"]
    },
    {
      "id": "vscode-comms-policy-instructions",
      "host": "vscode",
      "format_difference": "VS Code instruction files are .instructions.md with applyTo frontmatter.",
      "source": "governance/policies/COMMS-001.json",
      "target": ".github/instructions/pan-chat-output.instructions.md",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["policy-rule", "vscode-instructions"]
    },
    {
      "id": "vscode-hooks",
      "host": "vscode",
      "format_difference": "Copilot hook files use lowerCamel event names, a bash command, and timeoutSec, and route every script through bin/pan-hook-adapter.",
      "source": "library/vscode/hooks.json",
      "target": ".github/hooks/pan-hooks.json",
      "installation_modes": ["self_development", "embedded"],
      "generated_fields": [],
      "transforms": ["installation-paths"]
    }
  ]
}

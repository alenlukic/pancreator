{
  "schema_version": 4,
  "read_only_commands": [
    "pan-augment",
    "pan-status",
    "pan-summarize-context",
    "pan-validate",
    {
      "command": "pan-tune-harness",
      "card_mode": "tune-harness"
    }
  ],
  "card_commands": [
    {
      "command": "pan-author",
      "card_mode": "author"
    },
    {
      "command": "pan-conform",
      "card_mode": "conform"
    },
    {
      "command": "pan-debloat",
      "card_mode": "debloat"
    },
    {
      "command": "pan-harden",
      "card_mode": "harden"
    },
    {
      "command": "pan-polish",
      "card_mode": "polish"
    },
    {
      "command": "pan-research",
      "card_mode": "research"
    },
    {
      "command": "pan-style",
      "card_mode": "style"
    },
    {
      "command": "pan-trace",
      "card_mode": "trace"
    }
  ],
  "supervisor_commands": [
    "pan-cohort",
    "pan-horizon",
    "pan-resume",
    "pan-start"
  ],
  "target_mutating_commands": [
    {
      "command": "pan-author",
      "worktree_forwarding": [
        "author apply --input runtime/inbox/target-authoring/<id>.json --worktree <name> --json",
        "author validate --extension <id> --worktree <name> --json"
      ]
    },
    {
      "command": "pan-debloat",
      "worktree_forwarding": [
        "debloat scan --days <window> --worktree <name> --json",
        "governance card --mode debloat --worktree <name>"
      ]
    },
    {
      "command": "pan-style",
      "worktree_forwarding": [
        "style scan --worktree <name> --json",
        "style checkpoint --worktree <name> --json"
      ]
    },
    {
      "command": "pan-trace",
      "worktree_forwarding": ["governance card --mode trace --worktree <name>"]
    },
    {
      "command": "pan-harden",
      "worktree_forwarding": ["governance card --mode harden --worktree <name>"]
    },
    {
      "command": "pan-polish",
      "worktree_forwarding": ["governance card --mode polish --worktree <name>"]
    },
    {
      "command": "pan-qa-workflow",
      "worktree_forwarding": [
        "--worktree <name>",
        "prepare <run-id> --worktree <name>",
        "submit <run-id> <output-json> --worktree <name>"
      ]
    },
    {
      "command": "pan-release",
      "worktree_forwarding": [
        "release sync --worktree <name>",
        "release continue --worktree <name>",
        "release finalize --worktree <name>"
      ]
    },
    {
      "command": "pan-horizon",
      "worktree_forwarding": [
        "horizon init --queue <path> --worktree <name> --json"
      ]
    },
    {
      "command": "pan-cohort",
      "worktree_forwarding": [
        "prepare <run-id> --worktree <name>",
        "resume <run-id> --worktree <name>",
        "submit <run-id> <output-json> --worktree <name>"
      ]
    },
    {
      "command": "pan-resume",
      "worktree_forwarding": [
        "prepare <run-id> --worktree <name>",
        "resume <run-id> --worktree <name>",
        "submit <run-id> <output-json> --worktree <name>"
      ]
    },
    {
      "command": "pan-start",
      "worktree_forwarding": [
        "prepare <run-id> --worktree <name>",
        "submit <run-id> <output-json> --worktree <name>"
      ]
    }
  ],
  "pending_card_steps": []
}

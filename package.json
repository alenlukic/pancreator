{
  "name": "pancreator-v2-prototype",
  "version": "5.5.0",
  "private": true,
  "type": "module",
  "description": "Cursor-native workflow harness with a dependency-free runtime.",
  "bin": {
    "pan": "./bin/pan"
  },
  "scripts": {
    "build": "./bin/run-quiet -- ./bin/run-built --build-only",
    "pan": "./bin/run-built -- node dist/src/cli.js",
    "doctor": "./bin/run-built -- node dist/src/cli.js doctor",
    "validate": "./bin/run-built -- node dist/src/cli.js validate",
    "format": "./bin/run-quiet -- prettier --write .",
    "format:check": "./bin/run-quiet -- prettier --check .",
    "typecheck": "./bin/run-quiet -- tsc --noEmit",
    "lint": "./bin/run-quiet -- ./bin/lint",
    "validate:chat-markdown": "./bin/validate-chat-markdown",
    "test": "./bin/run-quiet -- ./bin/run-built -- node --test --test-reporter=./dist/tests/reporters/failures-only.js --test-reporter-destination=stdout dist/tests/unit/*.test.js dist/tests/integration/*.test.js dist/tests/regression/*.test.js",
    "test:unit": "./bin/run-quiet -- ./bin/run-built -- node --test --test-reporter=./dist/tests/reporters/failures-only.js --test-reporter-destination=stdout dist/tests/unit/*.test.js",
    "test:migrations": "./bin/run-quiet -- ./bin/run-built -- node --test --test-reporter=./dist/tests/reporters/failures-only.js --test-reporter-destination=stdout dist/tests/migrations/*.test.js",
    "test:integration": "./bin/run-quiet -- ./bin/run-built -- node --test --test-reporter=./dist/tests/reporters/failures-only.js --test-reporter-destination=stdout dist/tests/integration/*.test.js",
    "test:regression": "./bin/run-quiet -- ./bin/run-built -- node --test --test-reporter=./dist/tests/reporters/failures-only.js --test-reporter-destination=stdout dist/tests/regression/*.test.js",
    "test:impacted": "./bin/run-built -- node dist/src/cli.js tests impacted",
    "test:secondary": "./bin/run-quiet -- ./bin/run-built -- node --test --test-reporter=./dist/tests/reporters/failures-only.js --test-reporter-destination=stdout dist/tests/secondary/*.test.js",
    "test:coverage": "./bin/run-quiet -- ./bin/run-built -- node --test --test-reporter=./dist/tests/reporters/failures-only.js --test-reporter-destination=stdout --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70 --test-coverage-include=dist/src/lib/** dist/tests/**/*.test.js",
    "check": "./bin/run-quiet -- ./bin/check"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
